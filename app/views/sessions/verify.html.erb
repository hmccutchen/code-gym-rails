<%# Valued rather than bare: content_for with no value reads instead of
    writing, so the layout's content_for?(:hide_nav) would never see it. %>
<% content_for :hide_nav, "true" %>

<style>
  .verify-wrap { max-width: 400px; margin: 6rem auto; text-align: center; }
  .verify-wrap h1 { font-size: 1.8rem; margin-bottom: .5rem; }
  .verify-wrap p { color: var(--muted); margin-bottom: 2rem; }
  <%# Secondary by size only. Muting the color would strip the accent that
      marks a link here, and the global `a` rule carries no underline — on the
      one page where this link is a stranded user's only way forward, nothing
      would identify it as clickable. %>
  .verify-wrap .continue { font-size: .9rem; }
</style>

<div class="verify-wrap">
  <h1>You're logged in, <%= @user.name %>.</h1>
  <p>You can close this tab and return to the one you started in.</p>
  <%# Named for the app, not the destination: @continue_path is the pre-login
      return_to when there is one, so a label promising today's set would lie
      to anyone bounced here from /history or /account. %>
  <%= link_to "Continue to Code Gym →", @continue_path, class: "continue" %>
</div>
