<p id="pending-message" style="color:var(--muted);margin-bottom:1.5rem;">
  Check your email for a login link — this page will update automatically once you click it.
</p>

<% if session[:pending_login_touch] %>
  <details id="code-details">
    <summary>Or enter the code instead</summary>
    <%= form_with url: verify_login_code_path, method: :post do |f| %>
      <div class="form-field" style="margin-top:.75rem;">
        <%= f.label :code, "6-digit code from the email" %>
        <%= f.text_field :code, inputmode: "numeric", pattern: "[0-9]*", maxlength: 6, autocomplete: "one-time-code", placeholder: "123456", required: true %>
      </div>
      <%= f.submit "Verify code →", class: "btn btn-primary", style: "width:100%;padding:.75rem;" %>
    <% end %>
  </details>
<% end %>

<%# Wrapped in an IIFE: this partial can render again after a failed code
    submit re-renders sessions/new, and top-level const/let would redeclare
    on that second execution — same hazard documented in
    dashboard/_generating.html.erb's polling script. %>
<script>
(() => {
  // iOS only, deliberately. A home-screen app there gets its own cookie jar
  // (16.4+), so a link clicked in Safari lands in a session this window cannot
  // see. An installed app on Android or desktop shares the browser's cookies,
  // so the link still resolves the poll below — matching (display-mode:
  // standalone) too would strand those users on the code form with polling
  // switched off, for a hazard they do not have.
  const isIosStandalone = window.navigator.standalone === true;
  const message = document.getElementById("pending-message");
  const details = document.getElementById("code-details");

  // `details` is absent on desktop, where the server omits the code form
  // entirely. Requiring it here means a standalone app that somehow has no
  // code form still falls through to polling rather than stranding the user
  // on a message about a field that isn't there.
  if (isIosStandalone && details) {
    message.textContent = "Check your email for a 6-digit code and enter it below.";
    details.open = true;
    details.querySelector("summary").style.display = "none";
    return; // polling could never resolve here — the code is the only way through
  }

  const statusUrl = "<%= login_status_path %>";
  let attempts = 0;
  const MAX_ATTEMPTS = 200; // ~10 minutes at 3s intervals

  async function poll() {
    attempts += 1;

    try {
      const res = await fetch(statusUrl, { headers: { "Accept": "application/json" } });
      const data = await res.json();
      if (data.authenticated) {
        window.location.href = "/";
        return;
      }
    } catch {
      // Transient network hiccup — keep polling rather than giving up early.
    }

    if (attempts >= MAX_ATTEMPTS) return;
    setTimeout(poll, 3000);
  }

  setTimeout(poll, 3000);
})();
</script>
