<p id="pending-message" style="color:var(--muted);margin-bottom:1.5rem;">
  <%= t("sessions.pending.message") %>
</p>

<%# Design notes: docs/code-notes/app/views/sessions/_pending.html.md %>
<% code_alert = flash[:alert].present? && action_name == "verify_code" %>
<% flash_ids = [ ("flash-alert" if code_alert), ("flash-notice" if flash[:notice].present?) ].compact %>
<%= form_with url: verify_login_code_path, method: :post do |f| %>
  <div class="form-field">
    <%= f.label :code, t("sessions.pending.code_label") %>
    <%= f.text_field :code, inputmode: "numeric", pattern: "[0-9]*", maxlength: 6,
                     autocomplete: "one-time-code", placeholder: t("sessions.pending.code_placeholder"),
                     required: true, autofocus: true,
                     aria: { describedby: [ *flash_ids, "pending-message" ].join(" "),
                             invalid: @code_rejected || nil } %>
  </div>
  <%= f.submit t("sessions.pending.submit"), class: "btn btn-primary", style: "width:100%;padding:.75rem;" %>
<% end %>
