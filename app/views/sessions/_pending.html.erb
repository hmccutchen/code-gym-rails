<p id="pending-message" style="color:var(--muted);margin-bottom:1.5rem;">
  Enter the 6-digit code we emailed you.
</p>

<%# The field takes focus on arrival, so a screen reader starts there and
    skips the flash above it. Describing the field by that flash is what makes
    a wrong-code error, or the code's expiry time, reach someone who cannot
    see it. %>
<% flash_ids = { alert: "flash-alert", notice: "flash-notice" }.select { |key, _| flash[key].present? }.values %>
<%= form_with url: verify_login_code_path, method: :post do |f| %>
  <div class="form-field">
    <%= f.label :code, "6-digit code from the email" %>
    <%= f.text_field :code, inputmode: "numeric", pattern: "[0-9]*", maxlength: 6,
                     autocomplete: "one-time-code", placeholder: "123456",
                     required: true, autofocus: true,
                     aria: { describedby: [ *flash_ids, "pending-message" ].join(" "),
                             invalid: flash[:alert].present? || nil } %>
  </div>
  <%= f.submit "Verify code →", class: "btn btn-primary", style: "width:100%;padding:.75rem;" %>
<% end %>
