<% page_title t("sessions.new.page_title") %>
<style>
  .login-wrap { max-width: 400px; margin: 6rem auto; text-align: center; }
  .login-wrap h1 { font-size: 1.8rem; margin-bottom: .5rem; }
  .login-wrap p  { color: var(--muted); margin-bottom: 2rem; }
  .form-field { margin-bottom: 1rem; text-align: left; }
  .form-field label { display: block; font-size: .85rem; color: var(--muted); margin-bottom: .3rem; }
  .form-field input { width: 100%; padding: .65rem .9rem; background: var(--surface); border: 1px solid var(--border); border-radius: 6px; color: var(--text); font-size: var(--input-font-size); }
  .form-field input:focus { border-color: var(--accent); }
  .login-wrap .trial-link { margin: 1.25rem 0 0; font-size: .85rem; }
  .pending-divider { border-top: 1px solid var(--border); padding-top: 1.25rem; font-size: .85rem; }
</style>

<div class="login-wrap">
  <h1><%= t("app_name") %></h1>
  <% if pending_login_email.present? %>
    <%= render "sessions/pending" %>

    <%# Keep the form below the pending banner: see docs/code-notes/app/views/sessions/new.html.md %>
    <p class="pending-divider"><%= t("sessions.new.resend_prompt") %></p>
  <% else %>
    <p><%= t("sessions.new.intro_html") %></p>
  <% end %>

  <%= form_with url: login_path, method: :post do |f| %>
    <div class="form-field">
      <%= f.label :name, t("sessions.new.name_label") %>
      <%= f.text_field :name, placeholder: t("sessions.new.name_placeholder"), autocomplete: "name" %>
    </div>
    <div class="form-field">
      <%= f.label :email, t("sessions.new.email_label") %>
      <%= f.email_field :email, placeholder: t("sessions.new.email_placeholder"), required: true, autocomplete: "email" %>
    </div>
    <%= f.submit t("sessions.new.submit"), class: "btn btn-primary", style: "width:100%;padding:.75rem;" %>
  <% end %>
  <p class="trial-link"><%= link_to t("sessions.new.trial_link"), new_trial_path %></p>
</div>
