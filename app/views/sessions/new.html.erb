<% page_title t("sessions.new.page_title") %>
<%= render "sessions/login_styles" %>

<div class="login-wrap">
  <h1><%= t("app_name") %></h1>
  <p><%= t("sessions.new.intro_html") %></p>

  <%= form_with url: login_path, method: :post, data: loading_form_data do |f| %>
    <div class="form-field">
      <%= f.label :email, t("sessions.new.email_label") %>
      <%= f.email_field :email, placeholder: t("sessions.new.email_placeholder"), required: true, autocomplete: "email" %>
    </div>
    <%= f.submit t("sessions.new.submit"), class: "btn btn-primary", style: "width:100%;padding:.75rem;" %>
  <% end %>
</div>
