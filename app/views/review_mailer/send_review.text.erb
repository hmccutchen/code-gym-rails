Hi <%= @response.user.name %>,

Here's your Code Gym review from <%= @response.date.strftime("%A, %B %-d, %Y") %>.

<% @response.ai_review.each do |section, fb| -%>
<% next unless fb.is_a?(Hash) -%>
== <%= section.humanize %> ==

<% if fb["rating"].present? -%>
Rating: <%= fb["rating"] %>

<% end -%>
<% DailyResponse::AI_REVIEW_FIELDS.each do |key, field| -%>
<% if field[:list] -%>
<% points = DailyResponse.review_points(fb[key]) -%>
<% next if points.empty? -%>
<%= field[:label] %>:
<% points.each do |point| -%>
- <%= point %>
<% end -%>

<% else -%>
<% next if fb[key].blank? -%>
<%= field[:label] %>: <%= fb[key] %>

<% end -%>
<% end -%>
<% if fb["improved_code"].present? && @response.improved_code_visible?(section) -%>
Improved code:

<%= fb["improved_code"] %>

<% end -%>
<% end -%>
— Code Gym
