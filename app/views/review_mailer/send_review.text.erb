<%= t("review_mailer.send_review.greeting", name: @response.user.name) %>

<%= t("review_mailer.send_review.intro", app_name: t("app_name"), date: @response.date.strftime("%A, %B %-d, %Y")) %>

<% @response.ai_review.each do |section, fb| -%>
<% next unless fb.is_a?(Hash) -%>
== <%= section.humanize %> ==

<% if fb["rating"].present? -%>
<%= t("review_mailer.send_review.rating", rating: fb["rating"]) %>

<% end -%>
<% if (difficulty = @response.difficulty_for(section)) -%>
<%= t("review.difficulty_note", level: difficulty["level"]) %> <%= difficulty["reason"] %>

<% end -%>
<% DailyResponse::AI_REVIEW_FIELDS.each do |key, field| -%>
<% if field[:list] -%>
<% points = DailyResponse.review_points(fb[key]) -%>
<% next if points.empty? -%>
<%= DailyResponse.ai_review_label(key) %>:
<% points.each do |point| -%>
- <%= point %>
<% end -%>

<% else -%>
<% text = DailyResponse.review_points(fb[key]).join(" ") -%>
<% next if text.blank? -%>
<%= DailyResponse.ai_review_label(key) %>: <%= text %>

<% end -%>
<% end -%>
<% improved_code = DailyResponse.improved_code_text(fb["improved_code"]) -%>
<% if improved_code.present? && @response.improved_code_visible?(section) -%>
<%= ExerciseSection.for(section).improved_code_label %>:

<%= improved_code %>

<% end -%>
<% end -%>
<%= t("review_mailer.send_review.sign_off", app_name: t("app_name")) %>
