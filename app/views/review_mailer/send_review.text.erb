Hi <%= @response.user.name %>,

Here's your Code Gym review from <%= @response.date.strftime("%A, %B %-d, %Y") %>.

<% @response.ai_review.each do |section, fb| -%>
<% next unless fb.is_a?(Hash) -%>
== <%= section.humanize %> ==

<% if fb["rating"].present? -%>
Rating: <%= fb["rating"] %>

<% end -%>
<% DailyResponse::AI_REVIEW_FIELDS.each do |key, field| -%>
<% if field[:list] -%>
<% points = DailyResponse.review_points(fb[key]) -%>
<% next if points.empty? -%>
<%= field[:label] %>:
<% points.each do |point| -%>
- <%= point %>
<% end -%>

<% else -%>
<% text = DailyResponse.review_points(fb[key]).join(" ") -%>
<% next if text.blank? -%>
<%= field[:label] %>: <%= text %>

<% end -%>
<% end -%>
<% improved_code = DailyResponse.review_points(fb["improved_code"]).join("\n") -%>
<% if improved_code.present? && section != "architecture" && @response.improved_code_visible?(section) -%>
Improved code:

<%= improved_code %>

<% end -%>
<% end -%>
— Code Gym
