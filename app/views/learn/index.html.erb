<h1><%= t("learn.title") %></h1>
<p class="learn-intro"><%= t("learn.intro") %></p>

<% if @ungenerated.positive? %>
  <%# Quotes the count and says whose key pays, because it spends the user's
      own provider key and the rows it writes are shared with the whole team. %>
  <div class="learn-prepare">
    <p><%= t("learn.prepare_prompt", count: @ungenerated) %></p>
    <%= button_to t("learn.prepare_button"), prepare_learn_path, class: "btn btn-sm", form: { id: "learn-prepare-form" } %>
  </div>

  <%# #prepare derives what to enqueue from rows that exist, so a reload-and-
      press-again double-submit would re-enqueue jobs still in flight. Disabling
      client-side on submit covers the realistic double-click without adding a
      persisted in-flight marker for a case the job's own re-check already
      makes mostly harmless. %>
  <script>
    document.getElementById("learn-prepare-form").addEventListener("submit", (event) => {
      event.target.querySelector('[type="submit"]').disabled = true;
    });
  </script>
<% end %>

<div class="learn-filter">
  <input type="search" id="learn-filter-input" placeholder="<%= t("learn.filter_placeholder") %>"
         aria-label="<%= t("learn.filter_placeholder") %>">
  <label>
    <input type="checkbox" id="learn-seen-only">
    <%= t("learn.seen_only") %>
  </label>
  <p id="learn-empty" class="learn-empty" hidden><%= t("learn.no_matches") %></p>
</div>

<% @buckets.each do |bucket| %>
  <section class="learn-bucket">
    <h2><%= t("learn.buckets.#{bucket[:key]}") %></h2>

    <% bucket[:groups].each do |group_key, concepts| %>
      <div class="learn-group-block">
        <%# A bucket whose concepts all fall in one group renders flat — that is
            every language-independent bucket, and a heading over the only group
            would be noise. %>
        <% if bucket[:groups].size > 1 %>
          <h3 class="learn-group"><%= t("learn.groups.#{group_key}") %></h3>
        <% end %>

        <ul class="learn-list">
          <% concepts.each do |concept| %>
            <li class="learn-entry" data-concept="<%= concept %>" data-search="<%= "#{concept} #{concept.humanize}".downcase %>">
              <%= link_to concept.humanize, learn_concept_path(bucket: bucket[:key], concept: concept) %>
              <% if encountered?(concept, bucket[:key]) %>
                <span class="learn-seen"><%= t("learn.encountered") %></span>
              <% end %>
              <%# Row-existence and guide-existence are different facts, stated
                  once each rather than collapsed into one marker: a row can
                  exist (pre-guide) without the bulk button's count — driven by
                  row existence — ever offering to clear it. %>
              <% reference = @references[[ concept, bucket[:key] ]] %>
              <% if reference.nil? %>
                <span class="learn-ungenerated"><%= t("learn.not_generated") %></span>
              <% elsif !reference.guide? %>
                <span class="learn-ungenerated"><%= t("learn.reference_only") %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </section>
<% end %>

<script>
  (function () {
    const input    = document.getElementById("learn-filter-input");
    const seenOnly = document.getElementById("learn-seen-only");
    const empty    = document.getElementById("learn-empty");
    const entries  = Array.from(document.querySelectorAll(".learn-entry"));

    function apply() {
      const term = input.value.trim().toLowerCase();
      let shown = 0;

      entries.forEach((entry) => {
        const matchesTerm = entry.dataset.search.includes(term);
        const matchesSeen = !seenOnly.checked || entry.querySelector(".learn-seen") !== null;
        const visible = matchesTerm && matchesSeen;
        entry.hidden = !visible;
        if (visible) shown++;
      });

      // A group or bucket whose every entry is filtered out hides its heading
      // too, so the page doesn't leave empty sections behind.
      document.querySelectorAll(".learn-group-block").forEach((block) => {
        block.hidden = Array.from(block.querySelectorAll(".learn-entry")).every((e) => e.hidden);
      });
      document.querySelectorAll(".learn-bucket").forEach((section) => {
        section.hidden = Array.from(section.querySelectorAll(".learn-entry")).every((e) => e.hidden);
      });

      empty.hidden = shown > 0;
    }

    input.addEventListener("input", apply);
    seenOnly.addEventListener("change", apply);
  })();
</script>
