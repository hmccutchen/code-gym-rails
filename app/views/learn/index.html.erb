<% page_title t("learn.title") %>
<h1><%= t("learn.title") %></h1>
<p class="learn-intro"><%= t("learn.intro") %></p>

<%# Design notes: docs/code-notes/app/views/learn/index.html.md %>
<% if featured_concept %>
  <%= render "shared/featured_concept", featured: featured_concept %>
<% end %>

<% if @ungenerated.positive? || @ungenerated_guides.positive? %>
  <div class="learn-prepare">
    <p>
      <% if @ungenerated.positive? %><%= t("learn.prepare_prompt", count: @ungenerated) %><% end %>
      <% if @ungenerated_guides.positive? %><%= t("learn.prepare_guides_prompt", count: @ungenerated_guides) %><% end %>
      <%= t("learn.prepare_cost") %>
    </p>
    <%# #prepare enqueues from missing rows, so a second press would enqueue jobs still in flight again. %>
    <%= button_to t("learn.prepare_button"), prepare_learn_path, class: "btn btn-sm",
                  form: { id: "learn-prepare-form", data: { controller: "loading-form",
                          action: "submit->loading-form#submit pageshow@window->loading-form#restore" } } %>
  </div>
<% end %>

<% if @drills.any? %>
  <div class="learn-drills">
    <p><%= t("learn.drill.current", drills: drill_names(@drills)) %> <%= t("learn.drill.current_note") %>
      <% if @drills.full? %><%= t("learn.drill.at_cap") %><% end %></p>
    <% @drills.entries.each do |entry| %>
      <%= button_to t("learn.drill.stop_named", name: drill_label(entry)), drill_stop_path(entry),
                    method: :delete, class: "btn btn-sm" %>
    <% end %>
  </div>
<% end %>

<div data-controller="learn-filter">
<div class="learn-filter">
  <input type="search" id="learn-filter-input" placeholder="<%= t("learn.filter_placeholder") %>"
         aria-label="<%= t("learn.filter_placeholder") %>"
         data-learn-filter-target="input" data-action="input->learn-filter#apply">
  <label>
    <input type="checkbox" id="learn-seen-only"
           data-learn-filter-target="seenOnly" data-action="change->learn-filter#apply">
    <%= t("learn.seen_only") %>
  </label>
  <p id="learn-empty" class="learn-empty" hidden data-learn-filter-target="empty"><%= t("learn.no_matches") %></p>
</div>

<% @buckets.each do |bucket| %>
  <section class="learn-bucket" data-learn-filter-target="section">
    <h2><%= t("learn.buckets.#{bucket[:key]}") %></h2>

    <% bucket[:groups].each do |group_key, concepts| %>
      <div class="learn-group-block" id="<%= learn_group_anchor(bucket[:key], group_key) %>"
           data-learn-filter-target="block">
        <%# A single-group bucket renders flat, so it offers no group drill; its core group is the whole bucket. %>
        <% if bucket[:groups].size > 1 %>
          <div class="learn-group-head">
            <h3 class="learn-group"><%= t("learn.groups.#{group_key}") %></h3>
            <% if group_key != ConceptGroup::CORE %>
              <% if @drills.group_drilling?(group_key, bucket[:key]) %>
                <%= button_to t("learn.drill.stop_group"), learn_group_drill_path(bucket: bucket[:key], group: group_key),
                              method: :delete, class: "btn btn-sm" %>
              <% elsif @drills.can_start_group?(group_key, bucket[:key]) %>
                <%= button_to t("learn.drill.button_group"), learn_group_drill_path(bucket: bucket[:key], group: group_key),
                              class: "btn btn-sm", title: t("learn.drill.offer") %>
              <% end %>
            <% end %>
          </div>
        <% end %>

        <% if (guide = @recognition_guides[RecognitionGuide.key_for(bucket[:key], group_key)]) %>
          <%= render "learn/recognition_guide", guide: guide %>
        <% end %>

        <ul class="learn-list">
          <% concepts.each do |concept| %>
            <li class="learn-entry" data-learn-filter-target="entry" data-concept="<%= concept %>" data-search="<%= "#{concept} #{concept.humanize}".downcase %>">
              <%= link_to concept.humanize, learn_concept_path(bucket: bucket[:key], concept: concept) %>
              <% if encountered?(concept, bucket[:key]) %>
                <span class="learn-seen"><%= t("learn.encountered") %></span>
              <% end %>
              <% if @drills.drilling?(concept, bucket[:key]) %>
                <span class="learn-drilling"><%= t("learn.drill.marker") %></span>
              <% end %>
              <%# Separate markers: the bulk count reads row existence, so it never counts a row that lacks only a guide. %>
              <% reference = @references[[ concept, bucket[:key] ]] %>
              <% if reference.nil? %>
                <span class="learn-ungenerated"><%= t("learn.not_generated") %></span>
              <% elsif !reference.guide? %>
                <span class="learn-ungenerated"><%= t("learn.reference_only") %></span>
              <% end %>
            </li>
          <% end %>
          <% LearnLessons.in_group(group_key).each do |lesson| %>
            <li class="learn-entry" data-learn-filter-target="entry" data-concept="<%= lesson %>" data-search="<%= "#{lesson} #{lesson.humanize}".downcase %>">
              <%= link_to lesson.humanize, learn_lesson_path(lesson: lesson) %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </section>
<% end %>
</div>
