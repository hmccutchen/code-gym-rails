<%# Required locals: text (a guide_worked_example), language (the concept's bucket, which picks the lexer). %>
<% WorkedExample.parts(text).each do |part| %>
  <% if part.kind == :code %>
    <pre class="snippet"><%= highlighted_code(part.text, language) %></pre>
  <% else %>
    <p class="learn-worked-example"><%= prose_with_inline_code(part.text) %></p>
  <% end %>
<% end %>
