<% page_title "#{@concept.humanize} – #{t("learn.title")}" %>
<p><%= link_to t("learn.back"), learn_path, class: "learn-back" %></p>
<h1><%= @concept.humanize %></h1>
<p class="learn-bucket-label"><%= t("learn.buckets.#{@bucket}") %></p>

<% if @reference %>
  <%# tagline/explanation/code_example/senior_lens render for ANY present
      reference, guide or not — a legacy row (every row generated before
      guides existed) still has to show its full reference rather than half
      of it. Only the three guide fields and their headings are gated on
      guide?, and only the single if/else below decides guide content vs the
      write-guide control. A row with a lesson shows the lesson in place of
      the explanation and the guide's prose, which it covers in less space. %>
  <p><strong><%= @reference.tagline %></strong></p>
  <% if @reference.lesson? %>
    <%= render "learn/lesson", lesson: @reference.lesson %>
  <% else %>
    <p><%= @reference.explanation %></p>
  <% end %>
<% end %>

<% if @reference&.guide? && !@reference.lesson? %>
  <%# The reference fields render INSIDE the guide rather than beside it: one
      account of the concept, deepened, not two competing ones. That ordering is
      the visible half of generating both in a single response. %>
  <p><%= @reference.guide_plain_language %></p>
<% end %>

<% if @reference %>
  <%# Folded so the page reads short on a phone; the code is there for
      whoever wants to see it. %>
  <details class="ref learn-code-examples">
    <summary><%= t("learn.code_examples") %></summary>
    <pre class="snippet"><code<% if (lang = hljs_language(@bucket)) %> data-hljs="<%= lang %>"<% end %>><%= @reference.code_example %></code></pre>
    <% if @reference.guide? %>
      <h2><%= t("learn.worked_example") %></h2>
      <p class="learn-worked-example"><%= @reference.guide_worked_example %></p>
    <% end %>
  </details>
<% end %>

<% if @reference&.guide? && !@reference.lesson? %>
  <h2><%= t("learn.pitfalls") %></h2>
  <p><%= @reference.guide_pitfalls %></p>
<% end %>

<% if @reference %>
  <details class="ref learn-senior-lens">
    <summary><%= t("learn.senior_lens") %></summary>
    <p>🔭 <%= @reference.senior_lens %></p>
  </details>
<% end %>

<%= render "learn/drill_control" %>

<%# Outside the @reference gate on purpose: a citation is hand-curated static
    data, so it is worth showing on a concept whose reference has never been
    generated. ConceptBookSources is never sent to a provider — that is the
    guarantee that a citation here cannot be a hallucinated one. %>
<% if (sources = ConceptBookSources.for(@concept)).any? %>
  <h2><%= t("learn.sources") %></h2>
  <ul class="learn-sources">
    <% sources.each do |source| %>
      <li>
        <em><%= source[:title] %></em> — <%= source[:author] %><%= " — #{source[:pointer]}" if source[:pointer] %>
      </li>
    <% end %>
  </ul>
<% end %>

<% if @reference %>
  <%= render "shared/syntax_highlighting_script" %>
<% end %>

<% if !@reference&.guide? %>
  <%# Neither state is an error: the library is browsable from the first page
      load, before anything has been generated. %>
  <%= render "learn/write_up_control", awaiting: "guide", generation_version: nil,
             message: t("learn.no_guide"), button: t("learn.write_guide") %>
<% elsif @ladder_targets.any? %>
  <% if @ladder_missing %>
    <p class="learn-ladder-missing"><%= t("learn.ladder_missing") %></p>
  <% end %>
  <%= render "learn/write_up_control", awaiting: "ladder", generation_version: @reference.generation_version,
             message: t("learn.ladder_offer", targets: @ladder_targets.to_sentence),
             button: t("learn.write_ladder") %>
<% elsif !@reference.lesson? %>
  <% if @lesson_missing %>
    <p class="learn-ladder-missing"><%= t("learn.lesson_missing") %></p>
  <% end %>
  <%= render "learn/write_up_control", awaiting: "lesson", generation_version: @reference.generation_version,
             message: t("learn.lesson_offer"), button: t("learn.write_lesson") %>
<% end %>
