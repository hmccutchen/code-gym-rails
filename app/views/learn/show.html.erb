<p><%= link_to t("learn.back"), learn_path %></p>
<h1><%= @concept.humanize %></h1>
<p class="learn-bucket-label"><%= t("learn.buckets.#{@bucket}") %></p>

<% if @reference %>
  <p><strong><%= @reference.tagline %></strong></p>
  <p><%= @reference.explanation %></p>
<% end %>

<% if @reference&.guide? %>
  <%# The reference fields render INSIDE the guide rather than beside it: one
      account of the concept, deepened, not two competing ones. That ordering is
      the visible half of generating both in a single response. %>
  <p><%= @reference.guide_plain_language %></p>

  <pre class="snippet"><code<% if (lang = hljs_language(@bucket)) %> data-hljs="<%= lang %>"<% end %>><%= @reference.code_example %></code></pre>

  <h2><%= t("learn.worked_example") %></h2>
  <p class="learn-worked-example"><%= @reference.guide_worked_example %></p>

  <h2><%= t("learn.pitfalls") %></h2>
  <p><%= @reference.guide_pitfalls %></p>

  <h2><%= t("learn.senior_lens") %></h2>
  <p>🔭 <%= @reference.senior_lens %></p>
  <%= render "shared/syntax_highlighting_script" %>
<% else %>
  <%# Neither state is an error: the library is browsable from the first page
      load, before anything has been generated. %>
  <div id="learn-guide"
       data-url="<%= prepare_learn_concept_path(bucket: @bucket, concept: @concept) %>"
       data-status-url="<%= learn_concept_status_path(bucket: @bucket, concept: @concept) %>">
    <p class="learn-no-guide"><%= t("learn.no_guide") %></p>
    <button type="button" class="btn btn-sm" id="write-guide"><%= t("learn.write_guide") %></button>
    <span class="learn-status" aria-live="polite"></span>
  </div>

  <%# Inline script, matching the working convention here: the layout emits no
      importmap tags, so nothing else would run. Polls rather than holding the
      request, since this generation runs with extended thinking on. %>
  <script>
    (function () {
      const box    = document.getElementById("learn-guide");
      const button = document.getElementById("write-guide");
      const status = box.querySelector(".learn-status");

      // Bounded so a job that dies silently ends in a message rather than a
      // spinner that never resolves.
      const INTERVAL_MS = 2000;
      const MAX_ATTEMPTS = 45;
      let attempts = 0;

      function poll() {
        attempts++;
        if (attempts > MAX_ATTEMPTS) {
          button.disabled = false;
          status.textContent = "<%= j t("learn.write_guide_failed") %>";
          return;
        }

        fetch(box.dataset.statusUrl, { headers: { "Accept": "application/json" } })
          .then((response) => response.json())
          .then((data) => (data.ready ? window.location.reload() : setTimeout(poll, INTERVAL_MS)))
          .catch(() => setTimeout(poll, INTERVAL_MS));
      }

      button.addEventListener("click", async () => {
        button.disabled = true;
        status.textContent = "<%= j t("learn.writing_guide") %>";

        try {
          const response = await fetch(box.dataset.url, {
            method: "POST",
            headers: {
              "Accept": "application/json",
              "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content
            }
          });
          if (!response.ok) throw new Error("request failed");
          poll();
        } catch {
          button.disabled = false;
          status.textContent = "<%= j t("learn.write_guide_failed") %>";
        }
      });
    })();
  </script>
<% end %>
