<%# Required locals: awaiting ("guide", "ladder" or "lesson"), message, button, generation_version (Integer or nil) %>
<% poll_interval_s = 2.0 %>
<div id="learn-guide" data-controller="write-up-control"
     <%= tag.attributes(data: {
           write_up_control_url_value: prepare_learn_concept_path(bucket: @bucket, concept: @concept),
           write_up_control_status_url_value: learn_concept_status_path(bucket: @bucket, concept: @concept, awaiting: awaiting, generation_version: generation_version),
           write_up_control_rewritten_url_value: learn_concept_path(bucket: @bucket, concept: @concept, awaiting => "missing"),
           write_up_control_interval_ms_value: (poll_interval_s * 1000).to_i,
           write_up_control_max_attempts_value: (AiService.call_budget_seconds(AiService::CONCEPT_REFERENCE_READ_TIMEOUT) / poll_interval_s).ceil,
           write_up_control_writing_text_value: t("learn.writing_guide"),
           write_up_control_failed_text_value: t("learn.write_guide_failed") }) %>>
  <p class="learn-no-guide"><%= message %></p>
  <button type="button" class="btn btn-sm" id="write-guide"
          data-write-up-control-target="button" data-action="write-up-control#start"><%= button %></button>
  <span class="learn-status" aria-live="polite" data-write-up-control-target="status"></span>
</div>
