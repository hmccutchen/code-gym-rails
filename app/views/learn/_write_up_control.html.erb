<%# Required locals: awaiting ("guide", "ladder" or "lesson"), message, button, generation_version (Integer or nil) %>
<div id="learn-guide"
     data-url="<%= prepare_learn_concept_path(bucket: @bucket, concept: @concept) %>"
     data-status-url="<%= learn_concept_status_path(bucket: @bucket, concept: @concept, awaiting: awaiting, generation_version: generation_version) %>">
  <p class="learn-no-guide"><%= message %></p>
  <button type="button" class="btn btn-sm" id="write-guide"><%= button %></button>
  <span class="learn-status" aria-live="polite"></span>
</div>

<%# Design notes: docs/code-notes/app/views/learn/_write_up_control.html.md %>
<% poll_interval_s = 2.0 %>
<script>
  (function () {
    const box    = document.getElementById("learn-guide");
    const button = document.getElementById("write-guide");
    const status = box.querySelector(".learn-status");

    const INTERVAL_MS = <%= (poll_interval_s * 1000).to_i %>;
    const MAX_ATTEMPTS = <%= (AiService.call_budget_seconds(AiService::CONCEPT_REFERENCE_READ_TIMEOUT) / poll_interval_s).ceil %>;
    const FAILED = "<%= j t("learn.write_guide_failed") %>";
    let attempts = 0;

    async function poll() {
      attempts++;
      if (attempts > MAX_ATTEMPTS) {
        status.textContent = FAILED;
        return;
      }

      const { ok, data } = await CodeGymRequest.get(box.dataset.statusUrl);
      if (!ok || !data) return setTimeout(poll, INTERVAL_MS);
      if (data.ready) return window.location.reload();
      if (data.rewritten) return window.location.assign(window.location.pathname + "?<%= awaiting %>=missing");
      if (data.failed) {
        status.textContent = data.message;
        button.disabled = false;
        return;
      }
      setTimeout(poll, INTERVAL_MS);
    }

    button.addEventListener("click", async () => {
      attempts = 0;
      button.disabled = true;
      status.textContent = "<%= j t("learn.writing_guide") %>";

      const result = await CodeGymRequest.send("POST", box.dataset.url, undefined, { fallback: FAILED });
      if (result.ok) return poll();

      button.disabled = false;
      status.textContent = result.message;
    });
  })();
</script>
