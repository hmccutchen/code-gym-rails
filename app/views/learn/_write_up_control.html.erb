<%# Required locals: awaiting ("guide" or "ladder"), message (String),
    button (String), digest (String or nil — the row's content_digest when
    awaiting "ladder"). %>
<div id="learn-guide"
     data-url="<%= prepare_learn_concept_path(bucket: @bucket, concept: @concept) %>"
     data-status-url="<%= learn_concept_status_path(bucket: @bucket, concept: @concept, awaiting: awaiting, digest: digest) %>">
  <p class="learn-no-guide"><%= message %></p>
  <button type="button" class="btn btn-sm" id="write-guide"><%= button %></button>
  <span class="learn-status" aria-live="polite"></span>
</div>

<%# Inline script, matching the working convention here: the layout emits no
    importmap tags, so nothing else would run. Polls rather than holding the
    request, since this generation runs with extended thinking on. %>
<%# The 2s interval is the one place that number lives; MAX_ATTEMPTS derives
    from it and from AiService.call_budget_seconds(CONCEPT_REFERENCE_READ_TIMEOUT)
    — the worst-case time a concept-reference call can take across every
    retry it's allowed — matching dashboard/_generating.html.erb's pattern: a
    hardcoded attempt count bore no relationship to how long the job could
    actually run. %>
<% poll_interval_s = 2.0 %>
<script>
  (function () {
    const box    = document.getElementById("learn-guide");
    const button = document.getElementById("write-guide");
    const status = box.querySelector(".learn-status");

    const INTERVAL_MS = <%= (poll_interval_s * 1000).to_i %>;
    const MAX_ATTEMPTS = <%= (AiService.call_budget_seconds(AiService::CONCEPT_REFERENCE_READ_TIMEOUT) / poll_interval_s).ceil %>;
    let attempts = 0;

    <%# The bulk actions and this per-concept job share the default queue
        against 3 worker threads, so a slow batch can leave this one still
        queued when the budget above runs out — the likeliest state, not a
        dead job. A rewrite that landed without its ladder is different: the
        job has finished, so the page reloads to show the new text and says
        what happened. %>
    function poll() {
      attempts++;
      if (attempts > MAX_ATTEMPTS) {
        status.textContent = "<%= j t("learn.write_guide_failed") %>";
        return;
      }

      fetch(box.dataset.statusUrl, { headers: { "Accept": "application/json" } })
        .then((response) => response.json())
        .then((data) => {
          if (data.ready) return window.location.reload();
          if (data.rewritten) return window.location.assign(window.location.pathname + "?ladder=missing");
          setTimeout(poll, INTERVAL_MS);
        })
        .catch(() => setTimeout(poll, INTERVAL_MS));
    }

    button.addEventListener("click", async () => {
      button.disabled = true;
      status.textContent = "<%= j t("learn.writing_guide") %>";

      try {
        const response = await fetch(box.dataset.url, {
          method: "POST",
          headers: {
            "Accept": "application/json",
            "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content
          }
        });
        if (!response.ok) throw new Error("request failed");
        poll();
      } catch {
        button.disabled = false;
        status.textContent = "<%= j t("learn.write_guide_failed") %>";
      }
    });
  })();
</script>
