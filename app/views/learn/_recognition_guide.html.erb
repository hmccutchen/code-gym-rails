<%# Required locals: guide (a RecognitionGuide).

    A disclosure only to keep the index scannable. Nothing gates it: the guide
    teaches a way of looking, never an answer, so every user sees it. %>
<details class="learn-recognition">
  <summary><%= t("learn.recognition.summary") %></summary>
  <h4><%= t("learn.recognition.questions") %></h4>
  <p><%= guide.questions %></p>
  <h4><%= t("learn.recognition.contrast") %></h4>
  <p class="learn-worked-example"><%= guide.contrast %></p>
  <h4><%= t("learn.recognition.misfires") %></h4>
  <p><%= guide.misfires %></p>
</details>
