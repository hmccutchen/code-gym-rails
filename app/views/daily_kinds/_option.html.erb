<%# Locals: option (DailyKindSwap::Picker::Option), picker, prefix (this place's id prefix). A label takes only phrasing content, hence spans. %>
<% key = option.kind.key %>
<% id = "#{prefix}-#{key}" %>
<% name = t("sections.#{key}.name") %>
<% line_id = option.note ? "#{id}-note" : "#{id}-short" %>
<% described = [ line_id, "#{id}-guide", ("#{id}-consequences" if option.available?) ].compact %>
<label class="daily-kind-option" for="<%= id %>" data-kind="<%= key %>">
  <span class="daily-kind-option-name">
    <%= tag.input type: "radio", form: "daily-kind-swap", name: "daily_kind_#{picker.place}", id: id, value: key,
                  checked: option.now?, disabled: !(option.available? || option.now?), aria: { describedby: described.join(" ") },
                  data: { daily_kind_swap_target: "option", state: option.state,
                          confirm_label: (t("daily_kinds.picker.confirm_kind", kind: name) if option.available?) } %>
    <span><%= name %></span>
    <% if option.mark %>
      <span class="daily-kind-badge<%= " daily-kind-badge-now" if picker.accent_mark?(option) %>"><%= option.mark %></span>
    <% end %>
  </span>
  <span class="daily-kind-line" id="<%= line_id %>"><%= option.note || SectionKindGuide.for(key)[:short] %></span>
  <%= tag.span id: "#{id}-guide", class: "daily-kind-example", hidden: !option.now?,
               data: { daily_kind_swap_target: "example", kind: key } do %><strong><%= t("responses.kind_about.example_label") %></strong> <%= SectionKindGuide.for(key)[:example] %><% end %>
</label>
