<%# Locals: option (an available DailyKindSwap::Picker::Option), prefix. Shown above Confirm while its radio is chosen. %>
<% id = "#{prefix}-#{option.kind.key}-summary" %>
<div class="daily-kind-summary" id="<%= id %>" hidden data-daily-kind-swap-target="summary" data-kind="<%= option.kind.key %>">
  <% option.consequences.warning.each do |paragraph| %>
    <p class="daily-kind-warning"><%= paragraph %></p>
  <% end %>
  <% option.consequences.sentences.each do |sentence| %>
    <p class="hint"><%= sentence %></p>
  <% end %>
</div>
