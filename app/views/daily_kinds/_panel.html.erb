<%# Locals: picker (DailyKindSwap::Picker). Every rule shown here is the server's; the controller only reveals it. %>
<% prefix = "daily-kind-#{picker.place}" %>
<%= tag.div id: "daily-kind-swap-panel-#{picker.place}", class: "daily-kind-swap-panel",
      data: { daily_kind_swap_target: "panel", version: picker.version, current: picker.current.key } do %>
  <% if picker.next_kind_line %>
    <p class="hint daily-kind-next"><%= picker.next_kind_line %></p>
  <% end %>
  <% if picker.hint? %>
    <p class="hint daily-kind-hint"><%= t("daily_kinds.picker.first_time_hint") %></p>
  <% end %>
  <button type="button" class="btn btn-ghost btn-sm daily-kind-trigger" aria-expanded="false" aria-controls="<%= prefix %>-picker"
          data-daily-kind-swap-target="trigger" data-action="daily-kind-swap#toggle"><%= t("daily_kinds.picker.trigger", name: t("sections.#{picker.card_kind.key}.name")) %></button>
  <fieldset id="<%= prefix %>-picker" class="daily-kind-picker" hidden data-daily-kind-swap-target="picker"
            data-action="change->daily-kind-swap#choose keydown->daily-kind-swap#closeOnEscape">
    <legend><%= t("daily_kinds.picker.legend") %></legend>
    <% if picker.closed %>
      <p class="hint" id="<%= prefix %>-closed"><%= picker.closed %></p>
    <% else %>
      <p class="hint" id="<%= prefix %>-next-set"><%= picker.next_set_line %></p>
    <% end %>
    <% picker.options.each do |option| %>
      <%= render "daily_kinds/option", option: option, prefix: prefix, place: picker.place %>
    <% end %>
    <% picker.options.select(&:available?).each do |option| %>
      <%= render "daily_kinds/summary", option: option, prefix: prefix %>
    <% end %>
    <div class="daily-kind-actions">
      <button type="button" class="btn btn-primary btn-sm" disabled data-daily-kind-swap-target="confirm"
              data-action="daily-kind-swap#confirm"><%= t("daily_kinds.picker.confirm") %></button>
      <button type="button" class="btn btn-ghost btn-sm" data-daily-kind-swap-target="cancel"
              data-action="daily-kind-swap#cancel"><%= t("daily_kinds.picker.cancel") %></button>
      <span class="hint" aria-live="polite" data-daily-kind-swap-target="status"></span>
    </div>
  </fieldset>
<% end %>
