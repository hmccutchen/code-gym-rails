<%# Required locals: status (a TrialStatus). One line, since the day's set
    is what the page is for; the trial page carries the rest. %>
<p class="trial-banner hint" style="margin:-1rem 0 1.5rem;">
  <% if status.active? %>
    <%= t("dashboard.trial_banner.active", days: t("dashboard.trial_banner.days", count: status.days_left),
          used: status.used, cap: status.cap || t("dashboard.trial_banner.no_cap")) %>
  <% else %>
    <%= t("dashboard.trial_banner.ended") %>
  <% end %>
  <%= link_to t("dashboard.trial_banner.details"), trial_path %>
</p>
