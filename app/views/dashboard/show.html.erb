<% page_title t("dashboard.show.title") %>
<% page_stylesheet "today" %>
<% wide_page %>

<div class="today-page">
  <div class="page-header">
    <h1><%= t("dashboard.show.title") %></h1>
    <div class="date">
      <%= l(Date.current, format: :weekday) %>
      <% if (streak = current_user.current_streak).positive? %>
        <span class="streak"><%= t("dashboard.show.streak", days: streak) %></span>
      <% end %>
    </div>
  </div>

  <% if @trial_status %>
    <%= render "dashboard/trial_banner", status: @trial_status %>
  <% end %>
  <% if current_user.generation_paused_automatically? %>
    <%= render "dashboard/automatic_pause" %>
  <% end %>
  <div id="dashboard-content">
    <% case @content_state %>
    <% when :trial_ended %>
      <%= render "dashboard/trial_ended", status: @trial_status %>
    <% when :generating %>
      <%= render "dashboard/generating" %>
    <% when :generation_failed %>
      <%= render "dashboard/generation_failed", message: current_user.generation_failure_message(surface: :generation) %>
    <% when :paused %>
      <%= render "dashboard/paused_empty" %>
    <% when :weekend %>
      <%= render "dashboard/weekend_empty" %>
    <% else %>
      <%= render "dashboard/exercise", exercise: @exercise, response: @response %>
    <% end %>
  </div>

  <%# Outside #dashboard-content, which the generating poller replaces. Placement: docs/code-notes/app/views/dashboard/show.html.md %>
  <% if featured_callout_shown?(@exercise, @response) %>
    <div class="featured-compact">
      <%= render "shared/featured_concept", featured: featured_concept, day_response: @response %>
    </div>
  <% end %>
</div>
