<style>
  .page-header { margin-bottom: 2rem; }
  .page-header h1 { font-size: 1.5rem; }
  .page-header .date { color: var(--muted); font-size: .9rem; }
  .page-header .streak { margin-left: .5rem; }

  textarea.answer { width: 100%; min-height: 120px; background: #0d0d1a; border: 1px solid var(--border); border-radius: 6px; padding: .75rem; color: var(--text); font-size: .95rem; font-family: inherit; resize: vertical; line-height: 1.6; }
  textarea.answer:focus { outline: none; border-color: var(--accent); }
  textarea.code-answer { font-family: "Fira Code", "Cascadia Code", monospace; font-size: .85rem; min-height: 160px; }

  .progress-bar { height: 4px; background: var(--border); border-radius: 2px; margin-bottom: 1.5rem; }
  .progress-fill { height: 100%; background: var(--accent); border-radius: 2px; transition: width .3s; }
  .progress-label { font-size: .8rem; color: var(--muted); margin-top: .3rem; }
  .progress-sticky { position: sticky; top: 0; z-index: 10; background: var(--bg); padding: .75rem 0 .5rem; border-bottom: 1px solid var(--border); margin-bottom: 1.5rem; }
  .progress-sticky .progress-bar { margin-bottom: 0; }

  .rating-row { display: flex; gap: .75rem; margin-top: 1rem; }
  .rating-btn { flex: 1; padding: .5rem; border: 1px solid var(--border); border-radius: 6px; background: transparent; color: var(--text); cursor: pointer; font-size: .85rem; text-align: center; }
  .rating-btn:hover { border-color: var(--accent); }
  .rating-btn.active { background: var(--accent); border-color: var(--accent); color: #fff; }
  .rating-section .feedback-title { font-size: 1rem; font-weight: 600; margin-bottom: .25rem; }
  #rating-nudge { margin-top: .5rem; margin-bottom: 1.5rem; }
</style>

<div class="page-header">
  <h1>Today's Code Gym</h1>
  <div class="date">
    <%= Date.current.strftime("%A, %B %-d") %>
    <% if (streak = current_user.current_streak).positive? %>
      <span class="streak">🔥 <%= streak %>-day streak</span>
    <% end %>
  </div>
</div>

<%= turbo_stream_from current_user %>

<div id="dashboard-content">
  <% if @generating %>
    <%= render "dashboard/generating" %>
  <% elsif @weekend_no_exercise %>
    <%= render "dashboard/weekend_empty" %>
  <% else %>
    <%= render "dashboard/exercise", exercise: @exercise, response: @response %>
  <% end %>
</div>
