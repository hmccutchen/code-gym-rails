<%# Locals: note, field, submitted, response. %>
<% if note.present? %>
  <%# Design notes: docs/code-notes/app/views/dashboard/_teaching_hint.html.md %>
  <% locked = !submitted && !response.answered?(field) %>
  <% disclosure = capture do %>
    <details class="hint">
      <summary><%= t("dashboard.teaching_hint.summary") %></summary>
      <div class="hint-body"><%= note %></div>
    </details>
  <% end %>
  <div class="hint-slot" data-hint-for="<%= field %>">
    <p class="hint-locked"<%= " hidden" unless locked %>><%= t("dashboard.teaching_hint.locked") %></p>
    <%= disclosure unless locked %>
    <% unless submitted %><template><%= disclosure %></template><% end %>
  </div>
<% end %>
