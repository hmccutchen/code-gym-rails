<%# Required locals: status (a TrialStatus). %>
<div class="section today-state">
  <p class="today-state-title">
    <%= status.ended_on ? t("dashboard.trial_ended.on_day", day: l(status.ended_on, format: :long)) : t("dashboard.trial_ended.message") %>
  </p>
  <p class="today-state-detail today-state-message"><%= t("dashboard.trial_ended.kept") %></p>
  <p class="today-state-link"><%= link_to t("dashboard.trial_ended.add_key"), setup_path %></p>
</div>
