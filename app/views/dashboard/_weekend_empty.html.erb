<div class="section" style="text-align:center;padding:3rem;">
  <p style="color:var(--muted);margin-bottom:1rem;"><%= t("dashboard.weekend_empty.message") %></p>
  <%= button_to t("dashboard.generate_anyway"), generate_path, method: :post, class: "btn btn-ghost btn-sm",
        form: { data: { controller: "loading-form", action: "submit->loading-form#submit pageshow@window->loading-form#restore",
                        loading_form_label_value: t("dashboard.generating_label") } } %>
</div>
