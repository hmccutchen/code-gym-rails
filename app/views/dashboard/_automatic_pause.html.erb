<div class="automatic-pause hint">
  <p><%= t("dashboard.automatic_pause.message") %></p>
  <%= button_to t("dashboard.automatic_pause.resume"), toggle_generation_account_path, method: :patch,
        params: { paused: "0", return_to: "dashboard" }, class: "btn btn-sm" %>
  <%= button_to t("dashboard.automatic_pause.keep_paused"), toggle_generation_account_path, method: :patch,
        params: { paused: "1", return_to: "dashboard" }, class: "btn btn-ghost btn-sm" %>
</div>
