<%# One learning track proposal. Local: proposal (TrackGraduation::Proposal). %>
<% name = ->(key) { t("sections.#{key}.name") } %>
<% in_place = current_user.applies_track_proposals_in_place? || (proposal.steps.map(&:kind) & current_user.excluded_section_kinds).any? %>
<%= tag.div id: "track-proposal", class: "mix-note track-proposal",
      data: { controller: "track-proposal",
              track_proposal_levels_value: current_user.section_kind_levels.to_json,
              track_proposal_version_value: current_user.section_kind_preferences_version,
              track_proposal_url_value: profile_path,
              track_proposal_dismiss_url_value: learning_track_dismissal_path,
              track_proposal_answer_url_value: learning_track_answer_path,
              track_proposal_applied_text_value: t("learning_track.proposal.applied"),
              track_proposal_dismissed_text_value: t("learning_track.proposal.dismissed"),
              track_proposal_count_failed_text_value: t("learning_track.proposal.count_failed"),
              track_proposal_stranded_text_value: t("learning_track.proposal.stranded"),
              track_proposal_reload_label_value: t("learning_track.proposal.reload") } do %>
  <% if proposal.basis == :led %>
    <% lead = ExerciseSection.learning_track_lead.key %>
    <p><%= t("learning_track.proposal.led_heading", kind: name.call(lead),
             level: t("exercise_mix.levels.#{current_user.section_kind_levels[lead]}").downcase) %></p>
    <ul>
      <% proposal.steps.each do |step| %>
        <li data-step data-track-proposal-target="step" data-kind="<%= step.kind %>" data-to="<%= step.to %>">
          <%= t(step.results_at_level.zero? ? "learning_track.proposal.led_no_results" : "learning_track.proposal.led_with_results",
                kind: name.call(step.kind)) %>
          <% if in_place %>
            <button type="button" class="btn btn-ghost btn-sm" data-remove-step data-action="track-proposal#removeStep"
                    aria-label="<%= t("learning_track.proposal.remove_label", kind: name.call(step.kind)) %>"><%= t("learning_track.proposal.remove") %></button>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <% step = proposal.steps.first %>
    <p data-step data-track-proposal-target="step" data-kind="<%= step.kind %>" data-to="<%= step.to %>">
      <%= t("learning_track.proposal.#{proposal.basis}", kind: name.call(step.kind)) %>
    </p>
  <% end %>
  <% if in_place %>
    <button type="button" class="btn btn-primary btn-sm" data-apply data-track-proposal-target="apply"
            data-action="track-proposal#apply"><%= t("learning_track.proposal.apply") %></button>
  <% else %>
    <%= link_to t("learning_track.proposal.change_in_setup"),
                setup_path(suggested: proposal.steps.map(&:kind), suggested_level: proposal.steps.first.to, anchor: "exercise-mix"),
                class: "btn btn-primary btn-sm", data: { change_in_setup: true, track_proposal_target: "setupLink" } %>
  <% end %>
  <button type="button" class="btn btn-ghost btn-sm" data-not-now data-track-proposal-target="notNow"
          data-action="track-proposal#notNow"><%= t("learning_track.proposal.not_now") %></button>
  <p class="hint"><%= t("learning_track.proposal.turn_off_html",
                        link: link_to(t("learning_track.proposal.turn_off_link"), setup_path(anchor: "learning-track"))) %></p>
<% end %>

