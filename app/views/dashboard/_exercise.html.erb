<% submitted = response.persisted? && response.submitted? %>

<div class="regenerate-row" style="margin-bottom:1.5rem;">
  <% if exercise.regenerated_at.present? %>
    <p class="hint">You've already generated a new set today.</p>
  <% else %>
    <% has_progress = response.persisted? && (response.submitted? || response.answers.values.any?(&:present?)) %>
    <% confirm_msg = has_progress ?
         "This will replace today's problems and erase your answers so far. This can't be undone. Continue?" :
         "Generate a new set for today?" %>
    <%= button_to "Generate new set", regenerate_path, method: :post,
          class: "btn btn-ghost btn-sm",
          data: { turbo_confirm: confirm_msg, regenerate_target: "button" },
          form: { data: { controller: "regenerate",
                          action: "turbo:submit-start->regenerate#start turbo:submit-end->regenerate#stop" } } %>
  <% end %>
</div>

<% if submitted %>
  <%= render "responses/answered_sections", exercise: exercise, response: response %>
  <%= render "responses/submission", response: response %>
<% else %>
  <%# Progress bar (sticky so progress stays visible while scrolling the three
      sections on small screens) %>
  <div class="progress-sticky">
    <div class="progress-bar">
      <div class="progress-fill" id="progress-fill" style="width:0%"></div>
    </div>
    <div class="progress-label" id="progress-label">0 of 3 answered</div>
  </div>

  <%# Always POST, never PATCH — ResponsesController#create is idempotent via
      find_or_initialize_by. The script below submits it via fetch. %>
  <%= form_with url: responses_path, method: :post, id: "gym-form", data: { turbo: false } do |f| %>
    <% cr = exercise.code_review %>
    <div class="section">
      <div class="section-label">1 — Code Review</div>
      <% if cr["scenario"].present? %><div class="section-scenario"><%= cr["scenario"] %></div><% end %>
      <div class="question"><%= cr["question"] %></div>
      <pre class="snippet"><code><%= cr["snippet"] %></code></pre>
      <% if (ref = concept_reference_for(cr["concept"], exercise.language)) %>
        <%= render "shared/concept_reference", reference: ref %>
      <% end %>
      <%= render "dashboard/teaching_hint", note: cr["teaching_note"], field: "code_review", submitted: false, answer: response.answers["code_review"] %>
      <textarea name="response[answers][code_review]" class="answer" placeholder="What's the issue and how would you fix it?" data-field="code_review"><%= response.answers["code_review"] %></textarea>
    </div>

    <% pat = exercise.pattern %>
    <div class="section">
      <div class="section-label">2 — Pattern of the Month: <%= pat["title"] %></div>
      <% if pat["scenario"].present? %><div class="section-scenario"><%= pat["scenario"] %></div><% end %>
      <div class="why-box"><strong>Why it exists:</strong> <%= pat["why"] %></div>
      <div class="question"><%= pat["question"] %></div>

      <% if (ref = concept_reference_for(pat["concept"], exercise.language)) %>
        <%= render "shared/concept_reference", reference: ref %>
      <% end %>

      <%= render "dashboard/teaching_hint", note: pat["teaching_note"], field: "pattern", submitted: false, answer: response.answers["pattern"] %>
      <textarea name="response[answers][pattern]" class="answer" placeholder="Your answer…" data-field="pattern"><%= response.answers["pattern"] %></textarea>
    </div>

    <% if (arch = exercise.architecture) %>
      <%= render "responses/architecture_section", arch: arch, response: response, submitted: false %>
    <% else %>
      <% ch = exercise.challenge %>
      <div class="section">
        <div class="section-label">3 — Coding Challenge</div>
        <% if ch["scenario"].present? %><div class="section-scenario"><%= ch["scenario"] %></div><% end %>
        <div class="question"><%= ch["question"] %></div>
        <% if ch["starter_code"].present? %>
          <pre class="snippet"><code><%= ch["starter_code"] %></code></pre>
        <% end %>
        <% if (ref = concept_reference_for(ch["concept"], exercise.language)) %>
          <%= render "shared/concept_reference", reference: ref %>
        <% end %>
        <%= render "dashboard/teaching_hint", note: ch["teaching_note"], field: "challenge", submitted: false, answer: response.answers["challenge"] %>
        <textarea name="response[answers][challenge]" class="answer code-answer" placeholder="# Your implementation…" data-field="challenge"><%= response.answers["challenge"] %></textarea>
      </div>
    <% end %>

    <div class="section rating-section">
      <p class="feedback-title">How was today's difficulty?</p>
      <div class="rating-row">
        <% DailyResponse::SELF_RATING_LABELS.each do |value, label| %>
          <button type="button" class="rating-btn<%= " active" if response.section_ratings.values.all?(value) %>" data-rating="<%= value %>"><%= label.upcase_first %></button>
        <% end %>
      </div>
      <textarea name="response[feedback_text]" id="feedback-text" class="answer" style="min-height:70px;margin-top:.75rem" placeholder="Optional: anything specific to adjust next time?"><%= response.feedback_text %></textarea>
    </div>

    <% unrated = response.section_ratings.blank? %>
    <div class="submit-row" id="submit-row">
      <%= f.hidden_field :submit, value: "1" %>
      <%= f.submit "Submit answers →", id: "submit-answers", class: "btn btn-primary", disabled: unrated %>
      <span style="font-size:.8rem;color:var(--muted)">Auto-saved as you type</span>
    </div>
    <p class="progress-label" id="rating-nudge"<%= " hidden".html_safe unless unrated %>>Rate today's difficulty to finish up.</p>
  <% end %>

  <script>
  // Wrapped in an IIFE: Turbo re-executes <script> tags whenever this partial is
  // replaced (regenerate broadcast, or a later day's cron firing while the tab
  // stays open). Top-level const/let would redeclare on the second run.
  (() => {
    const form = document.getElementById("gym-form");
    const textareas = form.querySelectorAll("textarea[data-field]");
    const progressFill = document.getElementById("progress-fill");
    const progressLabel = document.getElementById("progress-label");
    const ratingButtons = form.querySelectorAll("button[data-rating]");
    const feedbackText  = document.getElementById("feedback-text");
    const submitButton  = document.getElementById("submit-answers");
    const ratingNudge   = document.getElementById("rating-nudge");
    const activeRating  = form.querySelector("button.rating-btn.active");
    let rating = activeRating ? activeRating.dataset.rating : null;

    function updateProgress() {
      const filled = [...textareas].filter(t => t.value.trim().length > 10).length;
      progressFill.style.width = (filled / 3 * 100) + "%";
      progressLabel.textContent = filled === 3 ? "✓ All answered — ready to submit!" : `${filled} of 3 answered`;
      document.querySelectorAll("details.hint[data-hint-for]").forEach(d => {
        const t = form.querySelector(`textarea[data-field="${d.dataset.hintFor}"]`);
        if (t) d.classList.toggle("locked", t.value.trim().length <= 10);
      });
    }

    function payload(extra) {
      const answers = {};
      textareas.forEach(t => answers[t.dataset.field] = t.value);
      return { response: Object.assign(
        { answers: answers, rating: rating, feedback_text: feedbackText.value }, extra || {}
      ) };
    }

    let saveTimer;
    function autoSave() {
      clearTimeout(saveTimer);
      saveTimer = setTimeout(async () => {
        await fetch(form.action, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Accept": "application/json",
            "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content
          },
          body: JSON.stringify(payload())
        });
      }, 800);
    }

    textareas.forEach(t => {
      t.addEventListener("input", () => { updateProgress(); autoSave(); });
    });

    ratingButtons.forEach(btn => {
      btn.addEventListener("click", () => {
        rating = btn.dataset.rating;
        ratingButtons.forEach(b => b.classList.toggle("active", b === btn));
        submitButton.disabled = false;
        ratingNudge.hidden = true;
        autoSave();
      });
    });

    feedbackText.addEventListener("input", autoSave);

    // Submit goes through fetch with the page's CSRF meta tag. On success we
    // navigate to the URL the server returns in `redirect` — the dashboard,
    // which re-renders as the submitted state with the review button.
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      clearTimeout(saveTimer);

      submitButton.disabled = true;
      submitButton.value = "Submitting…";

      try {
        const res = await fetch(form.action, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Accept": "application/json",
            "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content
          },
          body: JSON.stringify(payload({ submit: "1" }))
        });

        if (res.ok) {
          const data = await res.json();
          window.location = data.redirect || "/";
        } else {
          submitButton.disabled = false;
          submitButton.value = "Submit answers →";
          alert("Couldn't submit your answers — please try again.");
        }
      } catch (error) {
        submitButton.disabled = false;
        submitButton.value = "Submit answers →";
        alert("Couldn't submit your answers — please try again.");
      }
    });

    updateProgress();
  })();
  </script>
<% end %>
