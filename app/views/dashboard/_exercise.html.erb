<% if @regeneration_failed %>
  <div class="flash alert" style="margin-bottom:1.5rem;">
    Couldn't generate a new set: <%= current_user.last_generation_error %>
  </div>
<% end %>
<% submitted = response.persisted? && response.submitted? %>

<div class="regenerate-row" style="margin-bottom:1.5rem;display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;">
  <div>
    <% if exercise.regenerated_at.present? %>
      <p class="hint">You've already generated a new set today.</p>
    <% else %>
      <% has_progress = response.persisted? && (response.submitted? || response.answers.values.any?(&:present?)) %>
      <% confirm_msg = has_progress ?
           "This will replace today's problems and erase your answers so far. This can't be undone. Continue?" :
           "Generate a new set for today?" %>
      <%# turbo_confirm would be inert here — Turbo JS is not loaded. The
          layout's loading-form script provides the confirm and the in-flight
          spinner; the request then blocks synchronously on the provider
          (10–30s) until the redirect lands. %>
      <%= button_to "Generate new set", regenerate_path, method: :post,
            class: "btn btn-ghost btn-sm",
            form: { data: { loading_form: true, loading_label: "Generating…",
                            confirm_message: confirm_msg } } %>
    <% end %>
  </div>

  <% if response.persisted? && !response.reviewed? %>
    <%= button_to "Start over", start_over_response_path(response), method: :delete,
          class: "btn btn-ghost btn-sm",
          form: { data: { loading_form: true, loading_label: "Starting over…",
                          confirm_message: "This will clear today's answers, ratings, and feedback so you can start fresh. This can't be undone. Continue?" } } %>
  <% end %>
</div>

<% if submitted %>
  <%= render "responses/answered_sections", exercise: exercise, response: response %>
  <%= render "responses/submission", response: response %>
<% else %>
  <%= render "shared/syntax_highlighting_script" %>
  <%# Progress bar (sticky so progress stays visible while scrolling the three
      sections on small screens) %>
  <div class="progress-sticky">
    <div class="progress-bar">
      <div class="progress-fill" id="progress-fill" style="width:0%"></div>
    </div>
    <div class="progress-label" id="progress-label">0 of <%= exercise.active_section_keys.size %> answered</div>
  </div>

  <%# Always POST, never PATCH — ResponsesController#create is idempotent via
      find_or_initialize_by. The script below submits it via fetch. %>
  <%= form_with url: responses_path, method: :post, id: "gym-form", data: { turbo: false } do |f| %>
    <% cr = exercise.code_review %>
    <div class="section">
      <div class="section-label">1 — Code Review</div>
      <% if cr["scenario"].present? %><div class="section-scenario"><%= glossary_wrap(cr["scenario"]) %></div><% end %>
      <div class="question"><%= glossary_wrap(cr["question"]) %></div>
      <pre class="snippet"><code<% if (lang = hljs_language(exercise.language)) %> data-hljs="<%= lang %>"<% end %>><%= cr["snippet"] %></code></pre>
      <%= render "shared/mermaid_diagram", source: cr["diagram"] %>
      <% if (ref = concept_reference_for(cr["concept"], exercise.language)) %>
        <%= render "shared/concept_reference", reference: ref,
              open: first_exposure?(cr["concept"], exercise.language, exercise.date) %>
      <% end %>
      <%= render "dashboard/teaching_hint", note: cr["teaching_note"], field: "code_review", submitted: false, response: response %>
      <textarea name="response[answers][code_review]" class="answer" placeholder="What's the issue and how would you fix it?" data-field="code_review"><%= response.answers["code_review"] %></textarea>
      <div class="rating-row" data-rating-for="code_review">
        <% DailyResponse::SELF_RATING_LABELS.each do |value, label| %>
          <button type="button" class="rating-btn<%= " active" if response.self_rating_for("code_review") == value %>" data-rating-for="code_review" data-rating="<%= value %>"><%= label.upcase_first %></button>
        <% end %>
      </div>
      <%= render "shared/duck_thread", field: "code_review" %>
    </div>

    <% pat = exercise.pattern %>
    <div class="section">
      <div class="section-label">2 — Pattern of the Month: <%= glossary_wrap(pat["title"]) %></div>
      <% if pat["scenario"].present? %><div class="section-scenario"><%= glossary_wrap(pat["scenario"]) %></div><% end %>
      <div class="why-box"><strong>Why it exists:</strong> <%= glossary_wrap(pat["why"]) %></div>
      <div class="question"><%= glossary_wrap(pat["question"]) %></div>
      <%= render "shared/mermaid_diagram", source: pat["diagram"] %>

      <% if (ref = concept_reference_for(pat["concept"], exercise.language)) %>
        <%= render "shared/concept_reference", reference: ref,
              open: first_exposure?(pat["concept"], exercise.language, exercise.date) %>
      <% end %>

      <%= render "dashboard/teaching_hint", note: pat["teaching_note"], field: "pattern", submitted: false, response: response %>
      <textarea name="response[answers][pattern]" class="answer" placeholder="Your answer…" data-field="pattern" <%= tag.attributes(answer_scaffold_labels_attr(response, "pattern")) %>><%= answer_starting_value(response, "pattern") %></textarea>
      <div class="rating-row" data-rating-for="pattern">
        <% DailyResponse::SELF_RATING_LABELS.each do |value, label| %>
          <button type="button" class="rating-btn<%= " active" if response.self_rating_for("pattern") == value %>" data-rating-for="pattern" data-rating="<%= value %>"><%= label.upcase_first %></button>
        <% end %>
      </div>
      <%= render "shared/duck_thread", field: "pattern" %>
    </div>

    <% if (arch = exercise.architecture) %>
      <%= render "responses/architecture_section", arch: arch, response: response, submitted: false %>
    <% elsif (sec = exercise.security_review) %>
      <%= render "responses/security_review_section", sec: sec, response: response, submitted: false %>
    <% elsif (parsons = exercise.parsons_problem) %>
      <%= render "responses/parsons_problem_section", parsons: parsons, response: response, submitted: false %>
    <% else %>
      <% ch = exercise.challenge %>
      <div class="section">
        <div class="section-label">3 — Coding Challenge</div>
        <% if ch["scenario"].present? %><div class="section-scenario"><%= glossary_wrap(ch["scenario"]) %></div><% end %>
        <div class="question"><%= glossary_wrap(ch["question"]) %></div>
        <% if ch["starter_code"].present? %>
          <pre class="snippet"><code<% if (lang = hljs_language(exercise.language)) %> data-hljs="<%= lang %>"<% end %>><%= ch["starter_code"] %></code></pre>
        <% end %>
        <%= render "shared/mermaid_diagram", source: ch["diagram"] %>
        <% if (ref = concept_reference_for(ch["concept"], exercise.language)) %>
          <%= render "shared/concept_reference", reference: ref,
                open: first_exposure?(ch["concept"], exercise.language, exercise.date) %>
        <% end %>
        <%= render "dashboard/teaching_hint", note: ch["teaching_note"], field: "challenge", submitted: false, response: response %>
        <textarea name="response[answers][challenge]" class="answer code-answer" placeholder="# Your implementation…" data-field="challenge"><%= response.answers["challenge"] %></textarea>
        <div class="rating-row" data-rating-for="challenge">
          <% DailyResponse::SELF_RATING_LABELS.each do |value, label| %>
            <button type="button" class="rating-btn<%= " active" if response.self_rating_for("challenge") == value %>" data-rating-for="challenge" data-rating="<%= value %>"><%= label.upcase_first %></button>
          <% end %>
        </div>
        <%= render "shared/duck_thread", field: "challenge" %>
      </div>
    <% end %>

    <% if (pr = exercise.plan_review) %>
      <%= render "responses/plan_review_section", pr: pr, response: response, submitted: false %>
    <% elsif (ah = exercise.ambiguity_hunt) %>
      <%= render "responses/ambiguity_hunt_section", ah: ah, response: response, submitted: false %>
    <% end %>

    <div class="section rating-section">
      <p class="feedback-title">Anything to adjust next time?</p>
      <textarea name="response[feedback_text]" id="feedback-text" class="answer" style="min-height:70px" placeholder="Optional: anything specific to adjust next time?"><%= response.feedback_text %></textarea>
    </div>

    <% rated_sections = response.section_ratings.keys %>
    <% section_keys   = exercise.active_section_keys %>
    <% all_rated      = (section_keys - rated_sections).empty? %>
    <div class="submit-row" id="submit-row">
      <%= f.hidden_field :submit, value: "1" %>
      <%= f.button "Submit answers →", type: "submit", id: "submit-answers", class: "btn btn-primary", disabled: !all_rated %>
      <span style="font-size:.8rem;color:var(--muted)">Auto-saved as you type</span>
    </div>
    <p class="progress-label" id="rating-nudge"<%= " hidden".html_safe if all_rated %>>Rate every section's difficulty to finish up.</p>
  <% end %>

  <script>
  // Wrapped in an IIFE: Turbo re-executes <script> tags whenever this partial is
  // replaced (regenerate broadcast, or a later day's cron firing while the tab
  // stays open). Top-level const/let would redeclare on the second run.
  (() => {
    const form = document.getElementById("gym-form");
    const textareas = form.querySelectorAll("textarea[data-field]");
    const progressFill = document.getElementById("progress-fill");
    const progressLabel = document.getElementById("progress-label");
    const ratingButtons = form.querySelectorAll("button[data-rating-for]");
    const feedbackText  = document.getElementById("feedback-text");
    const submitButton  = document.getElementById("submit-answers");
    const ratingNudge   = document.getElementById("rating-nudge");
    const sectionFields = [...form.querySelectorAll("textarea[data-field]")].map(t => t.dataset.field);

    const ratings = {};
    form.querySelectorAll("button.rating-btn.active").forEach(b => { ratings[b.dataset.ratingFor] = b.dataset.rating; });

    function allRated() {
      return sectionFields.every(section => ratings[section]);
    }

    function refreshSubmit() {
      const ready = allRated();
      submitButton.disabled = !ready;
      ratingNudge.hidden = ready;
    }

    // The client-side half of DailyResponse.answered? — same rule, same
    // threshold, but the label list comes from the server (data-scaffold-labels)
    // rather than a second copy of the scaffold living here.
    const ANSWER_MIN_LENGTH = <%= DailyResponse::ANSWER_MIN_LENGTH %>;

    function substantive(textarea) {
      const labels = JSON.parse(textarea.dataset.scaffoldLabels || "[]");
      if (!labels.length) return textarea.value.trim();
      return textarea.value.split("\n").filter(line => !labels.includes(line.trim())).join("\n").trim();
    }

    function answered(textarea) {
      return substantive(textarea).length > ANSWER_MIN_LENGTH;
    }

    function updateProgress() {
      const filled = [...textareas].filter(answered).length;
      progressFill.style.width = (filled / sectionFields.length * 100) + "%";
      progressLabel.textContent = filled === sectionFields.length ? "✓ All answered — ready to submit!" : `${filled} of ${sectionFields.length} answered`;
      document.querySelectorAll("details.hint[data-hint-for]").forEach(d => {
        const t = form.querySelector(`textarea[data-field="${d.dataset.hintFor}"]`);
        if (t) d.classList.toggle("locked", !answered(t));
      });
    }

    function payload(extra) {
      const answers = {};
      textareas.forEach(t => answers[t.dataset.field] = t.value);
      return { response: Object.assign(
        { answers: answers, section_ratings: ratings, feedback_text: feedbackText.value }, extra || {}
      ) };
    }

    let saveTimer;
    function autoSave() {
      clearTimeout(saveTimer);
      saveTimer = setTimeout(async () => {
        await fetch(form.action, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Accept": "application/json",
            "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content
          },
          body: JSON.stringify(payload())
        });
      }, 800);
    }

    textareas.forEach(t => {
      t.addEventListener("input", () => { updateProgress(); autoSave(); });
    });

    ratingButtons.forEach(btn => {
      btn.addEventListener("click", () => {
        const section = btn.dataset.ratingFor;
        ratings[section] = btn.dataset.rating;
        form.querySelectorAll(`button[data-rating-for="${section}"]`)
            .forEach(b => b.classList.toggle("active", b === btn));
        refreshSubmit();
        autoSave();
      });
    });

    feedbackText.addEventListener("input", autoSave);

    // Submit goes through fetch with the page's CSRF meta tag. On success we
    // navigate to the URL the server returns in `redirect` — the dashboard,
    // which re-renders as the submitted state with the review button.
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      clearTimeout(saveTimer);

      submitButton.disabled = true;
      submitButton.classList.add("btn-loading");
      submitButton.textContent = "Submitting…";

      try {
        const res = await fetch(form.action, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Accept": "application/json",
            "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content
          },
          body: JSON.stringify(payload({ submit: "1" }))
        });

        if (res.ok) {
          const data = await res.json();
          window.location = data.redirect || "/";
        } else {
          submitButton.disabled = false;
          submitButton.classList.remove("btn-loading");
          submitButton.textContent = "Submit answers →";
          alert("Couldn't submit your answers — please try again.");
        }
      } catch (error) {
        submitButton.disabled = false;
        submitButton.classList.remove("btn-loading");
        submitButton.textContent = "Submit answers →";
        alert("Couldn't submit your answers — please try again.");
      }
    });

    updateProgress();
    refreshSubmit();
  })();
  </script>
<% end %>
