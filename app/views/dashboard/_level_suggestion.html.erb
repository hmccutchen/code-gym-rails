<%# One learning track proposal. Local: proposal (LevelSuggestion::Proposal). %>
<% name = ->(key) { t("sections.#{key}.name") } %>
<% level_name = ->(level) { t("exercise_mix.levels.#{level}").downcase } %>
<% in_place = current_user.applies_level_suggestions_in_place? || (proposal.steps.map(&:kind) & current_user.excluded_section_kinds).any? %>
<%= tag.div id: "level-suggestion", class: "mix-note level-suggestion",
      data: { controller: "level-suggestion",
              level_suggestion_levels_value: current_user.section_kind_levels.to_json,
              level_suggestion_version_value: current_user.section_kind_preferences_version,
              level_suggestion_url_value: profile_path,
              level_suggestion_dismiss_url_value: level_suggestion_dismissal_path,
              level_suggestion_answer_url_value: level_suggestion_answer_path,
              level_suggestion_applied_text_value: t("learning_track.proposal.applied"),
              level_suggestion_dismissed_text_value: t("learning_track.proposal.dismissed"),
              level_suggestion_count_failed_text_value: t("learning_track.proposal.count_failed"),
              level_suggestion_stranded_text_value: t("learning_track.proposal.stranded"),
              level_suggestion_reload_label_value: t("learning_track.proposal.reload") } do %>
  <% if proposal.steps.one? %>
    <% step = proposal.steps.first %>
    <p data-step data-level-suggestion-target="step" data-kind="<%= step.kind %>" data-to="<%= step.to %>">
      <% if proposal.basis == :struggling %>
        <%= t("learning_track.proposal.struggling", kind: name.call(step.kind), too_hard: step.too_hard,
              window: [ step.results_at_level, LevelSuggestion::STEP_BACK_WINDOW ].min,
              level: level_name.call(step.from), lower: level_name.call(step.to)) %>
      <% else %>
        <%= t("learning_track.proposal.own", kind: name.call(step.kind), favourable: step.favourable,
              window: LevelSuggestion::WINDOW, level: level_name.call(step.to)) %>
      <% end %>
    </p>
  <% else %>
    <p><%= t("learning_track.proposal.own_heading", level: level_name.call(proposal.steps.first.to)) %></p>
    <ul>
      <% proposal.steps.each do |step| %>
        <li data-step data-level-suggestion-target="step" data-kind="<%= step.kind %>" data-to="<%= step.to %>">
          <%= t("learning_track.proposal.own_item", kind: name.call(step.kind), favourable: step.favourable,
                window: LevelSuggestion::WINDOW) %>
          <% if in_place %>
            <button type="button" class="btn btn-ghost btn-sm" data-remove-step data-action="click->level-suggestion#removeStep"
                    aria-label="<%= t("learning_track.proposal.remove_label", kind: name.call(step.kind), level: level_name.call(step.from)) %>"><%= t("learning_track.proposal.remove", level: level_name.call(step.from)) %></button>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
  <% if in_place %>
    <button type="button" class="btn btn-primary btn-sm" data-apply data-level-suggestion-target="apply"
            data-action="click->level-suggestion#apply"><%= t("learning_track.proposal.apply") %></button>
  <% else %>
    <%= link_to t("learning_track.proposal.change_in_setup"),
                setup_path(suggested: proposal.steps.map(&:kind), suggested_level: proposal.steps.first.to, anchor: "exercise-mix"),
                class: "btn btn-primary btn-sm", data: { change_in_setup: true, level_suggestion_target: "setupLink" } %>
  <% end %>
  <button type="button" class="btn btn-ghost btn-sm" data-not-now data-level-suggestion-target="notNow"
          data-action="click->level-suggestion#notNow"><%= t("learning_track.proposal.not_now") %></button>
  <p class="hint"><%= t("learning_track.proposal.turn_off_html",
                        link: link_to(t("learning_track.proposal.turn_off_link"), setup_path(anchor: "learning-track"))) %></p>
<% end %>
