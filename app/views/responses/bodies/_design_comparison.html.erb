<%# Locals: data, exercise, response, submitted. %>
<% ExerciseSection::DesignComparison::PIECES.each do |piece| %>
  <details class="comparison-piece" open>
    <summary><%= t("sections.design_comparison.piece", piece: piece.upcase) %></summary>
    <pre class="snippet"><%= highlighted_code(data["piece_#{piece}"], exercise.language) %></pre>
  </details>
<% end %>
