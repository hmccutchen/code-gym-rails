<%# Locals: data, exercise, response, submitted. %>
<pre class="snippet"><code<% if (lang = hljs_language(exercise.language)) %> data-hljs="<%= lang %>"<% end %>><%= data["snippet"] %></code></pre>
<% if data["current_schema"].present? %>
  <details class="ref">
    <summary><%= t("sections.code_review.current_schema") %></summary>
    <pre class="snippet"><code<% if (lang = hljs_language(exercise.language)) %> data-hljs="<%= lang %>"<% end %>><%= data["current_schema"] %></code></pre>
  </details>
<% end %>
