<%# Locals: data, exercise, response, submitted. %>
<% files = ExerciseSection::CodeReview.files(data) %>
<% if ExerciseSection::CodeReview.bug_hunt?(data) %>
<div class="section-scenario bug-hunt-goal"><strong><%= t("sections.code_review.goal") %></strong> <%= data["purpose"] %></div>
<% snippet = ExerciseSection::CodeReview::File.new(path: nil, code: data["snippet"].to_s, changed: []) %>
<pre class="snippet"><%= highlighted_code(snippet.code, exercise.language, number_width: snippet.number_width) %></pre>
<% elsif files.empty? %>
<pre class="snippet"><%= highlighted_code(data["snippet"], exercise.language) %></pre>
<% if data["current_schema"].present? %>
  <details class="ref">
    <summary><%= t("sections.code_review.current_schema") %></summary>
    <pre class="snippet"><%= highlighted_code(data["current_schema"], exercise.language) %></pre>
  </details>
<% end %>
<% else %>
<% files.each do |file| %>
  <% label = changed_lines_label(file.changed) %>
  <details class="comparison-piece" open>
    <summary><span class="file-summary"><%= file.path %><%= " — #{label}" if label.present? %></span></summary>
    <pre class="snippet"><%= highlighted_code(file.code, exercise.language, changed: file.changed, number_width: file.number_width) %></pre>
  </details>
<% end %>
<% end %>
