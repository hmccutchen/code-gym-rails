<%# Locals: kind, key, data, exercise, response, submitted. %>
<% round  = response.pseudocode_round(key) %>
<% points = ExerciseSection::PseudocodeToCode.normalize_critique(round["critique"]) %>

<% if submitted %>
  <% partial = response.partial_answer(key) %><div class="answer-display"><%= response.answer_for(key) || partial || t("responses.answered.skipped") %></div><% if partial && response.answer_for(key).nil? %><p class="answer-note"><%= t("responses.answered.not_counted") %></p><% end %>
<% else %>
  <textarea name="response[answers][<%= key %>]" class="<%= kind.answer_class %>"
            placeholder="<%= t("sections.#{key}.placeholder") %>" data-field="<%= key %>"
            maxlength="<%= UserText::MAX_ANSWER_LENGTH %>"><%= answer_starting_value(response, key) %></textarea>
<% end %>

<div class="pseudocode-rounds"<% unless submitted %> data-controller="pseudocode-round"
     data-pseudocode-round-section-value="<%= key %>"
     data-pseudocode-round-url-value="<%= pseudocode_critique_responses_path %>"
     data-pseudocode-round-heading-text-value="<%= t("pseudocode.critique_heading") %>"
     data-pseudocode-round-no-gaps-text-value="<%= t("pseudocode.no_gaps") %>"
     data-pseudocode-round-working-text-value="<%= t("pseudocode.working") %>"
     data-pseudocode-round-failed-text-value="<%= t("pseudocode.critique_failed") %>"<% end %>>
  <% unless submitted %>
    <div class="pseudocode-controls">
      <button type="button" class="btn btn-ghost btn-sm" data-pseudocode-round-target="button"
              data-action="pseudocode-round#critique"
              <%= "disabled" if response.critiqued?(key) %>><%= t("pseudocode.critique_button") %></button>
      <span class="pseudocode-status" aria-live="polite" data-pseudocode-round-target="status"></span>
    </div>
  <% end %>

  <div class="pseudocode-critique" aria-live="polite"<% unless submitted %> data-pseudocode-round-target="output"<% end %>>
    <% if response.critiqued?(key) %>
      <% if points.any? %>
        <p class="pseudocode-critique-label"><%= t("pseudocode.critique_heading") %></p>
        <ul><% points.each do |point| %><li><%= point %></li><% end %></ul>
      <% else %>
        <p class="pseudocode-critique-label"><%= t("pseudocode.no_gaps") %></p>
      <% end %>
    <% end %>
  </div>

  <%# Written by the review; rendered in both states for rows translated when this page had a translate button. %>
  <div class="pseudocode-code">
    <% if round["generated_code"].present? %>
      <pre><%= highlighted_code(round["generated_code"], exercise.language) %></pre>
      <%# Keep this caption: without it the generated code reads as a model answer. %>
      <p class="pseudocode-caption"><%= t("pseudocode.caption") %></p>
    <% end %>
  </div>
</div>

