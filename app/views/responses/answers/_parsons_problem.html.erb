<%# Locals: kind, key, data, exercise, response, submitted. Notes: docs/code-notes/app/views/responses/answers/_parsons_problem.html.md %>
<% language = exercise.language %>
<% blocks   = Array(data["blocks"]) %>
<% if submitted %>
  <%# parse_order, not submitted_order: one corrupt id must not hide the blocks they did arrange. %>
  <% submitted_ids = ExerciseSection::ParsonsProblem.parse_order(response.answer_for(key)) %>
  <ol class="parsons-list parsons-list-readonly">
    <% Array.new(blocks.size) { |i| submitted_ids[i] }.each_with_index do |block_id, position| %>
      <li class="parsons-block <%= block_id == position ? "parsons-correct" : "parsons-misplaced" %>">
        <pre class="snippet"><% if ExerciseSection::ParsonsProblem.valid_id?(block_id, blocks.size) %><%= highlighted_code(blocks[block_id], language) %><% else %><%= highlighted_code(t("responses.answered.skipped"), nil) %><% end %></pre>
      </li>
    <% end %>
  </ol>
<% else %>
  <% initial_order = ExerciseSection::ParsonsProblem.initial_order(
       answer: response.answers[key],
       display_order: data["display_order"],
       block_count: blocks.size
     ) %>
  <div data-controller="parsons" data-action="keydown->parsons#keydown"
       data-parsons-prefix-value="<%= ExerciseSection::ParsonsProblem::ANSWER_PREFIX %>"
       data-parsons-moved-text-value="<%= t("responses.parsons.moved") %>"
       data-parsons-recorded-text-value="<%= t("responses.parsons.recorded") %>"
       data-parsons-move-up-text-value="<%= t("responses.parsons.move_up") %>"
       data-parsons-move-down-text-value="<%= t("responses.parsons.move_down") %>">
    <ol class="parsons-list" data-parsons-blocks data-parsons-target="list">
      <% initial_order.each do |block_id| %>
        <li class="parsons-block" data-parsons-target="block" data-block-id="<%= ExerciseSection::ParsonsProblem.block_token(block_id, exercise: exercise, key: key, section_data: data) %>" tabindex="0" aria-keyshortcuts="Control+ArrowUp Control+ArrowDown">
          <pre class="snippet"><%= highlighted_code(blocks[block_id], language) %></pre>
        </li>
      <% end %>
    </ol>
    <% if blocks.size == 1 %>
      <button type="button" class="btn btn-ghost btn-sm" data-action="parsons#confirm" data-parsons-confirm><%= t("responses.parsons.confirm_button") %></button>
    <% end %>
    <p class="parsons-keyhint"><%= t("responses.parsons.key_hint") %></p>
    <p class="parsons-status" aria-live="polite" data-parsons-target="status"></p>
    <textarea name="response[answers][<%= key %>]" class="<%= kind.answer_class %>" data-field="<%= key %>" data-draft-restore="off" data-parsons-target="field" style="display:none"><%= ExerciseSection::ParsonsProblem.token_answer(answer: response.answers[key], exercise: exercise, key: key, section_data: data) %></textarea>
  </div>
<% end %>
