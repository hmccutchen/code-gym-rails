<%# The answer area for parsons_problem, in both states. Unlike every other
    kind, the stored answer is a positional order rather than prose, so a
    submitted section replays the blocks in the order they were arranged —
    marking each correct or misplaced — instead of echoing "order:0,2,1".

    The hidden textarea stays a sibling of the <ol> inside .section: the script
    below finds it with list.parentElement.querySelector.

    Locals: kind, key, data, exercise, response, submitted. %>
<% language = exercise.language %>
<% blocks   = Array(data["blocks"]) %>
<% if submitted %>
  <%# parse_order, not submitted_order: grading rejects anything short of a
      complete permutation, but this is a replay of what they arranged, and
      showing every block as "(skipped)" because one id is corrupt hides work
      they did do. Strict at the boundary, lenient in the UI. %>
  <% submitted_ids = ExerciseSection::ParsonsProblem.parse_order(response.answer_for(key)) %>
  <ol class="parsons-list parsons-list-readonly">
    <% Array.new(blocks.size) { |i| submitted_ids[i] }.each_with_index do |block_id, position| %>
      <li class="parsons-block <%= block_id == position ? "parsons-correct" : "parsons-misplaced" %>">
        <pre class="snippet"><% if ExerciseSection::ParsonsProblem.valid_id?(block_id, blocks.size) %><%= highlighted_code(blocks[block_id], language) %><% else %><%= highlighted_code(t("responses.answered.skipped"), nil) %><% end %></pre>
      </li>
    <% end %>
  </ol>
<% else %>
  <%# The learner's own saved arrangement wins over the original scramble, so
      a reload doesn't undo their work. Each candidate is rejected unless it
      is a complete permutation of the blocks, so a corrupted answer or a row
      missing display_order falls back rather than dropping blocks. %>
  <% initial_order = ExerciseSection::ParsonsProblem.initial_order(
       answer: response.answers[key],
       display_order: data["display_order"],
       block_count: blocks.size
     ) %>
  <ol class="parsons-list" data-parsons-blocks>
    <% initial_order.each do |block_id| %>
      <li class="parsons-block" data-block-id="<%= ExerciseSection::ParsonsProblem.block_token(block_id, exercise: exercise, key: key) %>" tabindex="0" aria-keyshortcuts="Control+ArrowUp Control+ArrowDown">
        <pre class="snippet"><%= highlighted_code(blocks[block_id], language) %></pre>
      </li>
    <% end %>
  </ol>
  <%# Every move already records the order, and the scramble never starts in the
      correct order, so the button only matters when there is nothing to move:
      without it a one-block exercise could never be answered. %>
  <% if blocks.size == 1 %>
    <button type="button" class="btn btn-ghost btn-sm" data-parsons-confirm><%= t("responses.parsons.confirm_button") %></button>
  <% end %>
  <%# Dragging is pointer-only, so the arrow keys are the sole path for anyone
      not using a mouse. The hint is clipped until a block takes focus, which
      keeps it out of the way of the people who will never need it. %>
  <p class="parsons-keyhint"><%= t("responses.parsons.key_hint") %></p>
  <p class="parsons-status" aria-live="polite"></p>
  <textarea name="response[answers][<%= key %>]" class="<%= kind.answer_class %>" data-field="<%= key %>" data-answer-complete="<%= response.answered?(key) %>" style="display:none"><%= response.answers[key] %></textarea>
<% end %>
<% unless submitted || @parsons_script_emitted %>
  <% @parsons_script_emitted = true %>
  <% content_for :page_scripts do %>
    <script>
    // Drag (SortableJS, imported below) is the primary way to reorder. The
    // up/down buttons are a recovery path, injected only when that import
    // fails or never resolves. Neither path syncs the hidden field on wire-up
    // — only on a move or explicit confirmation — so the section reads as
    // unanswered until the learner does something, matching every other section.
    (() => {
      const MOVED     = <%= t("responses.parsons.moved").to_json.html_safe %>;
      const RECORDED  = <%= t("responses.parsons.recorded").to_json.html_safe %>;
      const MOVE_UP   = <%= t("responses.parsons.move_up").to_json.html_safe %>;
      const MOVE_DOWN = <%= t("responses.parsons.move_down").to_json.html_safe %>;

      function syncHiddenField(list) {
        const ids = [...list.querySelectorAll(".parsons-block")].map(li => li.dataset.blockId);
        const textarea = list.parentElement.querySelector('textarea[data-field="parsons_problem"]');
        textarea.value = "order:" + ids.join(",");
        textarea.dataset.answerComplete = String(ids.length > 0);
        textarea.dispatchEvent(new Event("input", { bubbles: true }));
      }

      function moveBlock(list, li, direction) {
        if (direction === "up") {
          const prev = li.previousElementSibling;
          if (!prev) return;
          list.insertBefore(li, prev);
        } else {
          const next = li.nextElementSibling;
          if (!next) return;
          list.insertBefore(next, li);
        }
        syncHiddenField(list);
        announce(list, li);
      }

      // Without this a keyboard or screen-reader user gets no confirmation that
      // a move landed — the visual reflow is the only feedback drag users need.
      function announce(list, li) {
        const status = list.parentElement.querySelector(".parsons-status");
        if (!status) return;
        const blocks = [ ...list.querySelectorAll(".parsons-block") ];
        status.textContent = MOVED.replace("%{position}", blocks.indexOf(li) + 1).replace("%{total}", blocks.length);
      }

      function handleKey(list, event) {
        const li = event.target.closest?.(".parsons-block");
        if (!li || !list.contains(li)) return;
        const direction = event.key === "ArrowUp" ? "up" : event.key === "ArrowDown" ? "down" : null;
        if (!direction) return;

        if (event.ctrlKey || event.metaKey) {
          event.preventDefault();
          moveBlock(list, li, direction);
          li.focus();
          return;
        }
        const sibling = direction === "up" ? li.previousElementSibling : li.nextElementSibling;
        if (sibling) {
          event.preventDefault();
          sibling.focus();
        }
      }

      function controlButton(list, li, direction) {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = `btn btn-ghost btn-sm parsons-move-${direction}`;
        btn.textContent = direction === "up" ? "↑" : "↓";
        btn.setAttribute("aria-label", direction === "up" ? MOVE_UP : MOVE_DOWN);
        btn.addEventListener("click", () => moveBlock(list, li, direction));
        return btn;
      }

      function addControls(list) {
        if (list.dataset.parsonsControls) return;
        list.dataset.parsonsControls = "1";
        list.querySelectorAll(".parsons-block").forEach(li => {
          const controls = document.createElement("div");
          controls.className = "parsons-controls";
          controls.append(controlButton(list, li, "up"), controlButton(list, li, "down"));
          li.appendChild(controls);
        });
      }

      document.querySelectorAll("ol[data-parsons-blocks]:not([data-parsons-wired])").forEach(list => {
        list.dataset.parsonsWired = "1";
        list.parsonsSync = () => syncHiddenField(list);
        list.parsonsAddControls = () => addControls(list);
        list.addEventListener("keydown", event => handleKey(list, event));
        list.parentElement.querySelector("[data-parsons-confirm]")?.addEventListener("click", () => {
          syncHiddenField(list);
          list.parentElement.querySelector(".parsons-status").textContent = RECORDED;
        });
        // A CDN that hangs rather than errors never rejects the import below,
        // so its catch never runs. Without this the section would stay
        // unanswerable for as long as the request is stalled.
        setTimeout(() => { if (!list.dataset.sortableDone) addControls(list); }, 3000);
      });
    })();
    </script>
    <script type="module">
      // Version pinned exactly, same posture as the Mermaid import in
      // shared/_mermaid_diagram — a blocked CDN falls back to the injected
      // up/down buttons above.
      try {
        const { default: Sortable } = await import("https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/modular/sortable.esm.js");
        document.querySelectorAll("ol[data-parsons-blocks]:not([data-sortable-done])").forEach(list => {
          list.dataset.sortableDone = "1";
          // delayOnTouchOnly: a touch drag needs a brief hold, so an ordinary
          // swipe still scrolls the page instead of picking up a block. With
          // the arrows gone this is the only input on a phone. Mouse dragging
          // is unaffected.
          Sortable.create(list, {
            animation: matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 150,
            delay: 150,
            delayOnTouchOnly: true,
            onEnd: () => list.parsonsSync?.()
          });
        });
      } catch {
        document.querySelectorAll("ol[data-parsons-blocks]").forEach(list => list.parsonsAddControls?.());
      }
    </script>
  <% end %>
<% end %>
