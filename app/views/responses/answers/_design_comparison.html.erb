<%# Locals: kind, key, data, exercise, response, submitted. %>
<% if submitted %>
  <% written = response.answer_for(key) || (response.answers[key] if response.partial_answer(key)) %>
  <% pick, reason = kind.parse_answer(written) %>
  <div class="answer-display"><% if pick %><strong><%= t("sections.design_comparison.picked", piece: pick.upcase) %></strong>
<%= reason %><% elsif reason.present? %><%= reason %><% else %><%= t("responses.answered.skipped") %><% end %></div><% if written && response.answer_for(key).nil? %><p class="answer-note"><%= t("responses.answered.not_counted") %></p><% end %>
  <% answer_key = data["answer_key"] %>
  <% if response.section_reviewed?(key) && answer_key.is_a?(Hash) %>
    <div class="comparison-key">
      <h3><%= t("sections.design_comparison.key_heading") %></h3>
      <p><strong><%= t("sections.design_comparison.key_better", piece: answer_key["better"].to_s.upcase) %></strong> <%= answer_key["deciding_fact"] %></p>
      <p><%= answer_key["principle"] %></p>
      <p><%= answer_key["why_other_fails"] %></p>
    </div>
  <% end %>
<% else %>
  <% pick, reason = kind.parse_answer(response.answers[key]) %>
  <div class="comparison-answer" data-comparison-answer="<%= key %>" data-controller="comparison-answer" data-action="answer-form:restored->comparison-answer#show"
       data-comparison-answer-prefix-value="<%= ExerciseSection::DesignComparison::PICK_PREFIX %>">
    <fieldset class="comparison-pick">
      <legend><%= t("sections.design_comparison.pick_legend") %></legend>
      <% ExerciseSection::DesignComparison::PIECES.each do |piece| %>
        <label>
          <input type="radio" name="comparison-pick-<%= key %>" value="<%= piece %>" <%= "checked" if pick == piece %>
                 data-comparison-answer-target="pick" data-action="change->comparison-answer#compose">
          <%= t("sections.design_comparison.piece", piece: piece.upcase) %>
        </label>
      <% end %>
    </fieldset>
    <label class="comparison-reason-label" for="comparison-reason-<%= key %>"><%= t("sections.design_comparison.reason_label") %></label>
    <textarea id="comparison-reason-<%= key %>" class="<%= kind.answer_class %>" data-comparison-reason
              data-comparison-answer-target="reason" data-action="input->comparison-answer#compose"
              maxlength="<%= ExerciseSection::DesignComparison::MAX_REASON_LENGTH %>"
              placeholder="<%= t("sections.#{key}.placeholder") %>"><%= reason %></textarea>
    <%# HTML drops the newline after the tag, as with Rails' text_area; without it a reason with no pick loses its "\n". %>
    <textarea name="response[answers][<%= key %>]" data-field="<%= key %>"
              data-comparison-answer-target="field" hidden><%= "\n" %><%= response.answers[key] %></textarea>
  </div>
<% end %>
