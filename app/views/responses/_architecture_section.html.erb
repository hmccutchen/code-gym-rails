<%# Architecture third section, shared by the dashboard form (submitted: false)
    and the read-only render of a submitted day (submitted: true), which appears
    on the dashboard after submitting and on every history entry.
    Locals: arch, response, submitted. %>
<div class="section">
  <div class="section-label">3 — Architecture Decision: <%= glossary_wrap(arch["title"]) %></div>
  <% if arch["scenario"].present? %><div class="section-scenario"><%= glossary_wrap(arch["scenario"]) %></div><% end %>
  <div class="question"><%= glossary_wrap(arch["question"]) %></div>
  <% if arch["options"].present? %>
    <ul class="arch-options">
      <% arch["options"].each do |opt| %><li><%= glossary_wrap(opt) %></li><% end %>
    </ul>
  <% end %>
  <% if arch["reference"].present? %>
    <details class="ref">
      <summary>Reference — <%= arch["title"] %>: tradeoffs</summary>
      <div class="ref-body">
        <p style="margin-bottom:.75rem"><strong><%= arch.dig("reference", "tagline") %></strong></p>
        <p style="margin-bottom:.75rem"><%= arch.dig("reference", "explanation") %></p>
        <% if arch.dig("reference", "tradeoffs").present? %>
          <ul><% arch.dig("reference", "tradeoffs").each do |t| %><li><%= t %></li><% end %></ul>
        <% end %>
        <p>🔭 <%= arch.dig("reference", "senior_lens") %></p>
        <%= render "shared/mermaid_diagram", source: arch.dig("reference", "diagram") %>
      </div>
    </details>
  <% end %>
  <% if (ref = concept_reference_for(arch["concept"], "architecture")) %>
    <%= render "shared/concept_reference", reference: ref,
          open: !submitted && first_exposure?(arch["concept"], "architecture", response.date) %>
  <% end %>
  <%= render "dashboard/teaching_hint", note: arch["teaching_note"], field: "architecture", submitted: submitted, response: response %>
  <% if submitted %>
    <div class="answer-display"><%= response.answers["architecture"].presence || "(skipped)" %></div>
  <% else %>
    <textarea name="response[answers][architecture]" class="answer" placeholder="Your decision and why — weigh the tradeoffs…" data-field="architecture" <%= tag.attributes(answer_scaffold_labels_attr(response, "architecture")) %>><%= answer_starting_value(response, "architecture") %></textarea>
    <div class="rating-row" data-rating-for="architecture">
      <% DailyResponse::SELF_RATING_LABELS.each do |value, label| %>
        <button type="button" class="rating-btn<%= " active" if response.self_rating_for("architecture") == value %>" data-rating-for="architecture" data-rating="<%= value %>"><%= label.upcase_first %></button>
      <% end %>
    </div>
    <%= render "shared/duck_thread", field: "architecture" %>
  <% end %>
</div>
