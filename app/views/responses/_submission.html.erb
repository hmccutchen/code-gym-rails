<%# Submitted badge, the day's self-rating, the on-demand review trigger, the AI
    review, and the email button. Rendered by the dashboard's submitted state
    only — the history page renders responses/_answered_sections plus its own
    review disclosure, never this partial. Review stays manual: the button only
    appears when unreviewed; nothing auto-triggers it. Local: response. %>
<div class="submit-row">
  <span class="submitted-badge">✓ Submitted</span>
  <% response.section_ratings.each do |section, value| %>
    <span class="history-pill"><%= section.humanize %>: <%= DailyResponse::SELF_RATING_LABELS[value] %></span>
  <% end %>
  <% unless response.reviewed? %>
    <%= button_to t("review.get_button", provider: response.user.provider_label),
          review_response_path(response), method: :post,
          class: "btn btn-primary btn-sm",
          form: { class: "review-form", data: { turbo: false } } %>
  <% end %>
</div>

<% if response.reviewed? %>
  <div class="review-section">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.75rem">
      <h3 style="font-size:1rem"><%= t("review.heading", provider: response.user.provider_label) %></h3>
      <%= button_to "Email me this review", email_review_response_path(response), method: :post, class: "btn btn-ghost btn-sm" %>
    </div>
    <%= render "shared/ai_review", response: response %>
  </div>
<% end %>

<script>
// The review call is synchronous — the request blocks for as long as the
// provider takes. Disable the button and swap its label so the wait reads as
// progress rather than a dead click. This partial renders once per page today,
// but the querySelectorAll + :not([data-review-wired]) guard stays: Turbo
// re-executes this inline script whenever it replaces #dashboard-content on a
// broadcast, and the guard stops a form that's already wired from being wired
// (and its listeners duplicated) again. Inline script, matching the gym-form
// convention; Stimulus is not wired in this app.
//
// button_to (with Rails 8's button_to_generates_button_tag default) renders a
// <button type="submit">, not an <input type="submit"> — the two need
// different properties for their label, so read/write whichever is present.
(() => {
  document.querySelectorAll("form.review-form:not([data-review-wired])").forEach(form => {
    form.dataset.reviewWired = "1";

    const button = form.querySelector('button[type="submit"], input[type="submit"]');
    if (!button) return;

    const isButtonTag = button.tagName === "BUTTON";
    const originalLabel = isButtonTag ? button.textContent : button.value;
    const setLabel = (text) => { if (isButtonTag) { button.textContent = text; } else { button.value = text; } };

    form.addEventListener("submit", () => {
      // Deferred a tick: disabling synchronously inside the submit handler can
      // cancel the submission in some browsers.
      setTimeout(() => { button.disabled = true; setLabel("Generating review…"); }, 0);
    });

    // A review that errors out redirects to root_path. If the user then
    // navigates Back, some browsers restore the page from bfcache exactly as
    // it was — button disabled, label swapped, data-review-wired already set —
    // and this script does not run again on its own, leaving the button dead
    // until a manual reload. Reset it on a bfcache restore.
    window.addEventListener("pageshow", (event) => {
      if (!event.persisted) return;
      button.disabled = false;
      setLabel(originalLabel);
    });
  });
})();
</script>
