<%# Local: response. Rendered only by the dashboard submitted state; history never renders it. %>
<div class="submit-row">
  <span class="submitted-badge"><%= t("responses.submission.submitted") %></span>
  <% response.section_ratings.each do |section, value| %>
    <span class="history-pill"><%= section.humanize %>: <%= DailyResponse.self_rating_labels[value] %></span>
  <% end %>
  <% unless response.fully_reviewed? %>
    <%= button_to response.reviewed? ? t("review.finish_button") : t("review.get_button", provider: response.user.provider_label),
          review_response_path(response), method: :post,
          class: "btn btn-primary btn-sm",
          form: { class: "review-form", data: { turbo: false } } %>
  <% end %>
</div>
<% if !response.fully_reviewed? && (failure = review_failure_sentence(response)) %>
  <p class="hint review-failure"><%= failure %></p>
<% end %>

<% if response.reviewed? %>
  <div class="review-section" id="ai-review">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.75rem">
      <h2 style="font-size:1rem"><%= t("review.heading", provider: response.review_provider_label) %></h2>
      <%= button_to t("responses.submission.email_button"), email_review_response_path(response), method: :post, class: "btn btn-ghost btn-sm" %>
    </div>
    <%= render "shared/ai_review", response: response %>
  </div>
<% end %>

<%# Design notes: docs/code-notes/app/views/responses/_submission.html.md %>
<script>
(() => {
  document.querySelectorAll("form.review-form:not([data-review-wired])").forEach(form => {
    form.dataset.reviewWired = "1";

    const button = form.querySelector('button[type="submit"], input[type="submit"]');
    if (!button) return;

    // button_to renders a <button>, not an <input>, and the two keep their label in different properties.
    const isButtonTag = button.tagName === "BUTTON";
    const originalLabel = isButtonTag ? button.textContent : button.value;
    const setLabel = (text) => { if (isButtonTag) { button.textContent = text; } else { button.value = text; } };

    form.addEventListener("submit", () => {
      // Disabling synchronously inside the submit handler can cancel the submission in some browsers.
      setTimeout(() => {
        button.disabled = true;
        button.classList.add("btn-loading");
        setLabel(<%= t("review.generating_label").to_json.html_safe %>);
      }, 0);
    });

    // A Back navigation can restore this page from bfcache with the button still disabled; reset it.
    window.addEventListener("pageshow", (event) => {
      if (!event.persisted) return;
      button.disabled = false;
      button.classList.remove("btn-loading");
      setLabel(originalLabel);
    });
  });
})();
</script>
