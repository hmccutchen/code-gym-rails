<%# Locals: kind, key, data, slot, exercise, response, submitted. %>
<% bucket = ConceptBucket.for(key, exercise.language) %>
<% label = capture do %>
  <% if kind.titled_label? %><%= t("responses.section.titled_label", slot: slot, name: t("sections.#{key}.name"), title: data["title"]) %><% else %><%= t("responses.section.label", slot: slot, name: t("sections.#{key}.name")) %><% end %>
<% end %>
<% if submitted %>
<div class="section">
  <div class="section-label"><%= label %></div>
<% else %>
<details class="section" open data-section-fold="<%= key %>">
  <%# No glossary terms in the summary (a control nested in a control), and never role="button": it erases the <h2>. %>
  <summary class="section-label"><h2 class="section-title"><%= label %></h2>
    <span class="section-status" data-status-for="<%= key %>"><%= section_status(response, key) %></span>
  </summary>
<% end %>
  <% if data["scenario"].present? %><div class="section-scenario"><%= glossary_wrap(data["scenario"]) %></div><% end %>
  <div class="question"><%= glossary_wrap(data["question"]) %></div>

  <%= render kind.body_partial, data: data, exercise: exercise, response: response, submitted: submitted %>
  <%= render "shared/mermaid_diagram", source: data["diagram"] %>

  <% if (ref = concept_reference_for(data["concept"], bucket)) %>
    <%= render "shared/concept_reference", reference: ref,
          open: !submitted && kind.reference_opens_before_answer? && first_exposure?(data["concept"], bucket, exercise.date) %>
  <% end %>

  <%= render "dashboard/teaching_hint", note: data["teaching_note"], field: key,
        submitted: submitted, response: response %>

  <%# The answer partial owns both states: a submitted Parsons replays its blocks rather than the stored "order:..." string. %>
  <%= render kind.answer_partial, kind: kind, key: key, data: data,
        exercise: exercise, response: response, submitted: submitted %>

  <% unless submitted %>
    <div class="rating-row" data-rating-for="<%= key %>" role="group"
         aria-label="<%= t("dashboard.rating_group", section: t("sections.#{key}.name")) %>">
      <% DailyResponse.self_rating_labels.each do |value, label| %>
        <% selected = response.self_rating_for(key) == value %>
        <button type="button" class="rating-btn<%= " active" if selected %>" aria-pressed="<%= selected %>"
                data-rating-for="<%= key %>" data-rating="<%= value %>"><%= label.upcase_first %></button>
      <% end %>
    </div>
    <%= render "shared/duck_thread", field: key %>
  <% end %>
<% if submitted %>
</div>
<% else %>
</details>
<% end %>
