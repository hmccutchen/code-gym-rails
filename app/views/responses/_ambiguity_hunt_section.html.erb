<%# Ambiguity Hunt fourth section, shared by the dashboard form (submitted: false)
    and the read-only render of a submitted day (submitted: true), which appears
    on the dashboard after submitting and on every history entry.
    Locals: ah, response, submitted.

    Deliberately never references ah["planted_ambiguities"] — that field is
    hidden test data for the review prompt only (see
    AiService#fourth_context_summary). Every field this partial DOES render is
    named explicitly, matching the closed-enumeration discipline every other
    section's partial already uses; there is no generic problem_set dump
    anywhere in this app to accidentally leak it through. %>
<div class="section">
  <div class="section-label">4 — Ambiguity Hunt: <%= glossary_wrap(ah["title"]) %></div>
  <% if ah["scenario"].present? %><div class="section-scenario"><%= glossary_wrap(ah["scenario"]) %></div><% end %>
  <div class="question"><%= glossary_wrap(ah["question"]) %></div>
  <div class="plan-excerpt"><%= glossary_wrap(ah["request"]) %></div>
  <% if (ref = concept_reference_for(ah["concept"], "ambiguity_hunt")) %>
    <%= render "shared/concept_reference", reference: ref,
          open: !submitted && first_exposure?(ah["concept"], "ambiguity_hunt", response.date) %>
  <% end %>
  <%= render "dashboard/teaching_hint", note: ah["teaching_note"], field: "ambiguity_hunt", submitted: submitted, response: response %>
  <% if submitted %>
    <div class="answer-display"><%= response.answers["ambiguity_hunt"].presence || "(skipped)" %></div>
  <% else %>
    <textarea name="response[answers][ambiguity_hunt]" class="answer" placeholder="What would you need clarified?" data-field="ambiguity_hunt"><%= response.answers["ambiguity_hunt"] %></textarea>
    <div class="rating-row" data-rating-for="ambiguity_hunt">
      <% DailyResponse::SELF_RATING_LABELS.each do |value, label| %>
        <button type="button" class="rating-btn<%= " active" if response.self_rating_for("ambiguity_hunt") == value %>" data-rating-for="ambiguity_hunt" data-rating="<%= value %>"><%= label.upcase_first %></button>
      <% end %>
    </div>
    <%= render "shared/duck_thread", field: "ambiguity_hunt" %>
  <% end %>
</div>
