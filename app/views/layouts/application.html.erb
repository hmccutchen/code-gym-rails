<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Code Gym</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #0f0f1a; --surface: #1a1a2e; --border: #2a2a4a;
      --accent: #7c6af7; --text: #e0e0f0; --muted: #888;
      --green: #4ade80; --red: #f87171; --yellow: #fbbf24;
    }
    body { background: var(--bg); color: var(--text); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; line-height: 1.6; }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }

    .container { max-width: 800px; margin: 0 auto; padding: 0 1.5rem; }

    nav { background: var(--surface); border-bottom: 1px solid var(--border); padding: .75rem 0; margin-bottom: 2rem; }
    nav .inner { display: flex; justify-content: space-between; align-items: center; }
    nav .brand { font-weight: 700; font-size: 1.1rem; color: var(--accent); }
    nav .nav-links { display: flex; gap: 1rem; font-size: .9rem; color: var(--muted); align-items: center; }

    .flash { padding: .75rem 1rem; border-radius: 6px; margin-bottom: 1.5rem; font-size: .9rem; }
    .flash.notice { background: rgba(74, 222, 128, .1); border: 1px solid var(--green); color: var(--green); }
    .flash.alert  { background: rgba(248, 113, 113, .1); border: 1px solid var(--red); color: var(--red); }

    .btn { display: inline-block; padding: .5rem 1.25rem; border-radius: 6px; font-size: .9rem; font-weight: 600; cursor: pointer; border: none; }
    .btn-primary { background: var(--accent); color: #fff; }
    .btn-primary:hover { background: #6a58e0; }
    .btn-ghost { background: transparent; color: var(--muted); border: 1px solid var(--border); }
    .btn-ghost:hover { border-color: var(--accent); color: var(--accent); }
    .btn-sm { padding: .3rem .8rem; font-size: .8rem; }
  </style>
</head>
<body>
  <nav>
    <div class="container inner">
      <span class="brand">⚡ Code Gym</span>
      <% if logged_in? %>
        <div class="nav-links">
          <span><%= current_user.name %></span>
          <%= button_to "Log out", logout_path, method: :delete, class: "btn btn-ghost btn-sm" %>
        </div>
      <% end %>
    </div>
  </nav>

  <div class="container">
    <% if flash[:notice] %>
      <div class="flash notice"><%= flash[:notice] %></div>
    <% end %>
    <% if flash[:alert] %>
      <div class="flash alert"><%= flash[:alert] %></div>
    <% end %>

    <%= yield %>
  </div>
</body>
</html>
