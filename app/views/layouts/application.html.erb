<!DOCTYPE html>
<html lang="en"<%= html_display_attributes %>>
<head>
  <meta charset="UTF-8">
  <%# Design notes: docs/code-notes/app/views/layouts/application.html.md %>
  <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content">
  <title><%= document_title %></title>
  <link rel="manifest" href="<%= pwa_manifest_path %>">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="<%= display_preferences.status_bar_style %>">
  <meta name="apple-mobile-web-app-title" content="<%= t("app_name") %>">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <% if display_stylesheets? %>
    <%= tag.meta(name: "theme-color", content: DisplayPreferences::LIGHT_THEME_COLOR,
                 media: display_preferences.light_palette_media, data: { light_palette_media: true }) %>
  <% end %>
  <meta name="theme-color" content="<%= DisplayPreferences::DARK_THEME_COLOR %>">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #0f0f1a; --surface: #1a1a2e; --border: #2a2a4a;
      --accent: #7c6af7; --text: #e0e0f0; --muted: #999;
      --accent-text: #988bf9;
      --button-bg: #6a57e8; --button-bg-hover: #5b48d9;
      --focus-ring: #c9c0ff; --focus-ring-width: 2px; --focus-ring-offset: 2px;
      --green: #4ade80; --red: #f87171; --yellow: #fbbf24;
      --code-bg: #0d0d1a; --code-symbol: #a78bfa; --code-builtin: #7dd3fc;
      --pattern-mask: url("<%= asset_path('gym-pattern-tile-dark.png') %>");
      --pattern-tint: rgb(190, 205, 240); --pattern-opacity: .08;
      /* iOS zooms a focused input below 16px; max() keeps that floor without overriding a larger default. */
      --input-font-size: max(1rem, 16px);
    }
    body { background: var(--bg); color: var(--text); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; line-height: 1.6; }
    #background-pattern {
      display: none; position: fixed; inset: 0; z-index: -2; pointer-events: none;
      background-color: var(--pattern-tint); opacity: var(--pattern-opacity);
      -webkit-mask-image: var(--pattern-mask); mask-image: var(--pattern-mask);
      -webkit-mask-size: 288px; mask-size: 288px;
      -webkit-mask-repeat: repeat; mask-repeat: repeat;
      image-rendering: pixelated;
    }
    @supports (mask-image: url("")) or (-webkit-mask-image: url("")) {
      #background-pattern { display: block; }
    }
    @media (prefers-contrast: more), (forced-colors: active) {
      #background-pattern { display: none; }
    }
    /* The app's one standalone-mode test; .nav-links in the selector outranks the later nav .name-editor rule. */
    @media (display-mode: standalone) {
      html, body { overscroll-behavior-y: none; }
      body { -webkit-tap-highlight-color: transparent; }
      nav .nav-links .name-editor { display: none; }
      body .pull-refresh { display: flex; }
    }
    a { color: var(--accent-text); text-decoration: none; }
    a:hover { text-decoration: underline; }

    input:not([type="checkbox"], [type="radio"], [type="range"]):focus-visible,
    textarea:focus-visible, select:focus-visible,
    .parsons-block:focus-visible, .gloss-term:focus-visible {
      outline: var(--focus-ring-width) solid var(--focus-ring); outline-offset: var(--focus-ring-offset);
    }
    input[type="range"]:focus-visible::-webkit-slider-thumb { outline: var(--focus-ring-width) solid var(--focus-ring); outline-offset: var(--focus-ring-offset); }
    input[type="range"]:focus-visible::-moz-range-thumb { outline: var(--focus-ring-width) solid var(--focus-ring); outline-offset: var(--focus-ring-offset); }
    input[type="range"]:focus-visible { outline: none; }

    .container { max-width: 800px; margin: 0 auto; padding: 0 1.5rem; }

    nav { position: relative; z-index: 20; container-type: inline-size; background: var(--surface); border-bottom: 1px solid var(--border); padding: .75rem 0; margin-bottom: 2rem; }
    nav .inner { display: flex; justify-content: space-between; align-items: center; max-width: 1200px; }
    nav .brand { display: flex; align-items: center; gap: .5rem; font-weight: 700; font-size: 2rem; color: var(--accent-text); white-space: nowrap; flex-shrink: 0; }
    nav .brand:hover { text-decoration: none; }
    nav .brand-mark { height: 5rem; width: 7rem; }
    nav .nav-links { display: flex; gap: 1rem; font-size: .9rem; color: var(--muted); align-items: center; min-width: 0; }
    nav .name-editor { display: flex; align-items: center; min-width: 0; }
    nav .nav-toggle { display: none; }

    @container (max-width: 37.5em) {
      nav .nav-toggle {
        display: flex; flex-direction: column; justify-content: center; gap: 4px;
        width: 44px; height: 44px; padding: 0 11px; flex-shrink: 0;
        background: transparent; border: 1px solid var(--border); border-radius: 6px; cursor: pointer;
      }
      nav .nav-toggle .bar { height: 2px; background: var(--muted); border-radius: 1px; }
      nav .inner { gap: .5rem; }
      nav .brand { flex-shrink: 1; min-width: 0; }
      nav .brand > picture { min-width: 0; }
      nav .brand .brand-mark { min-width: 0; max-width: 100%; object-fit: contain; }
      nav .nav-links { display: none; }
      nav .nav-links[data-open] {
        display: flex; flex-direction: column; align-items: stretch; gap: .25rem;
        position: absolute; top: 100%; left: 0; right: 0; z-index: 20;
        background: var(--surface); border-bottom: 1px solid var(--border);
        padding: .5rem 1.5rem 1rem;
      }
      nav .nav-links[data-open] a { padding: .75rem 0; }
      nav .nav-links[data-open] .name-editor-input { width: 100%; }
    }

    .flash { padding: .75rem 1rem; border-radius: 6px; margin-bottom: 1.5rem; font-size: .9rem; }
    .flash.notice { background: rgba(74, 222, 128, .1); border: 1px solid var(--green); color: var(--green); }
    .flash.alert  { background: rgba(248, 113, 113, .1); border: 1px solid var(--red); color: var(--red); }

    .btn { display: inline-block; padding: .5rem 1.25rem; border-radius: 6px; font-size: .9rem; font-weight: 600; cursor: pointer; border: none; }
    .btn:disabled { opacity: .4; cursor: not-allowed; }
    .btn-primary { background: var(--button-bg); color: #fff; }
    .btn-primary:hover { background: var(--button-bg-hover); }
    .btn-ghost { background: transparent; color: var(--muted); border: 1px solid var(--border); }
    .btn-ghost:hover { border-color: var(--accent); color: var(--accent-text); }
    .btn-sm { padding: .3rem .8rem; font-size: .8rem; }
    .btn-loading { opacity: .6; pointer-events: none; }
    .btn-loading::before {
      content: ""; display: inline-block; width: .8em; height: .8em;
      margin-right: .5em; vertical-align: -.1em;
      border: 2px solid currentColor; border-top-color: transparent;
      border-radius: 50%; animation: spin .7s linear infinite;
    }
    .spinner {
      display: inline-block; width: 2rem; height: 2rem;
      border: 3px solid var(--border); border-top-color: var(--accent);
      border-radius: 50%; animation: spin .7s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    .pull-refresh {
      display: none; position: fixed; top: 0; left: 50%; z-index: -1;
      width: 2rem; height: 2rem; margin-left: -1rem;
      align-items: center; justify-content: center; pointer-events: none;
      opacity: 0;
    }
    .pull-refresh .spinner {
      width: 1.75rem; height: 1.75rem; border-width: 3px; animation: none; opacity: .6;
      border-color: color-mix(in srgb, var(--accent) 30%, transparent);
      border-top-color: var(--accent); border-right-color: var(--accent);
    }
    .pull-refresh.is-ready .spinner, .pull-refresh.is-refreshing .spinner { opacity: 1; }
    .pull-refresh.is-refreshing .spinner { animation: spin .7s linear infinite; }
    .pull-refresh.is-settling, .pull-settling { transition: transform .3s cubic-bezier(.2, .8, .2, 1), opacity .3s ease; }

    @media (prefers-reduced-motion: reduce) {
      .spinner, .btn-loading::before, .pull-refresh.is-refreshing .spinner { animation: none; }
      .pull-refresh.is-settling, .pull-settling { transition: none; }
    }

    code, kbd, samp, pre { font-family: monospace, monospace; }
    pre.snippet, .pseudocode-code pre { white-space: pre-wrap; overflow-wrap: anywhere; -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
    pre.snippet { background: var(--code-bg); border: 1px solid var(--border); border-radius: 6px; padding: 1rem; font-size: .85rem; margin-bottom: 1.25rem; }
    code.highlight .code-line { display: block; padding-left: calc((var(--indent, 0) + 2) * 1ch); text-indent: calc((var(--indent, 0) + 2) * -1ch); }
    code.highlight[data-wraps] .code-align-extra { font-size: 0; }
    .plan-excerpt { background: var(--code-bg); border-left: 3px solid var(--accent); border-radius: 0 6px 6px 0; padding: .85rem 1rem; font-size: .9rem; margin-bottom: 1.25rem; white-space: pre-wrap; overflow-wrap: anywhere; color: var(--text); }
    .problem-statement { background: var(--code-bg); border-left: 3px solid var(--accent); border-radius: 0 6px 6px 0; padding: .85rem 1rem; font-size: .9rem; margin-bottom: 1.25rem; white-space: pre-wrap; overflow-wrap: anywhere; color: var(--text); }
    .pseudocode-rounds { margin-top: .75rem; }
    .pseudocode-controls { display: flex; gap: .5rem; align-items: center; flex-wrap: wrap; }
    .pseudocode-status { font-size: .8rem; color: var(--muted); }
    .pseudocode-critique-label { font-size: .85rem; color: var(--muted); margin: .6rem 0 .2rem; }
    .pseudocode-critique ul { margin: 0 0 .4rem 1.1rem; font-size: .9rem; }
    .pseudocode-critique li { margin-bottom: .25rem; }
    .pseudocode-code pre { background: var(--code-bg); border: 1px solid var(--border); border-radius: 6px; padding: .75rem; font-size: .85rem; margin: .6rem 0 .2rem; }
    .pseudocode-caption { font-size: .8rem; color: var(--muted); margin-bottom: .4rem; }
    code.highlight { color: var(--text); }
    code.highlight :is(.k, .kd, .kn, .kp, .kr, .kt, .kv, .ow, .nc, .nf, .nn) { color: var(--accent-text); }
    code.highlight :is(.s, .s1, .s2, .sa, .sb, .sc, .sd, .se, .sh, .si, .sr, .sx, .dl) { color: var(--green); }
    code.highlight :is(.c, .c1, .cm, .cs, .cp, .ch, .cpf) { color: var(--muted); font-style: italic; }
    code.highlight :is(.m, .mb, .mf, .mh, .mi, .il, .mo, .mx, .kc) { color: var(--yellow); }
    code.highlight :is(.ss, .na, .vi, .vc, .vg) { color: var(--code-symbol); }
    code.highlight :is(.nb, .bp, .no, .nt) { color: var(--code-builtin); }
    .review-block { background: rgba(124,106,247,.06); border: 1px solid var(--border); border-radius: 6px; padding: 1rem; margin-top: .75rem; }
    .review-block h3 { color: var(--accent-text); font-size: .85rem; text-transform: uppercase; letter-spacing: .06em; margin-bottom: .5rem; }
    .review-rating { display: inline-block; background: rgba(124,106,247,.15); border-radius: 4px; padding: .1rem .5rem; font-size: .75rem; margin-left: .5rem; text-transform: none; letter-spacing: 0; }
    .difficulty-note { font-size: .8rem; line-height: 1.6; color: var(--muted); margin-top: .3rem; }
    .review-item { font-size: .9rem; line-height: 1.7; margin-top: .4rem; }
    .review-points { margin: .3rem 0 0 1.1rem; padding: 0; }
    .review-points li { font-size: .9rem; line-height: 1.6; margin-top: .3rem; }
    .alternates { margin-top: .75rem; }
    .alternate-item { font-size: .9rem; line-height: 1.7; border-left: 2px solid var(--accent); padding-left: .6rem; margin-bottom: .5rem; }
    .alternate-status { font-size: .75rem; color: var(--muted); margin-left: .5rem; }
    .concept-alternates { margin-top: .9rem; }
    .follow-ups { margin-top: .9rem; border-top: 1px solid var(--border); padding-top: .75rem; }
    .follow-up-turn { font-size: .88rem; line-height: 1.65; margin-bottom: .5rem; padding-left: .6rem; border-left: 2px solid var(--border); }
    .follow-up-user { color: var(--muted); }
    .follow-up-assistant { border-left-color: var(--accent); }
    .follow-up-form { display: flex; gap: .5rem; flex-wrap: wrap; }
    .follow-up-input { flex: 1; min-width: 0; background: var(--bg); color: inherit; border: 1px solid var(--border); border-radius: 6px; padding: .45rem .6rem; font-size: var(--input-font-size); font-family: inherit; }
    .follow-up-capped { font-size: .78rem; color: var(--muted); font-style: italic; }
    .follow-up-status { font-size: .75rem; color: var(--muted); }

    .duck-thread { margin-top: .9rem; border-top: 1px solid var(--border); padding-top: .75rem; }
    .duck-body { margin-top: .6rem; }
    .duck-turns { margin-bottom: .5rem; }
    .duck-turn { font-size: .88rem; line-height: 1.65; margin-bottom: .5rem; padding-left: .6rem; border-left: 2px solid var(--border); }
    .duck-user { color: var(--muted); }
    .duck-assistant { border-left-color: var(--accent); }
    .duck-form { display: flex; gap: .5rem; flex-wrap: wrap; }
    .duck-input { flex: 1 1 12rem; min-width: 0; background: var(--bg); color: inherit; border: 1px solid var(--border); border-radius: 6px; padding: .45rem .6rem; font-size: var(--input-font-size); font-family: inherit; }
    .duck-status { display: block; font-size: .75rem; color: var(--muted); margin-top: .4rem; }
    .skip-link { position: fixed; top: .5rem; left: .5rem; z-index: 30; padding: .6rem 1rem; background: var(--surface); color: var(--accent-text); border: 1px solid var(--accent); border-radius: 6px; transform: translateY(-200%); }
    .skip-link:focus { transform: none; }
    #main-content:focus { outline: none; }
    .visually-hidden { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; border: 0; }

    .section { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 1.5rem; margin-bottom: 1.5rem; }
    .section-label { font-size: .75rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--accent-text); margin-bottom: .95rem; }
    details.section > summary { cursor: pointer; list-style: none; display: flex; align-items: baseline; gap: .6rem; flex-wrap: wrap; }
    details.section > summary::-webkit-details-marker { display: none; }
    details.section > summary::before { content: "▼ "; }
    details.section:not([open]) > summary::before { content: "▶ "; }
    details.section:not([open]) > summary { margin-bottom: 0; }
    details.section > summary { padding-block: 12.5px; margin-top: -12.5px; margin-bottom: calc(.95rem - 12.5px); }
    details.section:not([open]) > summary { margin-bottom: -12.5px; }
    .section-label .section-title { font: inherit; letter-spacing: inherit; margin: 0; }
    .section-status { font-weight: 600; letter-spacing: 0; text-transform: none; color: var(--muted); margin-left: auto; }
    .section h2 { font-size: 1.1rem; margin-bottom: .75rem; }
    .section-scenario { font-size: .95rem; color: var(--muted); margin-bottom: .75rem; }
    .question { font-size: 1rem; line-height: 1.7; margin-bottom: 1.25rem; }
    .why-box { background: rgba(124,106,247,.08); border-left: 3px solid var(--accent); padding: .6rem .9rem; font-size: .9rem; color: var(--muted); border-radius: 0 6px 6px 0; margin-bottom: 1rem; }
    .arch-options { margin: 0 0 1.25rem 1.25rem; font-size: .95rem; line-height: 1.8; }

    /* The -1.5rem tracks .container's padding and must change with it. */
    @media (max-width: 600px) {
      .section {
        margin-inline: -1.5rem;
        padding: 1.25rem 1rem;
        border-radius: 0;
        border-left: none;
        border-right: none;
      }
    }

    .parsons-list { list-style: none; margin: 0 0 1.25rem; padding: 0; }
    .parsons-block { display: flex; align-items: flex-start; gap: .5rem; margin-bottom: .4rem; }
    .parsons-block pre.snippet { flex: 1; margin: 0; padding: .55rem .75rem; }
    .parsons-controls { display: flex; flex-direction: column; gap: .2rem; }
    .parsons-keyhint, .parsons-status { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .parsons-list:focus-within + .parsons-keyhint { position: static; width: auto; height: auto; clip-path: none; font-size: .8rem; color: var(--muted); margin: -.75rem 0 1rem; }
    .parsons-list:not(.parsons-list-readonly) .parsons-block { cursor: grab; }
    .parsons-correct pre.snippet { border-color: #2f7d5a; }
    .parsons-misplaced pre.snippet { border-color: #a4453f; }

    details.comparison-piece { margin-bottom: .75rem; }
    details.comparison-piece > summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; font-size: .9rem; font-weight: 600; }
    .comparison-pick { border: none; padding: 0; margin: 0 0 .75rem; }
    .comparison-pick legend { font-size: .95rem; margin-bottom: .4rem; }
    .comparison-pick label { display: flex; align-items: center; gap: .5rem; min-height: 44px; }
    .comparison-reason-label { display: block; font-size: .95rem; margin-bottom: .4rem; }
    .comparison-key { margin-top: 1rem; font-size: .92rem; line-height: 1.6; }
    .comparison-key h3 { font-size: .95rem; margin-bottom: .4rem; }
    .comparison-key p { margin-bottom: .4rem; }

    details.ref { margin-bottom: 1rem; }
    details.ref summary { cursor: pointer; font-size: .85rem; color: var(--accent-text); padding: .4rem 0; list-style: none; }
    details.ref summary::before { content: "▶ "; }
    details.ref[open] summary::before { content: "▼ "; }
    .ref-body { background: var(--code-bg); border: 1px solid var(--border); border-radius: 6px; padding: 1rem; margin-top: .5rem; font-size: .88rem; line-height: 1.7; }
    .mermaid-diagram:empty { display: none; }
    .mermaid-diagram { margin-top: .9rem; overflow-x: auto; background: var(--bg); border: 1px solid var(--border); border-radius: 6px; padding: .75rem; }
    .mermaid-diagram svg { max-width: 100%; height: auto; }

    details.hint { margin-bottom: 1rem; }
    details.hint summary { cursor: pointer; font-size: .85rem; color: var(--accent-text); padding: .4rem 0; list-style: none; }
    details.hint summary::before { content: "▶ "; }
    details.hint[open] summary::before { content: "▼ "; }
    .hint-locked { font-size: .85rem; color: var(--muted); padding: .4rem 0; margin-bottom: 1rem; }
    .hint-body { background: rgba(124,106,247,.08); border-left: 3px solid var(--accent); padding: .6rem .9rem; font-size: .9rem; border-radius: 0 6px 6px 0; margin-top: .5rem; line-height: 1.6; }

    .gloss-term { border-bottom: 1px dotted var(--muted); cursor: help; position: relative; }
    .gloss-term::after {
      content: attr(data-definition);
      position: absolute; left: 0; bottom: 100%; margin-bottom: .35rem;
      width: max-content; max-width: 16rem;
      background: var(--code-bg); border: 1px solid var(--border); border-radius: 6px;
      padding: .5rem .65rem; font-size: .8rem; line-height: 1.5; color: var(--text);
      white-space: normal; z-index: 10;
      display: none;
    }
    @media (max-width: 600px) {
      .gloss-term::after {
        left: var(--gloss-shift, 0);
        width: var(--gloss-width, max-content);
        max-width: var(--gloss-width, 16rem);
      }
    }
    @media (hover: hover) and (pointer: fine) {
      .gloss-term:hover::after { display: block; }
    }
    .gloss-term.gloss-open::after, .gloss-term:focus-visible::after { display: block; }

    .submit-row { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; margin-top: 1.5rem; }
    .submitted-badge { display: inline-block; background: rgba(74,222,128,.1); color: var(--green); border: 1px solid var(--green); border-radius: 4px; padding: .2rem .6rem; font-size: .8rem; font-weight: 600; }
    .answer-display { background: var(--code-bg); border: 1px solid var(--border); border-radius: 6px; padding: .75rem; font-size: .9rem; white-space: pre-wrap; overflow-wrap: anywhere; }
    .review-section { margin-top: 1.5rem; }
    .history-pill { border: 1px solid var(--border); border-radius: 4px; padding: .15rem .5rem; font-size: .85rem; color: var(--muted); }

    .name-editor-input {
      background: transparent;
      border: 1px solid transparent;
      color: var(--text);
      font-size: var(--input-font-size);
      font-family: inherit;
      padding: .15rem .3rem;
      width: 9rem;
      min-width: 0;
      border-radius: 6px;
    }
    .name-editor-input:focus {
      background: rgba(124, 106, 247, .06);
      border-color: var(--border);
    }
    .name-editor-status { font-size: .75rem; color: var(--muted); margin-left: .4rem; }

    .learn-filter { display: flex; gap: 1rem; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; }
    .learn-filter input[type="search"] { flex: 1 1 16rem; padding: .5rem; border: 1px solid var(--border); border-radius: 4px; }
    .learn-bucket { margin-bottom: 2rem; }
    .learn-group { font-size: .95rem; color: var(--muted); margin: 1rem 0 .5rem; }
    .learn-list { list-style: none; padding: 0; }
    .learn-group-block { margin-bottom: 1rem; }
    .learn-entry { padding: .35rem 0; display: flex; gap: .6rem; align-items: baseline; flex-wrap: wrap; }
    .learn-entry[hidden] { display: none; }
    .learn-seen { font-size: .75rem; color: var(--muted); border: 1px solid var(--border); border-radius: 999px; padding: 0 .5rem; }
    .learn-ungenerated { font-size: .75rem; color: var(--muted); }
    .learn-back { display: inline-block; padding-block: 4px; }
    .learn-intro, .learn-bucket-label, .learn-no-guide, .learn-empty { color: var(--muted); }
    .learn-status { font-size: .75rem; color: var(--muted); margin-left: .5rem; }
    .learn-prepare { border: 1px solid var(--border); border-radius: 6px; padding: 1rem; margin-bottom: 1.5rem; }
    .learn-drilling { font-size: .75rem; color: var(--accent-text); border: 1px solid var(--accent); border-radius: 999px; padding: 0 .5rem; }
    .progress-legend { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; font-size: .85rem; color: var(--muted); margin: 1rem 0 1.5rem; }
    .progress-legend dt { display: inline; font-weight: 600; color: var(--text); }
    .progress-legend dd { display: inline; margin: 0 0 0 .3rem; }
    .progress-note { font-size: .8rem; color: var(--muted); margin-bottom: 1.5rem; }
    details.progress-group { border: 1px solid var(--border); border-radius: 6px; padding: .6rem .9rem; margin-bottom: .6rem; }
    details.progress-group summary { cursor: pointer; list-style: none; display: flex; align-items: center; gap: .8rem; flex-wrap: wrap; }
    details.progress-group summary::-webkit-details-marker { display: none; }
    details.progress-group summary::before { content: "▶"; color: var(--accent-text); font-size: .8rem; }
    details.progress-group[open] summary::before { content: "▼"; }
    .progress-group-name { font-weight: 600; min-width: 9rem; }
    .rung-principal_engineer, .rung-developing_principal_engineer { --rung: #7c6af7; }
    .rung-senior, .rung-developing_senior { --rung: #4ade80; }
    .rung-junior, .rung-developing_junior { --rung: #86efac; }
    .rung-not_yet, .rung-not_offered { --rung: transparent; }
    .rung-bar { display: flex; flex: 1 1 8rem; height: .55rem; border-radius: 999px; overflow: hidden; background: var(--border); }
    .rung-bar span { display: block; height: 100%; background: var(--rung); }
    .rung-bar span[class^="rung-developing"] { background: repeating-linear-gradient(135deg, var(--rung) 0 3px, transparent 3px 6px); }
    .progress-counts { font-size: .8rem; color: var(--muted); }
    .progress-list { list-style: none; margin: .8rem 0 .2rem; padding: 0; }
    .progress-entry { display: flex; flex-wrap: wrap; align-items: baseline; gap: .6rem; padding: .25rem 0; }
    .progress-rungs { display: inline-flex; gap: .2rem; }
    .progress-rung { width: .5rem; height: .5rem; border-radius: 999px; border: 1px solid var(--muted); }
    .progress-rung.held { background: var(--rung); border-color: var(--rung); }
    .progress-rung.toward { border-color: var(--rung); background: linear-gradient(90deg, var(--rung) 50%, transparent 50%); }
    .progress-word { font-size: .8rem; color: var(--muted); margin-left: auto; }
    .learn-drill, .learn-drills { border: 1px solid var(--border); border-radius: 6px; padding: 1rem; margin: 1.5rem 0; }
    .learn-drills form, .learn-group-head form { display: inline-block; margin-right: .5rem; }
    .learn-drill-paused { color: var(--accent-text); }
    .learn-group-head { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
    .learn-group-head h3 { margin: 0; }
    .learn-worked-example { white-space: pre-wrap; overflow-wrap: anywhere; }
    .learn-lesson { margin: .75rem 0 1rem; }
    .learn-lesson p { margin-bottom: .75rem; }
    .learn-lesson ul { padding-left: 1.25rem; margin: 0 0 .75rem; }
    .learn-lesson li { margin-bottom: .4rem; }
    .learn-recognition { border: 1px solid var(--border); border-radius: 6px; padding: .5rem 1rem; margin: .5rem 0 1rem; }
    .learn-recognition summary { cursor: pointer; color: var(--muted); }
    .learn-recognition-label { font-size: .85rem; font-weight: 600; margin: .75rem 0 .25rem; }

    .featured-concept { background: var(--surface); border: 1px solid var(--accent); border-radius: 10px; padding: 1.25rem; margin-bottom: 1.5rem; }
    .featured-label { font-size: .75rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--accent-text); margin-bottom: .5rem; }
    .featured-title { font-size: 1.25rem; margin-bottom: .25rem; }
    .featured-bucket, .featured-tagline { color: var(--muted); font-size: .9rem; }
    .featured-tagline { margin-top: .5rem; }
    .featured-compact { margin-top: 2rem; }
    .featured-compact .featured-concept { padding: .9rem 1rem; margin-bottom: 0; }
    .featured-compact .featured-title { font-size: 1rem; }
    .save-status { position: fixed; left: 50%; bottom: 1.25rem; transform: translateX(-50%);
                   z-index: 50; max-width: min(90vw, 32rem); margin: 0; padding: .7rem 1rem;
                   background: var(--surface); border: 1px solid #a33; border-left: 3px solid #a33;
                   border-radius: 6px; color: var(--text); font-size: .85rem;
                   box-shadow: 0 4px 16px rgba(0, 0, 0, .4); }
  </style>
  <% if display_stylesheets? %>
    <%= stylesheet_link_tag "display" %>
    <%= stylesheet_link_tag "display_light", media: display_preferences.light_palette_media, data: { light_palette_media: true } %>
  <% end %>
</head>
<body>
  <% if display_preferences["background_pattern"] == "on" %>
    <div id="background-pattern" aria-hidden="true"></div>
  <% end %>
  <% if logged_in? %>
  <a class="skip-link" href="#main-content"><%= t("nav.skip_to_content") %></a>
  <nav>
    <div class="container inner">
      <%= link_to root_path, class: "brand" do %><%= brand_mark %><span aria-hidden="true"><%= t("app_name") %></span><% end %>
      <button type="button" class="nav-toggle" id="nav-toggle"
              aria-expanded="false" aria-controls="nav-links"
              aria-label="<%= t("nav.menu") %>">
        <span class="bar" aria-hidden="true"></span><span class="bar" aria-hidden="true"></span><span class="bar" aria-hidden="true"></span>
      </button>
      <div class="nav-links" id="nav-links">
        <span class="name-editor">
          <input type="text"
                 id="nav-name-input"
                 class="name-editor-input"
                 value="<%= current_user.name %>"
                 aria-label="<%= t("profile.name.aria_label") %>">
          <span id="nav-name-status" class="name-editor-status" aria-live="polite"></span>
        </span>
        <script>
          (function () {
            const input  = document.getElementById("nav-name-input");
            const status = document.getElementById("nav-name-status");
            if (!input) return;

            let lastSaved = input.value;
            const savedText = "<%= j t("profile.name.saved") %>";
            const errorText = "<%= j t("profile.name.error") %>";
            let statusTimer;

            function flash(message) {
              status.textContent = message;
              clearTimeout(statusTimer);
              statusTimer = setTimeout(() => { status.textContent = ""; }, 2000);
            }

            input.addEventListener("blur", async () => {
              const name = input.value.trim();
              if (name === lastSaved) return;
              if (name === "") { input.value = lastSaved; return; }

              try {
                const response = await fetch("<%= profile_path %>", {
                  method: "PATCH",
                  headers: {
                    "Content-Type": "application/json",
                    "Accept": "application/json",
                    "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content
                  },
                  body: JSON.stringify({ user: { name } })
                });

                if (response.ok) {
                  const data = await response.json();
                  input.value = data.name;
                  lastSaved = data.name;
                  flash(savedText);
                } else {
                  input.value = lastSaved;
                  flash(errorText);
                }
              } catch {
                input.value = lastSaved;
                flash(errorText);
              }
            });
          })();
        </script>
        <% if current_user.time_zone.blank? %>
          <script>
            (function () {
              const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
              if (!tz) return;
              fetch("<%= profile_path %>", {
                method: "PATCH",
                headers: {
                  "Content-Type": "application/json",
                  "Accept": "application/json",
                  "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content
                },
                body: JSON.stringify({ user: { time_zone: tz } })
              });
            })();
          </script>
        <% end %>
        <%= link_to t("learn.title"), learn_path %>
        <%= link_to t("progress.title"), progress_path %>
        <%= link_to t("nav.history"), history_path %>
        <%= link_to t("nav.account"), account_path %>
      </div>
      <script>
        (function () {
          const toggle = document.getElementById("nav-toggle");
          const links  = document.getElementById("nav-links");
          if (!toggle || !links) return;

          function closeMenu() {
            links.removeAttribute("data-open");
            toggle.setAttribute("aria-expanded", "false");
          }

          toggle.addEventListener("click", (event) => {
            event.stopPropagation();
            if (links.hasAttribute("data-open")) { closeMenu(); return; }
            links.setAttribute("data-open", "");
            toggle.setAttribute("aria-expanded", "true");
          });

          document.addEventListener("click", (event) => {
            if (!links.hasAttribute("data-open")) return;
            if (links.contains(event.target)) return;
            closeMenu();
          });

          document.addEventListener("keydown", (event) => {
            if (event.key !== "Escape") return;
            if (!links.hasAttribute("data-open")) return;
            closeMenu();
            toggle.focus();
          });
        })();
      </script>
    </div>
  </nav>
  <% end %>

  <div class="container" data-pull-content>
    <main id="main-content" tabindex="-1">
    <% if flash[:notice] %>
      <div class="flash notice" id="flash-notice"><%= flash[:notice] %></div>
    <% end %>
    <% if flash[:alert] %>
      <div class="flash alert" id="flash-alert"><%= flash[:alert] %></div>
    <% end %>

    <%= yield %>
    </main>
  </div>
  <script>
    (() => {
      document.querySelectorAll("form[data-loading-form]").forEach(form => {
        const button = form.querySelector('button[type="submit"], input[type="submit"]');
        if (!button) return;

        const isButtonTag = button.tagName === "BUTTON";
        const originalLabel = isButtonTag ? button.textContent : button.value;
        const setLabel = (text) => { if (isButtonTag) { button.textContent = text; } else { button.value = text; } };

        form.addEventListener("submit", (event) => {
          const message = form.dataset.confirmMessage;
          if (message && !window.confirm(message)) { event.preventDefault(); return; }

          // Deferred a tick: disabling synchronously inside the submit handler can cancel the submission.
          setTimeout(() => {
            button.disabled = true;
            button.classList.add("btn-loading");
            if (form.dataset.loadingLabel) setLabel(form.dataset.loadingLabel);
          }, 0);
        });

        window.addEventListener("pageshow", (event) => {
          if (!event.persisted) return;
          button.disabled = false;
          button.classList.remove("btn-loading");
          setLabel(originalLabel);
        });
      });
    })();
  </script>
  <script>
    (() => {
      const positionPanel = (term) => {
        const box = term.closest(".section, .container");
        if (!box) return;
        const rect = box.getBoundingClientRect();
        const pad = parseFloat(getComputedStyle(box).paddingLeft) || 0;
        term.style.setProperty("--gloss-width", `${rect.width - pad * 2}px`);
        term.style.setProperty("--gloss-shift", `${rect.left + pad - term.getBoundingClientRect().left}px`);
      };

      const toggleTerm = (term) => {
        document.querySelectorAll(".gloss-term.gloss-open").forEach((el) => {
          if (el !== term) el.classList.remove("gloss-open");
        });
        if (term && term.classList.toggle("gloss-open")) positionPanel(term);
      };

      document.addEventListener("click", (event) => {
        toggleTerm(event.target.closest(".gloss-term"));
      });

      document.addEventListener("keydown", (event) => {
        if (event.key !== "Enter" && event.key !== " ") return;
        const term = event.target.closest(".gloss-term");
        if (!term) return;
        event.preventDefault();
        toggleTerm(term);
      });

      const positionFromEvent = (event) => {
        const term = event.target.closest && event.target.closest(".gloss-term");
        if (term) positionPanel(term);
      };
      document.addEventListener("focusin", positionFromEvent);
      document.addEventListener("pointerover", positionFromEvent);

      window.addEventListener("resize", () => {
        const open = document.querySelector(".gloss-term.gloss-open");
        if (open) positionPanel(open);
      });
    })();
  </script>
  <%= render "shared/server_message" if logged_in? %>
  <%= render "shared/push_script" if logged_in? && WebPushCredentials.configured? %>
  <%= render "shared/save_status" if logged_in? %>
  <%= render "shared/pull_to_refresh" %>
  <%= render "shared/code_lines_script" %>
  <%= yield :page_scripts %>
</body>
</html>
