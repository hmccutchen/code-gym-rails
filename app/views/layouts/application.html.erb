<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Code Gym</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #0f0f1a; --surface: #1a1a2e; --border: #2a2a4a;
      --accent: #7c6af7; --text: #e0e0f0; --muted: #888;
      --green: #4ade80; --red: #f87171; --yellow: #fbbf24;
    }
    body { background: var(--bg); color: var(--text); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; line-height: 1.6; }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }

    .container { max-width: 800px; margin: 0 auto; padding: 0 1.5rem; }

    nav { background: var(--surface); border-bottom: 1px solid var(--border); padding: .75rem 0; margin-bottom: 2rem; }
    nav .inner { display: flex; justify-content: space-between; align-items: center; }
    nav .brand { font-weight: 700; font-size: 1.1rem; color: var(--accent); }
    nav .nav-links { display: flex; gap: 1rem; font-size: .9rem; color: var(--muted); align-items: center; }

    .flash { padding: .75rem 1rem; border-radius: 6px; margin-bottom: 1.5rem; font-size: .9rem; }
    .flash.notice { background: rgba(74, 222, 128, .1); border: 1px solid var(--green); color: var(--green); }
    .flash.alert  { background: rgba(248, 113, 113, .1); border: 1px solid var(--red); color: var(--red); }

    .btn { display: inline-block; padding: .5rem 1.25rem; border-radius: 6px; font-size: .9rem; font-weight: 600; cursor: pointer; border: none; }
    .btn:disabled { opacity: .4; cursor: not-allowed; }
    .btn-primary { background: var(--accent); color: #fff; }
    .btn-primary:hover { background: #6a58e0; }
    .btn-ghost { background: transparent; color: var(--muted); border: 1px solid var(--border); }
    .btn-ghost:hover { border-color: var(--accent); color: var(--accent); }
    .btn-sm { padding: .3rem .8rem; font-size: .8rem; }
    /* Loading state for buttons whose click starts a wait. Two consumers:
       forms tagged data-loading-form (shared script at the bottom of this
       layout) and the fetch-driven submit/review handlers, which toggle the
       class themselves. pointer-events guards the gap before `disabled`
       lands (it is applied a tick late — see the shared script). */
    .btn-loading { opacity: .6; pointer-events: none; }
    .btn-loading::before {
      content: ""; display: inline-block; width: .8em; height: .8em;
      margin-right: .5em; vertical-align: -.1em;
      border: 2px solid currentColor; border-top-color: transparent;
      border-radius: 50%; animation: spin .7s linear infinite;
    }
    .spinner {
      display: inline-block; width: 2rem; height: 2rem;
      border: 3px solid var(--border); border-top-color: var(--accent);
      border-radius: 50%; animation: spin .7s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* pre-wrap keeps each line's leading whitespace (indentation) intact; it only
       allows breaks at spaces/newlines, so snippets wrap on phones instead of
       forcing horizontal scroll. */
    pre.snippet { background: #0d0d1a; border: 1px solid var(--border); border-radius: 6px; padding: 1rem; font-size: .85rem; margin-bottom: 1.25rem; white-space: pre-wrap; word-break: break-word; overflow-wrap: anywhere; }
    .review-block { background: rgba(124,106,247,.06); border: 1px solid var(--border); border-radius: 6px; padding: 1rem; margin-top: .75rem; }
    .review-block h4 { color: var(--accent); font-size: .85rem; text-transform: uppercase; letter-spacing: .06em; margin-bottom: .5rem; }
    .review-rating { display: inline-block; background: rgba(124,106,247,.15); border-radius: 4px; padding: .1rem .5rem; font-size: .75rem; margin-left: .5rem; text-transform: none; letter-spacing: 0; }
    .review-item { font-size: .9rem; line-height: 1.7; margin-top: .4rem; }

    /* Shared submission-rendering styles. Used by responses/_answered_sections,
       responses/_architecture_section, and responses/_submission — all of which
       render on BOTH the dashboard and the history page, so these cannot live in
       a per-page <style> block. */
    .section { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 1.5rem; margin-bottom: 1.5rem; }
    .section-label { font-size: .75rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--accent); margin-bottom: .95rem; }
    .section h2 { font-size: 1.1rem; margin-bottom: .75rem; }
    .section-scenario { font-size: .95rem; color: var(--muted); margin-bottom: .75rem; }
    .question { font-size: 1rem; line-height: 1.7; margin-bottom: 1.25rem; }
    .why-box { background: rgba(124,106,247,.08); border-left: 3px solid var(--accent); padding: .6rem .9rem; font-size: .9rem; color: var(--muted); border-radius: 0 6px 6px 0; margin-bottom: 1rem; }
    .arch-options { margin: 0 0 1.25rem 1.25rem; font-size: .95rem; line-height: 1.8; }

    details.ref { margin-bottom: 1rem; }
    details.ref summary { cursor: pointer; font-size: .85rem; color: var(--accent); padding: .4rem 0; list-style: none; }
    details.ref summary::before { content: "▶ "; }
    details.ref[open] summary::before { content: "▼ "; }
    .ref-body { background: #0d0d1a; border: 1px solid var(--border); border-radius: 6px; padding: 1rem; margin-top: .5rem; font-size: .88rem; line-height: 1.7; }

    details.hint { margin-bottom: 1rem; }
    details.hint summary { cursor: pointer; font-size: .85rem; color: var(--accent); padding: .4rem 0; list-style: none; }
    details.hint summary::before { content: "▶ "; }
    details.hint[open] summary::before { content: "▼ "; }
    details.hint.locked { pointer-events: none; opacity: .45; }
    .hint-body { background: rgba(124,106,247,.08); border-left: 3px solid var(--accent); padding: .6rem .9rem; font-size: .9rem; border-radius: 0 6px 6px 0; margin-top: .5rem; line-height: 1.6; }

    .submit-row { display: flex; gap: 1rem; align-items: center; margin-top: 1.5rem; }
    .submitted-badge { display: inline-block; background: rgba(74,222,128,.1); color: var(--green); border: 1px solid var(--green); border-radius: 4px; padding: .2rem .6rem; font-size: .8rem; font-weight: 600; }
    .answer-display { background: #0d0d1a; border: 1px solid var(--border); border-radius: 6px; padding: .75rem; font-size: .9rem; white-space: pre-wrap; word-break: break-word; }
    .review-section { margin-top: 1.5rem; }
    .history-pill { border: 1px solid var(--border); border-radius: 4px; padding: .15rem .5rem; font-size: .85rem; color: var(--muted); }

    .name-editor-input {
      background: transparent;
      border: 1px solid transparent;
      color: var(--text);
      font-size: inherit;
      font-family: inherit;
      padding: .15rem .3rem;
      width: 9rem;
      border-radius: 6px;
    }
    .name-editor-input:focus {
      outline: 1px solid var(--accent);
      outline-offset: 0;
      background: rgba(124, 106, 247, .06);
      border-color: var(--border);
    }
    .name-editor-status { font-size: .75rem; color: var(--muted); margin-left: .4rem; }
  </style>
</head>
<body>
  <nav>
    <div class="container inner">
      <% if logged_in? %>
        <%= link_to "⚡ Code Gym", root_path, class: "brand" %>
      <% else %>
        <span class="brand">⚡ Code Gym</span>
      <% end %>
      <% if logged_in? %>
        <div class="nav-links">
          <span class="name-editor">
            <input type="text"
                   id="nav-name-input"
                   class="name-editor-input"
                   value="<%= current_user.name %>"
                   aria-label="<%= t("profile.name.aria_label") %>">
            <span id="nav-name-status" class="name-editor-status" aria-live="polite"></span>
          </span>
          <%# Inline autosave: this app loads no Stimulus/importmap JS (the layout
              emits no javascript_importmap_tags), so the working convention here is
              an inline script, same as the answer autosave in dashboard/_exercise.
              Copy still comes from I18n; the CSRF token comes from the meta tag. %>
          <script>
            (function () {
              const input  = document.getElementById("nav-name-input");
              const status = document.getElementById("nav-name-status");
              if (!input) return;

              let lastSaved = input.value;
              const savedText = "<%= j t("profile.name.saved") %>";
              const errorText = "<%= j t("profile.name.error") %>";
              let statusTimer;

              function flash(message) {
                status.textContent = message;
                clearTimeout(statusTimer);
                statusTimer = setTimeout(() => { status.textContent = ""; }, 2000);
              }

              input.addEventListener("blur", async () => {
                const name = input.value.trim();
                if (name === lastSaved) return;
                if (name === "") { input.value = lastSaved; return; }

                try {
                  const response = await fetch("<%= profile_path %>", {
                    method: "PATCH",
                    headers: {
                      "Content-Type": "application/json",
                      "Accept": "application/json",
                      "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content
                    },
                    body: JSON.stringify({ user: { name } })
                  });

                  if (response.ok) {
                    const data = await response.json();
                    input.value = data.name;
                    lastSaved = data.name;
                    flash(savedText);
                  } else {
                    input.value = lastSaved;
                    flash(errorText);
                  }
                } catch {
                  input.value = lastSaved;
                  flash(errorText);
                }
              });
            })();
          </script>
          <% if current_user.time_zone.blank? %>
            <%# One-shot: only rendered while the zone is unset, so it never
                clobbers a later manual choice. Posts the browser's IANA zone. %>
            <script>
              (function () {
                const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
                if (!tz) return;
                fetch("<%= profile_path %>", {
                  method: "PATCH",
                  headers: {
                    "Content-Type": "application/json",
                    "Accept": "application/json",
                    "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content
                  },
                  body: JSON.stringify({ user: { time_zone: tz } })
                });
              })();
            </script>
          <% end %>
          <%= link_to "History", history_path %>
          <%= link_to "Account", account_path %>
        </div>
      <% end %>
    </div>
  </nav>

  <div class="container">
    <% if flash[:notice] %>
      <div class="flash notice"><%= flash[:notice] %></div>
    <% end %>
    <% if flash[:alert] %>
      <div class="flash alert"><%= flash[:alert] %></div>
    <% end %>

    <%= yield %>
  </div>
  <%# Loading feedback for plain form POSTs. Turbo JS is not loaded in this
      app, so button_to forms are full-page submissions — Turbo attributes
      (turbo_confirm, turbo_submits_with) are inert, and any feedback (or
      confirmation) must be wired here. A form opts in with data-loading-form;
      data-confirm-message gates submission behind a native confirm, and
      data-loading-label is the in-flight button label. %>
  <script>
    (() => {
      document.querySelectorAll("form[data-loading-form]").forEach(form => {
        const button = form.querySelector('button[type="submit"], input[type="submit"]');
        if (!button) return;

        // button_to (with Rails 8's button_to_generates_button_tag default)
        // renders a <button>, not an <input> — the two need different
        // properties for their label, so read/write whichever is present.
        const isButtonTag = button.tagName === "BUTTON";
        const originalLabel = isButtonTag ? button.textContent : button.value;
        const setLabel = (text) => { if (isButtonTag) { button.textContent = text; } else { button.value = text; } };

        form.addEventListener("submit", (event) => {
          const message = form.dataset.confirmMessage;
          if (message && !window.confirm(message)) { event.preventDefault(); return; }

          // Deferred a tick: disabling synchronously inside the submit
          // handler can cancel the submission in some browsers.
          setTimeout(() => {
            button.disabled = true;
            button.classList.add("btn-loading");
            if (form.dataset.loadingLabel) setLabel(form.dataset.loadingLabel);
          }, 0);
        });

        // A bfcache Back-restore would resurrect the page mid-"loading" —
        // button dead until a manual reload (same hazard the review button
        // handles). Reset to idle.
        window.addEventListener("pageshow", (event) => {
          if (!event.persisted) return;
          button.disabled = false;
          button.classList.remove("btn-loading");
          setLabel(originalLabel);
        });
      });
    })();
  </script>
</body>
</html>
