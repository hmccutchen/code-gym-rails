<div class="authenticator-settings">
  <h2><%= t("backup_codes.heading") %></h2>
  <p><%= t("backup_codes.intro") %></p>
  <%= form_with url: backup_codes_path, method: :post do |f| %>
    <%= f.label :code, t("backup_codes.code_label"), for: "backup-codes-code" %>
    <%= f.text_field :code, id: "backup-codes-code", required: true, autocomplete: "one-time-code", maxlength: 12 %>
    <%= f.submit t("backup_codes.submit"), class: "btn btn-ghost" %>
  <% end %>

  <p><%= t("authenticator_moves.intro") %></p>
  <%= form_with url: authenticator_move_path, method: :post do |f| %>
    <%= f.label :code, t("backup_codes.code_label"), for: "authenticator-move-code" %>
    <%= f.text_field :code, id: "authenticator-move-code", required: true, autocomplete: "one-time-code", maxlength: 12 %>
    <%= f.submit t("authenticator_moves.submit"), class: "btn btn-ghost" %>
  <% end %>
</div>
