<div class="reminder-toggle">
  <% if current_user.push_reminders_enabled? %>
    <p><%= t("accounts.push_reminders.enabled") %></p>

    <%= form_with url: push_subscription_path, method: :patch, class: "reminder-nudges" do |form| %>
      <label>
        <%= form.check_box :nudges, checked: current_user.reminders_ready_and_nudges?,
                                    checked_value: "1", unchecked_value: "0" %>
        <%= t("accounts.push_reminders.nudges_label", window: PushNudgePlan.window_description) %>
      </label>
      <%= form.submit t("accounts.push_reminders.save"), class: "btn btn-ghost" %>
    <% end %>

    <%= button_to t("accounts.push_reminders.turn_off"), push_subscription_path, method: :delete, class: "btn btn-ghost" %>
  <% else %>
    <p><%= t("accounts.push_reminders.offer") %></p>
    <button type="button" id="push-enable" class="btn btn-ghost"><%= t("accounts.push_reminders.turn_on") %></button>
    <p class="reminder-status" id="push-status" hidden></p>

    <% content_for :page_scripts do %>
      <script>
        (function () {
          const button = document.getElementById("push-enable");
          if (!button) return;

          const status = document.getElementById("push-status");
          const push = window.CodeGymPush;

          function say(message) {
            status.textContent = message;
            status.hidden = false;
          }

          // iPadOS reports itself as a Mac, so touch points are what separate
          // it from a desktop Safari that has no Home Screen to be added to.
          function isApplePortable() {
            return /iPad|iPhone|iPod/.test(navigator.userAgent) ||
                   (/Macintosh/.test(navigator.userAgent) && navigator.maxTouchPoints > 1);
          }

          if (!push || !push.supported()) {
            button.disabled = true;
            say(isApplePortable()
              ? <%= t("accounts.push_reminders.home_screen_only", app_name: t("app_name")).to_json.html_safe %>
              : <%= t("accounts.push_reminders.unsupported").to_json.html_safe %>);
            return;
          }

          button.addEventListener("click", function () {
            // This call MUST be the first statement in the handler. iOS grants
            // a permission prompt only to a request made synchronously inside a
            // user gesture, and it fails silently — no prompt, no error — if
            // anything awaits ahead of it. That is why the VAPID key is
            // rendered into the page rather than fetched, and why the service
            // worker is registered inside the .then() below rather than here.
            const permission = Notification.requestPermission();

            button.disabled = true;
            say(<%= t("accounts.push_reminders.waiting").to_json.html_safe %>);

            permission
              .then(function (state) {
                if (state !== "granted") {
                  throw new Error(state === "denied"
                    ? <%= t("accounts.push_reminders.blocked", app_name: t("app_name")).to_json.html_safe %>
                    : <%= t("accounts.push_reminders.not_granted").to_json.html_safe %>);
                }

                return push.subscribeAndRegister();
              })
              .then(function () {
                window.location.reload();
              })
              .catch(function (error) {
                button.disabled = false;
                say(error.message || <%= t("accounts.push_reminders.failed").to_json.html_safe %>);
              });
          });
        })();
      </script>
    <% end %>
  <% end %>
</div>
