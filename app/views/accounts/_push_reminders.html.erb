<style>
  .card .reminder-status { margin-top: .75rem; margin-bottom: 0; }
</style>
<section class="card">
  <h2><%= t("accounts.show.reminders_heading") %></h2>
  <% if current_user.push_reminders_enabled? %>
    <p class="card-note"><%= t("accounts.push_reminders.enabled") %></p>

    <div data-controller="push-enable"
         <%= tag.attributes(data: push_settings_data("push_enable")) %>
         <%= tag.attributes(data: push_enable_outcome_texts.merge(
               push_enable_repair_value: true,
               push_enable_repair_text_value: t("accounts.push_reminders.repair"))) %>>
      <p class="reminder-status card-note" id="push-repair-status" hidden data-push-enable-target="status"></p>
      <button type="button" id="push-repair" class="btn btn-ghost btn-block" hidden disabled
              data-push-enable-target="button" data-action="push-enable#enable"><%= t("accounts.push_reminders.repair_button") %></button>
    </div>

    <%= form_with url: push_subscription_path, method: :patch,
          data: { controller: "save-switch", save_switch_url_value: push_subscription_path, save_switch_key_value: "nudges",
                  save_switch_field_value: "nudges", save_switch_saved_text_value: t("switches.saved") } do |form| %>
      <label class="switch-row card-note">
        <%= t("accounts.push_reminders.nudges_label", window: PushNudgePlan.window_description) %>
        <%= form.check_box :nudges, { class: "switch", role: "switch", checked: current_user.reminders_ready_and_nudges?,
                                      data: { save_switch_target: "checkbox", action: "change->save-switch#toggle" } }, "1", "0" %>
      </label>
      <p class="card-note switch-status" role="status" data-save-switch-target="status"></p>
      <noscript>
        <%= form.button t("accounts.push_reminders.save"), type: "submit", name: "commit", value: t("accounts.push_reminders.save"), class: "btn btn-ghost btn-block" %>
      </noscript>
    <% end %>

    <%= button_to t("accounts.push_reminders.turn_off"), push_subscription_path, method: :delete, class: "btn btn-ghost btn-block" %>
  <% else %>
    <p class="card-note"><%= t("accounts.push_reminders.offer") %></p>
    <div data-controller="push-enable"
         <%= tag.attributes(data: push_settings_data("push_enable")) %>
         <%= tag.attributes(data: push_enable_outcome_texts.merge(
               push_enable_home_screen_only_text_value: t("accounts.push_reminders.home_screen_only", app_name: t("app_name")),
               push_enable_unsupported_text_value: t("accounts.push_reminders.unsupported"))) %>>
      <button type="button" id="push-enable" class="btn btn-ghost btn-block" disabled
              data-push-enable-target="button" data-action="push-enable#enable"><%= t("accounts.push_reminders.turn_on") %></button>
      <p class="reminder-status card-note" id="push-status" hidden data-push-enable-target="status"></p>
    </div>
  <% end %>
</section>
