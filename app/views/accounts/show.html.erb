<% page_title t("accounts.show.title") %>
<style>
  .account-id { color: var(--muted); font-size: .9rem; }
  .account-id .email { color: var(--text); font-family: monospace; display: block; margin-bottom: .2rem; overflow-wrap: anywhere; }
  .card .reminder-status { margin-top: .75rem; margin-bottom: 0; }
  .api-usage .card-note, .authenticator-form label.card-note { margin-bottom: 0; }
  .api-usage-total { font-size: 2rem; font-weight: 700; line-height: 1.2; font-variant-numeric: tabular-nums; }
  .api-usage-providers { margin: .75rem 0; }
  .api-usage-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: .25rem .75rem; min-height: 48px; border-top: 1px solid var(--border); }
  .api-usage-row dd { margin-left: auto; text-align: right; font-variant-numeric: tabular-nums; }
  .api-usage-row-unpriced dd { color: var(--muted); }
  .authenticator-settings h3 { font-size: .9rem; margin-bottom: .4rem; }
  .authenticator-form { margin-top: 1.25rem; display: flex; flex-direction: column; align-items: flex-start; gap: .5rem; }
  .authenticator-form input[type="text"] { width: 100%; padding: .55rem .8rem; background: var(--surface); border: 1px solid var(--border); border-radius: 6px; color: var(--text); font-size: var(--input-font-size); }
  .danger-zone h2 { color: var(--red); }
  .btn-danger { background: transparent; color: var(--red); border: 1px solid var(--red); }
  .btn-danger:hover { background: var(--red); color: var(--bg); }
</style>

<div class="phone-page">
  <h1><%= t("accounts.show.title") %></h1>

  <section class="card">
    <p class="account-id">
      <span class="email"><%= current_user.email %></span>
      <%= current_user.provider_label %> · <%= t("languages.#{current_user.language}") %>
    </p>
  </section>

  <section class="card">
    <h2><%= t("accounts.show.practice_heading") %></h2>
    <% if current_user.paused_generation_at? %>
      <p class="card-note"><%= t("accounts.show.paused", date: current_user.paused_generation_at.to_date.strftime("%B %-d")) %></p>
      <%= button_to t("accounts.show.resume"), toggle_generation_account_path, method: :patch, params: { paused: "0" }, class: "btn btn-ghost btn-block" %>
    <% else %>
      <p class="card-note"><%= t("accounts.show.active") %></p>
      <%= button_to t("accounts.show.pause"), toggle_generation_account_path, method: :patch, params: { paused: "1" }, class: "btn btn-ghost btn-block" %>
    <% end %>
  </section>

  <%= render "accounts/push_reminders" if WebPushCredentials.configured? %>

  <%= render "accounts/authenticator" %>

  <%= render "accounts/api_usage", usage: @usage, since: @usage_since %>

  <section class="card">
    <h2><%= t("accounts.show.session_heading") %></h2>
    <%= button_to t("accounts.show.log_out"), logout_path, method: :delete, class: "btn btn-ghost btn-block" %>
  </section>

  <section class="card danger-zone">
    <h2><%= t("accounts.show.danger_heading") %></h2>
    <p class="card-note"><%= t("accounts.show.danger_body") %></p>
    <%= button_to t("accounts.show.delete"), account_path, method: :delete,
          class: "btn btn-danger btn-block", disabled: true,
          form: { id: "delete-account-form", data: loading_form_data(confirm_message: t("accounts.show.delete_confirm")) } %>
  </section>
</div>
