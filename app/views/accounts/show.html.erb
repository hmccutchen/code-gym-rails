<% page_title t("accounts.show.title") %>
<% page_stylesheet "account" %>

<div class="phone-page">
  <h1><%= t("accounts.show.title") %></h1>

  <section class="card">
    <p class="account-id">
      <span class="email"><%= current_user.email %></span>
      <%= current_user.provider_label %> · <%= t("languages.#{current_user.language}") %>
    </p>
  </section>

  <section class="card">
    <h2><%= t("accounts.show.practice_heading") %></h2>
    <% if current_user.paused_generation_at? %>
      <p class="card-note"><%= t("accounts.show.paused", date: current_user.paused_generation_at.to_date.strftime("%B %-d")) %></p>
      <%= button_to t("accounts.show.resume"), toggle_generation_account_path, method: :patch, params: { paused: "0" }, class: "btn btn-ghost btn-block" %>
    <% else %>
      <p class="card-note"><%= t("accounts.show.active") %></p>
      <%= button_to t("accounts.show.pause"), toggle_generation_account_path, method: :patch, params: { paused: "1" }, class: "btn btn-ghost btn-block" %>
    <% end %>
  </section>

  <%= render "accounts/push_reminders" if WebPushCredentials.configured? %>

  <%= render "accounts/authenticator" %>

  <%= render "accounts/api_usage", usage: @usage, since: @usage_since %>

  <section class="card">
    <h2><%= t("accounts.show.session_heading") %></h2>
    <%= button_to t("accounts.show.log_out"), logout_path, method: :delete, class: "btn btn-ghost btn-block" %>
  </section>

  <section class="card danger-zone">
    <h2><%= t("accounts.show.danger_heading") %></h2>
    <p class="card-note"><%= t("accounts.show.danger_body") %></p>
    <%= button_to t("accounts.show.delete"), account_path, method: :delete,
          class: "btn btn-danger btn-block", disabled: true,
          form: { id: "delete-account-form", data: loading_form_data(confirm_message: t("accounts.show.delete_confirm")) } %>
  </section>
</div>
