<% page_title t("password_setups.edit.page_title") %>
<%= render "shared/auth_page_styles" %>

<div class="login-wrap">
  <h1><%= t("password_setups.edit.page_title") %></h1>
  <p><%= t("password_setups.edit.intro") %></p>

  <%= form_with model: current_user, scope: :user, url: password_setup_path, method: :patch do |f| %>
    <%= render "devise/shared/error_messages", resource: current_user %>
    <div class="form-field">
      <%= f.label :password, t("password_setups.edit.password_label", minimum: Devise.password_length.min) %>
      <%= f.password_field :password, required: true, minlength: Devise.password_length.min,
                                      autocomplete: "new-password", autofocus: true %>
    </div>
    <div class="form-field">
      <%= f.label :password_confirmation, t("password_setups.edit.password_confirmation_label") %>
      <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password" %>
    </div>
    <%= f.submit t("password_setups.edit.submit"), class: "btn btn-primary", style: "width:100%;padding:.75rem;" %>
  <% end %>
</div>
