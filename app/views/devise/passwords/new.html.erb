<% page_title t("passwords.new.page_title") %>
<%= render "shared/auth_page_styles" %>

<div class="login-wrap">
  <h1><%= t("passwords.new.page_title") %></h1>
  <p><%= t("passwords.new.intro") %></p>

  <%= form_with model: resource, scope: resource_name, url: user_password_path, method: :post do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <div class="form-field">
      <%= f.label :email, t("sessions.new.email_label") %>
      <%= f.email_field :email, required: true, autocomplete: "email", autofocus: true %>
    </div>
    <%= f.submit t("passwords.new.submit"), class: "btn btn-primary", style: "width:100%;padding:.75rem;" %>
  <% end %>

  <div class="auth-links"><%= link_to t("registrations.new.log_in"), new_user_session_path %></div>
</div>
