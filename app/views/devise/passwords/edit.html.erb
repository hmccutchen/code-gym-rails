<% page_title t("passwords.edit.page_title") %>
<%= render "shared/auth_page_styles" %>

<div class="login-wrap">
  <h1><%= t("passwords.edit.page_title") %></h1>

  <%= form_with model: resource, scope: resource_name, url: user_password_path, method: :put do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>
    <div class="form-field">
      <%= f.label :password, t("registrations.new.password_label", minimum: Devise.password_length.min) %>
      <%= f.password_field :password, required: true, minlength: Devise.password_length.min,
                                      autocomplete: "new-password", autofocus: true %>
    </div>
    <div class="form-field">
      <%= f.label :password_confirmation, t("registrations.new.password_confirmation_label") %>
      <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password" %>
    </div>
    <%= f.submit t("passwords.edit.submit"), class: "btn btn-primary", style: "width:100%;padding:.75rem;" %>
  <% end %>
</div>
