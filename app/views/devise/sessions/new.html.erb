<% page_title t("sessions.new.page_title") %>
<%= render "shared/auth_page_styles" %>

<div class="login-wrap">
  <h1><%= t("app_name") %></h1>
  <p><%= t("sessions.new.intro") %></p>

  <%= form_with model: resource, scope: resource_name, url: session_path(resource_name) do |f| %>
    <div class="form-field">
      <%= f.label :email, t("sessions.new.email_label") %>
      <%= f.email_field :email, placeholder: t("sessions.new.email_placeholder"), required: true,
                                autocomplete: "username" %>
    </div>
    <div class="form-field">
      <%= f.label :password, t("sessions.new.password_label") %>
      <%= f.password_field :password, required: true, autocomplete: "current-password" %>
    </div>
    <div class="form-field">
      <%= f.label :otp_attempt, t("sessions.new.otp_label") %>
      <%= f.text_field :otp_attempt, autocomplete: "one-time-code", inputmode: "text", maxlength: 12,
                                     aria: { describedby: "otp-hint" } %>
      <p id="otp-hint" class="form-hint"><%= t("sessions.new.otp_hint") %></p>
    </div>
    <%= f.submit t("sessions.new.submit"), class: "btn btn-primary", style: "width:100%;padding:.75rem;" %>
  <% end %>

  <div class="auth-links">
    <%= link_to t("sessions.new.sign_up"), new_user_registration_path %>
    <%= link_to t("sessions.new.forgot_password"), new_user_password_path %>
    <%= link_to t("sessions.new.resend_confirmation"), new_user_confirmation_path %>
    <%= link_to t("sessions.new.first_sign_in"), first_sign_in_path %>
  </div>
</div>
