<%# Required locals: providers (the provider keys the trial runs on, or can
    be started on when the person has not chosen yet). %>
<div class="data-notice">
  <p><%= t("trials.data_notice.shared", provider: providers.map { |key| AiProvider.label(key) }.to_sentence(two_words_connector: " or ", last_word_connector: " or ")) %></p>
  <% providers.each do |key| %>
    <p><%= t("trials.data_notice.#{key}") %></p>
  <% end %>
</div>
