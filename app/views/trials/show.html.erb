<% page_title t("trials.page_title") %>
<%= render "trials/styles" %>

<div class="trial-wrap">
  <h1><%= t("trials.heading") %></h1>
  <% if current_user.trial? %>
    <p><%= t("trials.running_until", day: l(current_user.trial_ends_at.in_time_zone(current_user.effective_time_zone).to_date, format: :long)) %></p>
    <%= render "trials/data_notice", providers: [ current_user.provider ] %>
  <% elsif (providers = TrialMode.providers).any? %>
    <p><%= t("trials.intro") %></p>
    <%= render "trials/form", url: trial_path, providers: providers, signed_out: false %>
  <% else %>
    <p><%= t("trials.unavailable") %></p>
  <% end %>
</div>
