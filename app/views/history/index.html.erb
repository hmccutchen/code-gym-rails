<% page_title t("history.index.title") %>
<style>
  .page-header { margin-bottom: 2rem; }
  .page-header h1 { font-size: 1.5rem; }
  .page-header .count { color: var(--muted); font-size: .9rem; }

  .history-entry { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 1.5rem; margin-bottom: 1.5rem; }
  .history-entry h2 { font-size: 1.05rem; margin-bottom: .5rem; }
  .history-meta { display: flex; gap: .75rem; flex-wrap: wrap; align-items: center; font-size: .85rem; color: var(--muted); margin-bottom: .5rem; }
  .history-tag { border: 1px solid var(--accent); color: var(--accent-text); border-radius: 4px; padding: .15rem .5rem; font-size: .8rem; }

  details.review summary { cursor: pointer; font-size: .85rem; color: var(--accent-text); padding: .4rem 0; list-style: none; }
  details.review summary::before { content: "▶ "; }
  details.review[open] summary::before { content: "▼ "; }
  .no-review { font-size: .85rem; color: var(--muted); }

  details.answers { margin: .75rem 0; }
  details.answers summary { cursor: pointer; font-size: .85rem; color: var(--accent-text); padding: .4rem 0; list-style: none; }
  details.answers summary::before { content: "▶ "; }
  details.answers[open] summary::before { content: "▼ "; }
  details.answers .section { margin-top: 1rem; }

  /* Mirrors the layout's .section mobile rule; the values are coupled. */
  @media (max-width: 600px) {
    .history-entry {
      margin-inline: -1.5rem;
      padding: 1.25rem 1rem;
      border-radius: 0;
      border-left: none;
      border-right: none;
    }
    /* The entry already spans the viewport, so these cards stay inset instead of the shared .section break-out. */
    .history-entry .section {
      margin-inline: 0;
      border-radius: 10px;
      border-left: 1px solid var(--border);
      border-right: 1px solid var(--border);
    }
  }
  .pagination { display: flex; align-items: center; justify-content: center; gap: 1rem; margin: 2rem 0 1rem; font-size: .9rem; }
  .pagination a { color: var(--accent-text); text-decoration: none; border: 1px solid var(--border); border-radius: 6px; padding: .4rem .7rem; }
  .pagination a[aria-disabled="true"] { color: var(--muted); opacity: .5; pointer-events: none; }
  .pagination span { color: var(--muted); }
</style>

<div class="page-header">
  <h1><%= t("history.index.title") %></h1>
  <div class="count"><%= t("history.index.count", count: @pagy.count) %></div>
</div>

<% if @pagy.count.zero? %>
  <div class="history-entry" style="text-align:center;padding:3rem;">
    <p style="color:var(--muted);"><%= t("history.index.empty_html", link: link_to(t("history.index.back_link"), root_path)) %></p>
  </div>
<% end %>

<% @responses.each_with_index do |daily_response, i| %>
  <div class="history-entry" id="response-<%= daily_response.id %>">
    <h2><%= daily_response.date.strftime("%A, %B %-d, %Y") %></h2>

    <div class="history-meta">
      <span class="history-pill">
        <% answered = daily_response.answered_sections %>
        <% counts = { answered: answered.size, total: daily_response.section_keys.size } %>
        <% if answered.any? %>
        <%= t("history.index.sections_with_names", **counts, names: answered.map(&:humanize).join(", ")) %>
        <% else %>
        <%= t("history.index.sections", **counts) %>
        <% end %>
      </span>
      <% daily_response.section_ratings.each do |section, value| %>
        <span class="history-pill"><%= t("history.index.rating", section: section.humanize, rating: DailyResponse.self_rating_labels[value]) %></span>
      <% end %>
      <% daily_response.concept_tags.values.compact.uniq.each do |tag| %>
        <span class="history-tag"><%= tag.humanize %></span>
      <% end %>
    </div>

    <%# Same partial as the dashboard's submitted state; collapsed so the review below is what a visitor sees. %>
    <details class="answers">
      <summary><%= t("history.index.problems_summary") %></summary>
      <%= render "responses/answered_sections", exercise: daily_response.daily_exercise, response: daily_response %>
    </details>

    <% if daily_response.reviewed? %>
      <details class="review" <%= "open" if i.zero? && @pagy.page == 1 %>>
        <summary><%= t("review.history_summary", provider: daily_response.review_provider_label) %></summary>
        <%= render "shared/ai_review", response: daily_response %>
      </details>
    <% else %>
      <p class="no-review"><%= t("history.index.no_review") %></p>
    <% end %>
  </div>
<% end %>

<% if @pagy.last > 1 %>
  <%# Raw output: Pagy returns pre-escaped HTML without calling html_safe. %>
  <nav class="pagination" aria-label="<%= t("history.index.pages_label") %>">
    <%== @pagy.previous_tag(text: "← Newer") %>
    <span><%= t("history.index.page", page: @pagy.page, last: @pagy.last) %></span>
    <%== @pagy.next_tag(text: "Older →") %>
  </nav>
<% end %>
