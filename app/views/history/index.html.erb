<% page_title t("history.index.title") %>
<% wide_page %>
<% page_stylesheet "history" %>
<div class="card-page history-page">
<div class="history-rail">
  <h1><%= t("history.index.title") %></h1>
  <p class="count"><%= t("history.index.count", count: @pagy.count) %></p>
  <% if @pagy.last > 1 %>
    <p class="history-rail-page" aria-hidden="true"><%= t("history.index.page", page: @pagy.page, last: @pagy.last) %></p>
  <% end %>
</div>

<div class="history-entries">

<% if @pagy.count.zero? %>
  <div class="history-entry" style="text-align:center;padding:3rem;">
    <p style="color:var(--muted);"><%= t("history.index.empty_html", link: link_to(t("history.index.back_link"), root_path)) %></p>
  </div>
<% end %>

<% @responses.each_with_index do |daily_response, i| %>
  <div class="history-entry" id="response-<%= daily_response.id %>">
    <h2><%= daily_response.date.strftime("%A, %B %-d, %Y") %></h2>

    <div class="history-meta">
      <span class="history-pill">
        <% answered = daily_response.answered_sections %>
        <% counts = { answered: answered.size, total: daily_response.section_keys.size } %>
        <% if answered.any? %>
        <%= t("history.index.sections_with_names", **counts, names: answered.map(&:humanize).join(", ")) %>
        <% else %>
        <%= t("history.index.sections", **counts) %>
        <% end %>
      </span>
      <% daily_response.section_ratings.each do |section, value| %>
        <span class="history-pill"><%= t("history.index.rating", section: section.humanize, rating: self_rating_labels[value]) %></span>
      <% end %>
      <% daily_response.concept_tags.values.compact.uniq.each do |tag| %>
        <span class="history-tag"><%= tag.humanize %></span>
      <% end %>
    </div>

    <%# Same partial as the dashboard's submitted state; collapsed so the review below is what a visitor sees. %>
    <details class="answers">
      <summary><%= t("history.index.problems_summary") %></summary>
      <%= render "responses/answered_sections", exercise: daily_response.daily_exercise, response: daily_response %>
    </details>

    <% if daily_response.reviewed? %>
      <details class="review" <%= "open" if i.zero? && @pagy.page == 1 %>>
        <summary><%= t("review.history_summary", provider: review_provider_label(daily_response)) %></summary>
        <%= render "shared/ai_review", response: daily_response %>
      </details>
    <% else %>
      <p class="no-review"><%= t("history.index.no_review") %></p>
    <% end %>
  </div>
<% end %>

<% if @pagy.last > 1 %>
  <%# Raw output: Pagy returns pre-escaped HTML without calling html_safe. %>
  <nav class="pagination" aria-label="<%= t("history.index.pages_label") %>">
    <%== @pagy.previous_tag(text: "← Newer") %>
    <span><%= t("history.index.page", page: @pagy.page, last: @pagy.last) %></span>
    <%== @pagy.next_tag(text: "Older →") %>
  </nav>
<% end %>
</div>
</div>
