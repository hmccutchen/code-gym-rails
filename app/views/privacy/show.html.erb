<% page_title t("privacy.show.heading") %>
<% page_stylesheet "privacy" %>

<article class="privacy-page">
  <% unless logged_in? %>
    <p class="privacy-brand"><%= t("app_name") %></p>
  <% end %>
  <h1><%= t("privacy.show.heading") %></h1>

  <section aria-labelledby="privacy-stored">
    <h2 id="privacy-stored"><%= t("privacy.show.stored.heading") %></h2>
    <p><%= t("privacy.show.stored.body") %></p>
    <p><%= t("privacy.show.stored.kept") %></p>
    <p><%= t("privacy.show.stored.retention", duck_days: @facts[:duck_days]) %></p>
    <p><%= t("privacy.show.stored.authenticator") %></p>
  </section>

  <section aria-labelledby="privacy-key">
    <h2 id="privacy-key"><%= t("privacy.show.key.heading") %></h2>
    <p><%= t("privacy.show.key.storage") %></p>
    <p><%= t("privacy.show.key.use") %></p>
    <p><%= t("privacy.show.key.operator") %></p>
  </section>

  <section aria-labelledby="privacy-sent">
    <h2 id="privacy-sent"><%= t("privacy.show.sent.heading") %></h2>
    <p><%= t("privacy.show.sent.provider") %></p>
    <p><%= t("privacy.show.sent.email") %></p>
  </section>

  <section aria-labelledby="privacy-device">
    <h2 id="privacy-device"><%= t("privacy.show.device.heading") %></h2>
    <p><%= t("privacy.show.device.body", days: @facts[:session_days]) %></p>
  </section>

  <section aria-labelledby="privacy-cost">
    <h2 id="privacy-cost"><%= t("privacy.show.cost.heading") %></h2>
    <p><%= t("privacy.show.cost.billing") %></p>
    <p><%= t("privacy.show.cost.schedule") %></p>
    <p><%= t("privacy.show.cost.pause", count: @facts[:unopened_sets]) %></p>
  </section>

  <section aria-labelledby="privacy-reminders">
    <h2 id="privacy-reminders"><%= t("privacy.show.reminders.heading") %></h2>
    <p><%= t("privacy.show.reminders.body") %></p>
  </section>

  <section id="deleting" aria-labelledby="privacy-deleting">
    <h2 id="privacy-deleting"><%= t("privacy.show.deleting.heading") %></h2>
    <p><%= t("privacy.show.deleting.body") %></p>
    <p><%= t("privacy.show.deleting.leftovers", log_days: @facts[:log_days]) %></p>
  </section>

  <% unless logged_in? %>
    <p class="privacy-log-in"><%= link_to t("privacy.show.log_in"), login_path, class: "btn btn-primary" %></p>
  <% end %>
</article>
