<%# Inline page scripts run before this, so they may call it only from handlers that fire after load. %>
<script>
  window.CodeGymServerMessage = (function () {
    const SIGNED_OUT = <%= t("server_message.signed_out").to_json.html_safe %>;
    const written = new WeakSet();

    // null for an HTML error page, a redirected login page, or an empty body.
    async function read(response) {
      try { return await response.json(); } catch (_) { return null; }
    }

    function error(text) {
      const e = new Error(text);
      written.add(e);
      return e;
    }

    // The only redirect a JSON endpoint gives is to the login page after the session expires.
    function failure(response, data, fallback) {
      if (response && response.redirected) return error(SIGNED_OUT);
      const ours = data && data.status === "error" && typeof data.error === "string" && data.error;
      return error(ours || fallback);
    }

    function message(e, fallback) {
      return written.has(e) ? e.message : fallback;
    }

    return { read: read, error: error, failure: failure, message: message };
  })();
</script>
