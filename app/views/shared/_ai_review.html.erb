<%# Design notes: docs/code-notes/app/views/shared/_ai_review.html.md %>
<% exercise_language = response.daily_exercise.language %>
<% response.ai_review.each do |section, fb| %>
  <% next unless fb.is_a?(Hash) %>
  <div class="review-block">
    <h3><%= section.humanize %><% if fb["rating"].present? %><span class="review-rating"><%= fb["rating"] %></span><% end %></h3>
    <%# Context under the grade badge, never a badge of its own: a second pill would read as a second score. %>
    <% if (difficulty = response.difficulty_for(section)) %>
      <p class="difficulty-note">
        <%= t("review.difficulty_note", level: difficulty["level"]) %>
        <%= difficulty["reason"] %>
      </p>
    <% end %>
    <% if response.answered?(section) && response.self_rating_favorable?(section) && response.ai_rating_unfavorable?(section) %>
      <p class="calibration-note"><%= t("review.calibration_note", rating: response.self_rating_label(section)) %></p>
    <% end %>
    <% DailyResponse::AI_REVIEW_FIELDS.each do |key, field| %>
      <% if field[:list] %>
        <% points = DailyResponse.review_points(fb[key]) %>
        <% if points.any? %>
          <div class="review-item">
            <strong><%= DailyResponse.ai_review_label(key) %>:</strong>
            <ul class="review-points">
              <% points.each do |point| %><li><%= point %></li><% end %>
            </ul>
          </div>
        <% end %>
      <% else %>
        <% text = DailyResponse.review_points(fb[key]).join(" ") %>
        <% if text.present? %>
          <p class="review-item"><strong><%= DailyResponse.ai_review_label(key) %>:</strong> <%= text %></p>
        <% end %>
      <% end %>
    <% end %>
    <% improved_code = DailyResponse.improved_code_text(fb["improved_code"]) %>
    <% if improved_code.present? && response.improved_code_visible?(section) %>
      <% kind = ExerciseSection.for(section) %>
      <% if kind.improved_code_prose? %>
        <p class="review-item"><strong><%= kind.improved_code_label %>:</strong></p>
        <div class="plan-excerpt" style="margin-top:.4rem"><%= improved_code %></div>
      <% else %>
        <pre class="snippet" style="margin-top:.75rem"><%= highlighted_code(improved_code, exercise_language) %></pre>
      <% end %>
    <% end %>
    <div class="alternates" data-section="<%= section %>" data-controller="review-alternates"
         data-review-alternates-section-value="<%= section %>"
         data-review-alternates-url-value="<%= explain_differently_response_path(response) %>"
         data-review-alternates-thinking-text-value="<%= t("review.thinking") %>"
         data-review-alternates-added-text-value="<%= t("review.alternate_added") %>"
         data-review-alternates-added-last-text-value="<%= t("review.alternate_added_last") %>"
         data-review-alternates-failed-text-value="<%= t("review.alternate_failed") %>">
      <% Array(response.review_alternates[section]).each do |alt| %>
        <p class="alternate-item"><%= alt %></p>
      <% end %>
      <% if Array(response.review_alternates[section]).size < DailyResponse::MAX_ALTERNATES_PER_SECTION %>
        <button type="button" class="btn btn-ghost btn-sm explain-differently"
                data-review-alternates-target="button"
                data-action="review-alternates#explain"><%= t("review.explain_differently") %></button>
      <% end %>
      <span class="alternate-status" aria-live="polite" data-review-alternates-target="status"></span>
    </div>
    <% turns = response.review_follow_ups.select { |t| t.section == section }.sort_by { |t| [ t.created_at, t.id ] } %>
    <% asked = turns.count { |t| t.role_user? } %>
    <div class="follow-ups" data-section="<%= section %>" data-controller="follow-ups"
         data-follow-ups-section-value="<%= section %>"
         data-follow-ups-url-value="<%= follow_ups_response_path(response) %>"
         data-follow-ups-thinking-text-value="<%= t("review.thinking") %>"
         data-follow-ups-capped-text-value="<%= t("review.follow_ups_used", count: DailyResponse::MAX_FOLLOW_UPS_PER_SECTION) %>"
         data-follow-ups-failed-text-value="<%= t("review.follow_up_failed") %>">
      <div class="follow-up-thread" aria-live="polite" data-follow-ups-target="thread">
        <% turns.each do |turn| %>
          <p class="follow-up-turn follow-up-<%= turn.role %>"><%= turn.content %></p>
        <% end %>
      </div>
      <% if asked < DailyResponse::MAX_FOLLOW_UPS_PER_SECTION %>
        <div class="follow-up-form" data-follow-ups-target="form">
          <label class="visually-hidden" for="follow-up-input-<%= response.id %>-<%= section %>"><%= t("review.follow_up_label") %></label>
          <input type="text" class="follow-up-input" id="follow-up-input-<%= response.id %>-<%= section %>" placeholder="<%= t("review.follow_up_placeholder") %>"
                 data-follow-ups-target="input" data-action="keydown->follow-ups#enter">
          <button type="button" class="btn btn-ghost btn-sm follow-up-send"
                  data-follow-ups-target="send" data-action="follow-ups#send"><%= t("review.follow_up_send") %></button>
        </div>
      <% else %>
        <p class="follow-up-capped"><%= t("review.follow_ups_used", count: DailyResponse::MAX_FOLLOW_UPS_PER_SECTION) %></p>
      <% end %>
      <span class="follow-up-status" aria-live="polite" data-follow-ups-target="status"></span>
    </div>
  </div>
<% end %>
