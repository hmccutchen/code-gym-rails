<%# Locals: source (Mermaid text; blank or refused renders nothing), collapsible (default true; false inside an existing <details>). %>
<% if MermaidSource.usable?(source) %>
  <% if local_assigns.fetch(:collapsible, true) %>
    <details class="ref">
      <summary><%= t("diagram.summary") %></summary>
      <div class="mermaid-diagram" data-diagram="<%= source %>" data-owns-details="1"></div>
    </details>
  <% else %>
    <div class="mermaid-diagram" data-diagram="<%= source %>"></div>
  <% end %>
  <%# Emitted once per page: the one script renders every .mermaid-diagram on it. %>
  <% unless @mermaid_diagram_script_emitted %>
    <% @mermaid_diagram_script_emitted = true %>
    <% content_for :page_scripts do %>
      <script type="module">
        // Design notes: docs/code-notes/app/views/shared/_mermaid_diagram.html.md
        const pending = () => document.querySelectorAll(".mermaid-diagram[data-diagram]:not([data-mermaid-done])");
        // Remove the <details> only when this partial created it; architecture's belongs to its caller.
        const removeFailed = (el) => (el.dataset.ownsDetails === "1" ? el.closest("details") : el).remove();
        const cleanupAllPending = () => { for (const el of pending()) removeFailed(el); };
        try {
          const mermaid = (await import("https://cdn.jsdelivr.net/npm/mermaid@11.17.2/dist/mermaid.esm.min.mjs")).default;
          // securityLevel stays strict: the diagram source is model-generated.
          mermaid.initialize({ startOnLoad: false, securityLevel: "strict" });

          for (const el of pending()) {
            el.dataset.mermaidDone = "1";
            const src = el.dataset.diagram;
            try {
              await mermaid.parse(src);
              const { svg } = await mermaid.render("mmd-" + Math.random().toString(36).slice(2), src);
              el.innerHTML = svg;
            } catch {
              removeFailed(el);
            }
          }
        } catch {
          cleanupAllPending();
        }
      </script>
    <% end %>
  <% end %>
<% end %>
