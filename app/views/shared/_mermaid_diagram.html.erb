<%# Locals: source (Mermaid text; blank or refused renders nothing), collapsible (default true; false inside an existing <details>); rendered by the layout's mermaid controller. %>
<% if MermaidSource.usable?(source) %>
  <% if local_assigns.fetch(:collapsible, true) %>
    <details class="ref">
      <summary><%= t("diagram.summary") %></summary>
      <div class="mermaid-diagram" data-diagram="<%= source %>" data-owns-details="1"></div>
    </details>
  <% else %>
    <div class="mermaid-diagram" data-diagram="<%= source %>"></div>
  <% end %>
<% end %>
