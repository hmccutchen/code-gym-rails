<%# Locals: question (the text shown), body (the stored note or nil), editable (false once the day is submitted). %>
<section class="learner-note" id="learner-note"<% if editable %> data-controller="learner-note" data-learner-note-url-value="<%= learner_note_path %>"<% end %>>
  <h2 class="learner-note-heading"><%= t("learner_notes.note.label") %></h2>
  <% if editable %>
    <label for="learner-note-input" data-learner-note-target="question"><%= question %></label>
    <textarea id="learner-note-input" class="answer" maxlength="<%= LearnerNote::MAX_TEXT_LENGTH %>" data-learner-note-target="input" data-action="input->learner-note#save"><%= body %></textarea>
    <p class="hint"><%= t("learner_notes.note.hint") %></p>
  <% else %>
    <p><%= question %></p>
    <%= simple_format(h(body), class: "learner-note-body") %>
  <% end %>
</section>
