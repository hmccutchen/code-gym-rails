<%# Design notes: docs/code-notes/app/views/shared/_save_status.html.md %>
<p id="save-status" class="save-status" hidden></p>
<%# Always present: screen readers often skip a live region that appears with its text already in it. %>
<p id="save-status-announcer" class="visually-hidden" role="alert"></p>

<script>
  window.CodeGymSaveStatus = (function () {
    const GENERIC = <%= t("save_status.generic").to_json.html_safe %>;
    const SIGNED_OUT = <%= t("save_status.signed_out").to_json.html_safe %>;
    const banner = document.getElementById("save-status");
    const announcer = document.getElementById("save-status-announcer");

    const failures = new Map();
    const issued = new Map();
    let counter = 0;

    let requests = 0;
    const probes = [];

    function watch(probe) {
      probes.push(probe);
    }

    function pending() {
      return requests > 0 || probes.some((probe) => probe());
    }

    function render() {
      const messages = Array.from(failures.values());

      if (messages.length === 0) {
        banner.hidden = true;
        banner.textContent = "";
        announcer.textContent = "";
        return;
      }

      banner.textContent = messages[messages.length - 1];
      announcer.textContent = banner.textContent;
      banner.hidden = false;
    }

    function fail(key, message) {
      failures.delete(key);
      failures.set(key, message);
      render();
    }

    function succeed(key) {
      failures.delete(key);
      render();
    }

    // With forgery protection off there is no csrf meta tag, and a throw here would stop the save silently.
    function csrf() {
      return document.querySelector('meta[name="csrf-token"]')?.content ?? "";
    }

    function save(method, url, body, key) {
      const ticket = ++counter;
      issued.set(key, ticket);

      const current = () => issued.get(key) === ticket;

      requests++;
      return fetch(url, {
        method: method,
        headers: {
          "Content-Type": "application/json",
          "Accept": "application/json",
          "X-CSRF-Token": csrf()
        },
        body: JSON.stringify(body)
      }).then(async (response) => {
        if (!current()) return { ok: false };

        // fetch follows redirects, so an expired session arrives as the login page with ok true.
        if (response.redirected) { fail(key, SIGNED_OUT); return { ok: false }; }
        if (response.ok) {
          succeed(key);
          return { ok: true, data: await response.json().catch(() => null) };
        }

        const data = await response.json().catch(() => null);
        fail(key, (data && data.errors && data.errors[0]) || GENERIC);
        return { ok: false, status: response.status, data: data };
      }).catch(() => {
        if (current()) fail(key, GENERIC);
        return { ok: false };
      }).finally(() => { requests--; });
    }

    const CARRIED = "code-gym-save-status-carried";

    function carry(key, message) {
      try {
        sessionStorage.setItem(CARRIED, JSON.stringify({ key: key, message: message, path: location.pathname }));
      } catch (error) {
        // Private browsing can refuse the write; the reloaded page then just shows no message.
      }
    }

    try {
      const carried = sessionStorage.getItem(CARRIED);
      if (carried) {
        sessionStorage.removeItem(CARRIED);
        const parsed = JSON.parse(carried);
        if (parsed && parsed.message && parsed.path === location.pathname) fail(parsed.key || "carried", parsed.message);
      }
    } catch (error) {
      try { sessionStorage.removeItem(CARRIED); } catch (ignored) {}
    }

    return { save: save, watch: watch, pending: pending, carry: carry };
  })();
</script>
