<%# The autosaves on the dashboard and /setup report through here, so a
    rejected write tells the engineer instead of vanishing. The page's control
    keeps whatever the user set — snapping a slider back under their hand is
    worse than the problem this solves — and the banner says the change did not
    reach the server.

    One exception, and it is the caller's to make rather than this file's: a
    save refused because another tab got there first comes back carrying the
    state that is actually stored, and /setup puts that on screen. Keeping the
    user's value there would leave the page showing something the server has
    refused and will keep refusing, which is the lie this component exists to
    stop rather than an instance of protecting their input.

    The layout's one-shot time-zone detection deliberately does NOT report
    here: nothing the user did triggers it, so a banner would name a failure
    they took no action to cause, and it re-runs on the next page load anyway.

    Rendered from the layout ahead of `yield :page_scripts`, the same way
    shared/_push_script is, so a page's own script can rely on
    window.CodeGymSaveStatus existing by the time it runs. %>
<p id="save-status" class="save-status" role="status" aria-live="polite" hidden></p>

<script>
  window.CodeGymSaveStatus = (function () {
    const GENERIC = <%= t("save_status.generic").to_json.html_safe %>;
    const SIGNED_OUT = <%= t("save_status.signed_out").to_json.html_safe %>;
    const banner = document.getElementById("save-status");

    // Keyed by control rather than held as one flag: /setup saves three
    // different things to one URL, and without a key a successful time-zone
    // save would clear a warning the exercise-mix save had just earned, while
    // the rejected checkbox sat there still looking saved.
    const failures = new Map();
    // Guards against two saves of the SAME control finishing out of order,
    // where a slow failure would otherwise overwrite the result of the newer
    // save that succeeded after it.
    const issued = new Map();
    let counter = 0;

    function render() {
      const messages = Array.from(failures.values());

      if (messages.length === 0) {
        banner.hidden = true;
        banner.textContent = "";
        return;
      }

      banner.textContent = messages[messages.length - 1];
      banner.hidden = false;
    }

    function fail(key, message) {
      failures.delete(key);
      failures.set(key, message);
      render();
    }

    function succeed(key) {
      failures.delete(key);
      render();
    }

    // Optional-chained for the same reason api_keys/edit's script was: with
    // forgery protection off, Rails renders no csrf meta tag at all, and a
    // throw here would stop the save silently — the exact failure this file
    // exists to surface.
    function csrf() {
      return document.querySelector('meta[name="csrf-token"]')?.content ?? "";
    }

    function save(method, url, body, key) {
      const ticket = ++counter;
      issued.set(key, ticket);

      const current = () => issued.get(key) === ticket;

      return fetch(url, {
        method: method,
        headers: {
          "Content-Type": "application/json",
          "Accept": "application/json",
          "X-CSRF-Token": csrf()
        },
        body: JSON.stringify(body)
      }).then(async (response) => {
        // Resolves with { ok, status, data } so a caller able to act on a
        // particular refusal can. Callers that cannot simply ignore it —
        // reporting the failure has already happened by then either way.
        if (!current()) return { ok: false };

        // fetch follows redirects, so a request made after the session expired
        // arrives here as the login page: 200, and `ok` true, for a save that
        // stored nothing. Neither endpoint redirects on success, so a redirect
        // can only mean the write did not happen.
        if (response.redirected) { fail(key, SIGNED_OUT); return { ok: false }; }
        if (response.ok) {
          succeed(key);
          return { ok: true, data: await response.json().catch(() => null) };
        }

        // A failure can answer with an HTML error page rather than JSON, and
        // parsing that throws — hence the inner catch. Only a message the
        // server actually wrote is shown; anything else falls back to GENERIC,
        // which is why the rejection path below ignores its own error. A
        // dropped connection rejects with a browser string ("Failed to fetch"),
        // and that is a developer's sentence, not one to hand an engineer.
        const data = await response.json().catch(() => null);
        fail(key, (data && data.errors && data.errors[0]) || GENERIC);
        return { ok: false, status: response.status, data: data };
      }).catch(() => {
        if (current()) fail(key, GENERIC);
        return { ok: false };
      });
    }

    return { save: save };
  })();
</script>
