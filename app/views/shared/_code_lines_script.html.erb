<script>
  (() => {
    function fitAlignment(code) {
      code.removeAttribute("data-wraps");

      const probe = document.createElement("span");
      probe.className = "code-line";
      probe.textContent = "x";
      code.append(probe);
      const row = probe.getBoundingClientRect().height;
      probe.remove();
      // A hidden block (a closed disclosure) measures zero; the observer fits it when it opens.
      if (row === 0) return;

      const wraps = [...code.children].some((line) => line.getBoundingClientRect().height > row * 1.5);
      code.toggleAttribute("data-wraps", wraps);
    }

    // Fitting changes a block's height, never its width, so reacting to width alone cannot loop.
    const widths = new WeakMap();
    const fitOnResize = new ResizeObserver((entries) => {
      entries.forEach(({ target, contentRect }) => {
        if (widths.get(target) === contentRect.width) return;
        widths.set(target, contentRect.width);
        fitAlignment(target.querySelector(":scope > code"));
      });
    });

    document.addEventListener("DOMContentLoaded", () => {
      for (const code of document.querySelectorAll("code.highlight")) {
        // Observes the <pre>, since an inline <code> reports no size.
        if (code.querySelector(".code-align-extra")) fitOnResize.observe(code.parentElement);
      }
    });
  })();
</script>
