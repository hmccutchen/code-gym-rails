<%# Required locals: reference (the ConceptReference featured this week, stamped with its Monday). %>
<div class="featured-concept">
  <p class="featured-label"><%= t("learn.featured.label") %></p>
  <h2 class="featured-title">
    <%= link_to reference.concept.humanize,
                learn_concept_path(bucket: reference.language, concept: reference.concept) %>
  </h2>
  <p class="featured-bucket"><%= t("learn.buckets.#{reference.language}") %></p>
  <% if reference.tagline.present? %>
    <p class="featured-tagline"><%= reference.tagline %></p>
  <% end %>
</div>
