<%# Required locals: featured (this week's FeaturedConcept). Optional: day_response, the dashboard's day, read by featured_tagline_shown?. %>
<% reference = concept_reference_for(featured.concept, featured.bucket) %>
<div class="featured-concept">
  <p class="featured-label"><%= t("learn.featured.label") %></p>
  <h2 class="featured-title">
    <%= link_to featured.concept.humanize,
                learn_concept_path(bucket: featured.bucket, concept: featured.concept) %>
  </h2>
  <p class="featured-bucket"><%= t("learn.buckets.#{featured.bucket}") %> · <%= t("learn.featured.seen",
        count: current_user.concept_exposures.count(featured.concept, featured.bucket, on_or_before: Date.current)) %></p>
  <% if featured_tagline_shown?(local_assigns[:day_response]) && reference&.tagline.present? %>
    <p class="featured-tagline"><%= glossary_wrap(reference.tagline) %></p>
  <% end %>
</div>
