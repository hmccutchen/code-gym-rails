<%# Locals: field (section key, e.g. "code_review"), turns and version (its stored thread; each written only when present). Design notes: docs/code-notes/app/views/shared/_duck_thread.html.md %>
<div class="duck-thread"
     data-controller="duck-thread"
     data-duck-thread-section-value="<%= field %>"
     data-duck-thread-url-value="<%= duck_thread_responses_path %>"
     data-duck-thread-max-turns-value="<%= ResponsesController::MAX_DUCK_TURNS_PER_SECTION %>"
     data-duck-thread-explain-message-value="<%= AiService::DUCK_EXPLAIN_REQUEST %>"
     data-duck-thread-send-failed-text-value="<%= t("duck.send_failed") %>"
     data-duck-thread-thinking-text-value="<%= t("duck.thinking") %>"
     data-duck-thread-capped-text-value="<%= t("duck.turns_used", count: ResponsesController::MAX_DUCK_TURNS_PER_SECTION) %>"
     data-duck-thread-user-speaker-value="<%= t("duck.speakers.user") %>"
     data-duck-thread-assistant-speaker-value="<%= t("duck.speakers.assistant") %>"<% if turns.any? %> data-duck-thread-turns-value="<%= turns.to_json %>"<% end %><% if version.to_i.positive? %> data-duck-thread-version-value="<%= version %>"<% end %>>
  <button type="button" class="btn btn-ghost btn-sm duck-toggle" aria-expanded="false" aria-controls="duck-body-<%= field %>" data-duck-thread-target="toggle" data-action="duck-thread#toggle"><%= image_tag("duck-flex.png", alt: "", class: "duck-icon", aria: { hidden: true }) %><%= t("duck.toggle") %></button>
  <div class="duck-body" id="duck-body-<%= field %>" hidden data-duck-thread-target="body">
    <div class="duck-turns" aria-live="polite" data-duck-thread-target="turns"></div>
    <div class="duck-form">
      <label class="visually-hidden" for="duck-input-<%= field %>"><%= t("duck.prompt") %></label>
      <input type="text" class="duck-input" id="duck-input-<%= field %>" placeholder="<%= t("duck.prompt") %>" data-duck-thread-target="input" data-action="keydown.enter->duck-thread#send:prevent">
      <button type="button" class="btn btn-ghost btn-sm duck-send" data-duck-thread-target="send" data-action="duck-thread#send"><%= t("duck.send") %></button>
      <button type="button" class="btn btn-ghost btn-sm duck-explain" data-duck-thread-target="explain" data-action="duck-thread#explain"><%= t("duck.explain") %></button>
      <button type="button" class="btn btn-ghost btn-sm duck-clear" data-action="duck-thread#clear"><%= t("duck.clear") %></button>
    </div>
    <span class="duck-status" aria-live="polite" data-duck-thread-target="status"></span>
  </div>
</div>
