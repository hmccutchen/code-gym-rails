<style>
  .welcome-wrap { max-width: 480px; margin: 5rem auto; }
  .welcome-wrap h1 { margin-bottom: .5rem; }
  .welcome-choice { display: block; width: 100%; text-align: left; margin-top: 1rem; }
  .welcome-choice .hint { display: block; font-size: .8rem; color: var(--muted); margin-top: .3rem; font-weight: normal; }
</style>

<div class="welcome-wrap" id="welcome" data-controller="welcome"
     data-welcome-url-value="<%= profile_path %>"
     data-welcome-setup-url-value="<%= setup_path %>"
     data-welcome-preset-value="<%= LearningTrack.preset_levels.to_json %>"
     data-welcome-skill-level-value="<%= LearningTrack::START_SKILL_LEVEL %>"
     data-welcome-version-value="<%= current_user.section_kind_preferences_version %>">
  <h1><%= t("learning_track.welcome.title") %></h1>
  <p><%= t("learning_track.welcome.question") %></p>

  <button type="button" class="btn btn-primary welcome-choice" data-track="junior"
          data-welcome-target="choice" data-action="welcome#choose">
    <%= t("learning_track.welcome.junior") %>
    <span class="hint"><%= t("learning_track.welcome.junior_hint") %></span>
  </button>
  <button type="button" class="btn btn-ghost welcome-choice" data-track="none"
          data-welcome-target="choice" data-action="welcome#choose">
    <%= t("learning_track.welcome.experienced") %>
    <span class="hint"><%= t("learning_track.welcome.experienced_hint") %></span>
  </button>
</div>

