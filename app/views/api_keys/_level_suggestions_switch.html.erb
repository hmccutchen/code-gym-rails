<%= tag.div id: "level-suggestions-switch", class: "mix-note",
      data: { controller: "save-switch",
              save_switch_url_value: profile_path,
              save_switch_key_value: "level_suggestions",
              save_switch_field_value: "level_suggestions",
              save_switch_scope_value: "user",
              save_switch_focus_value: (true if show_level_suggestions?) } do %>
  <label for="level-suggestions">
    <input type="checkbox" id="level-suggestions" <%= "checked" if current_user.level_suggestions? %>
           aria-describedby="level-suggestions-hint"
           data-save-switch-target="checkbox" data-action="change->save-switch#toggle">
    <%= t("level_suggestion.setup.label") %>
  </label>
  <p class="hint" id="level-suggestions-hint"><%= t("level_suggestion.setup.hint") %></p>
<% end %>
