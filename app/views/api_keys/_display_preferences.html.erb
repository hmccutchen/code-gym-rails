<%# Makes the layout link the display stylesheets here even with nothing stored, so a choice applies before it saves. %>
<% content_for :display_controls, "1" %>
<% preferences = DisplayPreferences.for(current_user) %>
<details class="form-field" id="display-preferences" data-controller="display-preferences"
         data-display-preferences-url-value="<%= profile_path %>"
         data-display-preferences-defaults-value="<%= DisplayPreferences::OPTIONS.transform_values(&:first).to_json %>"
         data-display-preferences-palette-value="<%= DisplayPreferences::LIGHT_PALETTE_MEDIA.to_json %>"
         data-display-preferences-palette-off-value="<%= DisplayPreferences::LIGHT_PALETTE_OFF %>"
         data-action="change->display-preferences#change">
  <summary><%= t("display.summary") %></summary>
  <p class="hint"><%= t("display.intro") %></p>

  <% DisplayPreferences::OPTIONS.each do |setting, values| %>
    <fieldset class="display-group">
      <legend><%= t("display.#{setting}.legend") %></legend>
      <% values.each do |value| %>
        <label>
          <input type="radio" name="display_<%= setting %>" value="<%= value %>" data-setting="<%= setting %>"
                 <%= "checked" if preferences[setting] == value %>>
          <%= t("display.#{setting}.options.#{value}") %>
        </label>
      <% end %>
      <% if (hint = t("display.#{setting}.hint", default: nil)) %>
        <p class="hint display-hint"><%= hint %></p>
      <% end %>
    </fieldset>
  <% end %>
</details>

