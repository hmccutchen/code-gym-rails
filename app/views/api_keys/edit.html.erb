<%# Design notes: docs/code-notes/app/views/api_keys/edit.html.md %>
<% page_title t("api_keys.edit.title") %>
<style>
  :where(#exercise-mix, #display-preferences) p:not(.card-note) { color: var(--muted); margin-bottom: 2rem; }
  .form-field { margin-bottom: 1rem; }
  :is(.form-field, .settings-fields) label:not(:where(.switch-row)) { display: block; font-size: .85rem; color: var(--muted); margin-bottom: .3rem; }
  :is(.form-field, .settings-fields) input:not([type="checkbox"], [type="radio"]) { width: 100%; padding: .65rem .9rem; background: var(--surface); border: 1px solid var(--border); border-radius: 6px; color: var(--text); font-size: var(--input-font-size); font-family: monospace; }
  :is(.form-field, .settings-fields) input:not([type="checkbox"], [type="radio"]):focus { border-color: var(--accent); }
  :is(.form-field, .settings-fields) input:is([type="checkbox"], [type="radio"]):not(:where(.switch)) { width: auto; margin-right: .4rem; vertical-align: middle; }
  .hint { font-size: .8rem; color: var(--muted); margin-top: .4rem; }
  .mix-group { border: 1px solid var(--border); border-radius: 6px; padding: .75rem; margin-bottom: .75rem; }
  .mix-group legend { font-size: .8rem; color: var(--muted); padding: 0 .35rem; }
  .mix-row { display: grid; grid-template-columns: 1fr auto; gap: .25rem .5rem; align-items: center; margin-bottom: .6rem; }
  .mix-row input[type="range"] { grid-column: 1 / -1; width: 100%; }
  .mix-row output { font-size: .8rem; color: var(--muted); }
  .mix-row input[type="range"]:disabled { opacity: .4; }
  .mix-exclude { font-size: .8rem; color: var(--muted); }
  .mix-exclude { min-height: 24px; }
  .mix-note { border-left: 3px solid var(--accent); padding-left: .6rem; margin: .5rem 0 1rem; }
</style>

<div class="phone-page" data-controller="profile-preferences"
     data-profile-preferences-url-value="<%= profile_path %>"
     data-profile-preferences-label-template-value="<%= t("exercise_mix.level_default", skill_level: "__LEVEL__") %>">
  <h1><%= t("api_keys.edit.heading") %></h1>

  <section class="card">
    <div class="card-heading">
      <h2><%= t("api_keys.edit.connection_heading") %></h2>
      <span class="card-tag"><%= t("api_keys.edit.connection_save_tag") %></span>
    </div>
    <p class="card-note"><%= t("api_keys.edit.intro") %></p>
    <% if current_user.on_trial? && current_user.trial_active? %>
      <%= render "api_keys/trial_note" %>
    <% elsif current_user.trial_ended? || (!current_user.api_key_present? && !current_user.daily_exercises.exists?) %>
      <%= render "api_keys/key_guide" %>
    <% end %>

    <%= form_with url: setup_path, method: :patch do |f| %>
      <div class="form-field">
        <%= f.label :api_key, t("api_keys.edit.api_key_label") %>
        <%= f.password_field :api_key, placeholder: t("api_keys.edit.api_key_placeholder"), autocomplete: "off" %>
        <p class="card-note"><%= t("api_keys.edit.api_key_hint_html") %></p>
        <% if current_user.stored_providers.any? %>
          <p class="card-note"><%= t("api_keys.edit.saved_keys_hint") %></p>
        <% end %>
      </div>
      <% if current_user.stored_providers.any? %>
        <fieldset class="field-group" id="provider-choice">
          <legend><%= t("api_keys.edit.provider_legend") %></legend>
          <div class="segmented">
            <% current_user.stored_providers.each do |provider| %>
              <label class="segment"><%= f.radio_button :provider, provider, checked: current_user.provider == provider %><%= AiProvider.label(provider) %></label>
            <% end %>
          </div>
          <p class="card-note"><%= t("api_keys.edit.provider_hint") %></p>
        </fieldset>
      <% end %>
      <% language_options = User::LANGUAGES.map { |language| [ t("api_keys.edit.language_options.#{language}"), language ] } %>
      <div class="value-row" data-controller="value-row">
        <%= f.label :language, t("api_keys.edit.language_label") %>
        <span class="value-row-value" aria-hidden="true" data-value-row-target="value"><%= language_options.rassoc(current_user.language)&.first %></span>
        <%= f.select :language, language_options,
              { selected: current_user.language },
              data: { action: "change->value-row#show" } %>
      </div>
      <p class="card-note"><%= t("api_keys.edit.language_hint") %></p>
      <%= f.button t("api_keys.edit.save_key"), type: "submit", name: "commit", value: t("api_keys.edit.save_key"), class: "btn btn-primary btn-block" %>
    <% end %>
  </section>

  <section class="card">
    <h2><%= t("api_keys.edit.your_day_heading") %></h2>
    <% time_zone_options = [ [ t("api_keys.edit.time_zones.eastern"), "America/New_York" ],
                             [ t("api_keys.edit.time_zones.central"), "America/Chicago" ],
                             [ t("api_keys.edit.time_zones.mountain"), "America/Denver" ],
                             [ t("api_keys.edit.time_zones.arizona"), "America/Phoenix" ],
                             [ t("api_keys.edit.time_zones.pacific"), "America/Los_Angeles" ],
                             [ t("api_keys.edit.time_zones.alaska"), "America/Anchorage" ],
                             [ t("api_keys.edit.time_zones.hawaii"), "Pacific/Honolulu" ] ] %>
    <% if current_user.time_zone.present? && !time_zone_options.rassoc(current_user.time_zone) %>
      <% time_zone_options << [ current_user.time_zone, current_user.time_zone ] %>
    <% end %>
    <div class="value-row" data-controller="value-row">
      <label for="tz-select"><%= t("api_keys.edit.time_zone_label") %></label>
      <span class="value-row-value" aria-hidden="true" data-value-row-target="value"><%= time_zone_options.rassoc(current_user.time_zone)&.first || t("api_keys.edit.time_zone_detect") %></span>
      <%= select_tag "tz_select",
            options_for_select(time_zone_options, current_user.time_zone),
            include_blank: t("api_keys.edit.time_zone_detect"),
            id: "tz-select",
            data: { profile_preferences_target: "timeZone", action: "change->profile-preferences#saveTimeZone change->value-row#show" } %>
    </div>
    <p class="card-note"><%= t("api_keys.edit.time_zone_hint") %></p>

    <fieldset class="field-group" id="daily-sections"
              data-profile-preferences-target="dailySections" data-action="change->profile-preferences#saveDailySections">
      <legend><%= t("daily_sections.legend") %></legend>
      <div class="segmented">
        <label class="segment"><input type="radio" name="daily_section_count" value="<%= User::AUTOMATIC_SECTION_COUNT %>" <%= "checked" if current_user.daily_section_count.nil? %>><%= t("daily_sections.automatic") %></label>
        <% User::DAILY_SECTION_COUNTS.each do |count| %>
          <label class="segment"><input type="radio" name="daily_section_count" value="<%= count %>" <%= "checked" if current_user.daily_section_count == count %>><%= count %></label>
        <% end %>
      </div>
      <p class="card-note"><%= t("daily_sections.hint",
                                lowest: User::DAILY_SECTION_COUNTS.first,
                                fixed_sections: DailyKinds.for(current_user).map { |kind| t("sections.#{kind.key}.name") }.to_sentence) %></p>
    </fieldset>

    <% skill_level_options = User::SKILL_LEVELS.map { |level| [ t("exercise_mix.levels.#{level}"), level ] } %>
    <div class="value-row" data-controller="value-row">
      <label for="skill-level"><%= t("api_keys.edit.skill_level_label") %></label>
      <span class="value-row-value" aria-hidden="true" data-value-row-target="value"><%= skill_level_options.rassoc(current_user.skill_level)&.first %></span>
      <%= select_tag "skill_level",
            options_for_select(skill_level_options, current_user.skill_level),
            id: "skill-level", autocomplete: "off",
            data: { profile_preferences_target: "skillLevel", action: "change->profile-preferences#saveSkillLevel change->value-row#show" } %>
    </div>
    <p class="card-note"><%= t("api_keys.edit.skill_level_hint") %></p>
    <p class="card-note" role="status" data-profile-preferences-target="keptOwnLevel"></p>
  </section>

  <details class="card settings-fields" id="exercise-mix"<%= " open" if suggested_kinds.any? || show_level_suggestions? %>
           data-controller="exercise-mix"
           data-action="profile-preferences:trackSaving@document->exercise-mix#holdForTrackSave profile-preferences:trackSaved@document->exercise-mix#adoptTrackChange profile-preferences:trackFailed@document->exercise-mix#settlePrepareButton"
           data-exercise-mix-url-value="<%= profile_path %>"
           data-exercise-mix-layout-value="<%= DailyKinds.for(current_user).map(&:key).to_json %>"
           data-exercise-mix-layout-stranded-text-value="<%= t("exercise_mix.layout_stranded") %>"
           data-exercise-mix-stops-value="<%= KindPreferences::MULTIPLIERS.to_json %>"
           data-exercise-mix-default-stop-value="<%= KindPreferences::DEFAULT_MULTIPLIER %>"
           data-exercise-mix-labels-value="<%= t("exercise_mix.stops").to_json %>"
           data-exercise-mix-version-value="<%= current_user.section_kind_preferences_version %>"<% if suggested_steps.any? %>
           data-exercise-mix-suggested-value="<%= suggested_steps.to_json %>"<% end %>>
    <summary><%= t("exercise_mix.summary") %></summary>
    <% if suggested_kinds.any? %>
      <p class="mix-note" id="mix-suggested-note"><%= t("level_suggestion.setup_suggested",
                                                     kinds: suggested_kinds.map { |key| t("sections.#{key}.name") }.to_sentence,
                                                     level: t("exercise_mix.levels.#{suggested_level}").downcase) %></p>
    <% end %>
    <%= render "api_keys/level_suggestions_switch" %>
    <p class="hint"><%= t("exercise_mix.intro") %></p>

    <div class="mix-note">
      <strong><%= t("exercise_mix.exclude_heading") %></strong>
      <p class="hint"><%= t("exercise_mix.exclude_body_weak") %></p>
      <p class="hint"><%= t("exercise_mix.exclude_body_strong") %></p>
      <p class="hint"><%= t("exercise_mix.exclude_body_frequency") %></p>
    </div>

    <div class="mix-note">
      <strong><%= t("exercise_mix.lock_heading") %></strong>
      <p class="hint"><%= t("exercise_mix.lock_body") %></p>
    </div>

    <fieldset class="mix-group">
      <legend><%= t("exercise_mix.fixed_group") %></legend>
      <% DailyKinds.for(current_user).each do |kind| %>
        <div class="mix-row mix-row-fixed">
          <span><%= t("sections.#{kind.key}.name") %></span>
          <%= render "api_keys/difficulty_controls", kind: kind, excluded: false %>
          <%= render "responses/kind_about", key: kind.key %>
        </div>
      <% end %>
    </fieldset>
    <% ExerciseSection.optional_slots(daily: DailyKinds.for(current_user)).select { |_, kinds| kinds.size == 1 }.each do |slot, (kind)| %>
      <fieldset class="mix-group">
        <legend><%= t("exercise_mix.#{slot}_group") %></legend>
        <div class="mix-row mix-row-fixed">
          <span><%= t("sections.#{kind.key}.name") %></span>
          <%= render "api_keys/difficulty_controls", kind: kind, excluded: false %>
          <%= render "responses/kind_about", key: kind.key %>
        </div>
      </fieldset>
    <% end %>

    <% ExerciseSection.optional_slots(daily: DailyKinds.for(current_user)).select { |_, kinds| kinds.size > 1 }.each do |slot, kinds| %>
      <fieldset class="mix-group mix-group-rotating" data-exercise-mix-target="group">
        <legend><%= t("exercise_mix.#{slot}_group") %></legend>

        <% kinds.each do |kind| %>
          <%
            stored   = current_user.section_kind_weights[kind.key]
            index    = KindPreferences::MULTIPLIERS.index(stored) || KindPreferences::MULTIPLIERS.index(KindPreferences::DEFAULT_MULTIPLIER)
            excluded = current_user.excluded_section_kinds.include?(kind.key)
          %>
          <div class="mix-row" data-kind="<%= kind.key %>" data-exercise-mix-target="row">
            <label for="weight-<%= kind.key %>"><%= t("sections.#{kind.key}.name") %></label>
            <input type="range" id="weight-<%= kind.key %>" min="0" max="<%= KindPreferences::MULTIPLIERS.size - 1 %>" step="1"
                   value="<%= index %>" <%= "disabled" if excluded %>
                   aria-valuetext="<%= t("exercise_mix.stops")[index] %>"
                   data-action="input->exercise-mix#slide">
            <output id="weight-label-<%= kind.key %>"><%= t("exercise_mix.stops")[index] %></output>
            <label class="mix-exclude" for="exclude-<%= kind.key %>">
              <input type="checkbox" id="exclude-<%= kind.key %>" class="mix-exclude-box" <%= "checked" if excluded %>
                     data-action="change->exercise-mix#toggleExclude">
              <%= t("exercise_mix.exclude_label") %>
            </label>
            <%= render "api_keys/difficulty_controls", kind: kind, excluded: excluded %>
            <%= render "responses/kind_about", key: kind.key %>
          </div>
        <% end %>

        <p class="hint mix-last-note" hidden><%= t("exercise_mix.last_in_slot") %></p>
      </fieldset>
    <% end %>

    <% preparation = ladder_preparation %>
    <div id="mix-ladder-preparation" <%= "hidden" if preparation[:count].zero? %>
         data-exercise-mix-target="preparation">
      <p class="hint" id="mix-ladder-explanation"><%= t("exercise_mix.ladders_explanation") %></p>
      <%= button_to preparation[:button_label], prepare_learn_ladders_path,
                    class: "btn btn-sm", id: "prepare-ladders", form: { class: "mix-ladders" },
                    data: { exercise_mix_target: "prepareButton" },
                    aria: { describedby: "mix-ladder-explanation mix-ladder-cost" } %>
      <p class="hint" id="mix-ladder-cost"><%= t("exercise_mix.ladders_cost") %></p>
    </div>
  </details>

  <%= render "api_keys/display_preferences" %>

</div>
