<style>
  .setup-wrap { max-width: 480px; margin: 5rem auto; }
  .setup-wrap h1 { margin-bottom: .5rem; }
  .setup-wrap p  { color: var(--muted); margin-bottom: 2rem; }
  .form-field { margin-bottom: 1rem; }
  .form-field label { display: block; font-size: .85rem; color: var(--muted); margin-bottom: .3rem; }
  .form-field input:not([type="checkbox"]) { width: 100%; padding: .65rem .9rem; background: var(--surface); border: 1px solid var(--border); border-radius: 6px; color: var(--text); font-size: var(--input-font-size); font-family: monospace; }
  .form-field input:not([type="checkbox"]):focus { outline: none; border-color: var(--accent); }
  .form-field input[type="checkbox"] { width: auto; margin-right: .4rem; vertical-align: middle; }
  .form-field select { width: 100%; padding: .65rem .9rem; background: var(--surface); border: 1px solid var(--border); border-radius: 6px; color: var(--text); font-size: var(--input-font-size); }
  .form-field select:focus { outline: none; border-color: var(--accent); }
  .hint { font-size: .8rem; color: var(--muted); margin-top: .4rem; }
  .mix-group { border: 1px solid var(--border); border-radius: 6px; padding: .75rem; margin-bottom: .75rem; }
  .mix-group legend { font-size: .8rem; color: var(--muted); padding: 0 .35rem; }
  .mix-row { display: grid; grid-template-columns: 1fr auto; gap: .25rem .5rem; align-items: center; margin-bottom: .6rem; }
  .mix-row input[type="range"] { grid-column: 1 / -1; width: 100%; }
  .mix-row output { font-size: .8rem; color: var(--muted); }
  .mix-row input[type="range"]:disabled { opacity: .4; }
  .mix-exclude { font-size: .8rem; color: var(--muted); }
  .mix-note { border-left: 3px solid var(--accent); padding-left: .6rem; margin: .5rem 0 1rem; }
  .mix-difficulty { grid-column: 1 / -1; border: 0; padding: .35rem 0 0; margin: 0; display: flex; flex-wrap: wrap; gap: .25rem .75rem; font-size: .8rem; }
  .mix-difficulty legend { font-size: .8rem; color: var(--muted); padding: 0; }
  .mix-lock { flex-basis: 100%; color: var(--text); font-weight: 600; }
  .mix-coverage { flex-basis: 100%; margin-top: 0; }
</style>

<div class="setup-wrap">
  <h1>Add your API key</h1>
  <p>Your key is encrypted at rest and only used to generate your personal exercise sets and reviews. Usage is tracked per-user for transparency.</p>

  <%= form_with url: setup_path, method: :patch do |f| %>
    <div class="form-field">
      <%= f.label :api_key, "API key" %>
      <%= f.password_field :api_key, placeholder: "sk-ant-... or AQ...., AIza...", autocomplete: "off" %>
      <p class="hint">Paste an Anthropic key (<a href="https://console.anthropic.com/settings/keys" target="_blank">console.anthropic.com</a>, starts with <code>sk-ant-</code>) or a Google Gemini key (<a href="https://aistudio.google.com/apikey" target="_blank">aistudio.google.com</a>, starts with <code>AQ.</code> or the older <code>AIza</code>).</p>
    </div>
    <div class="form-field">
      <%= f.label :language, "Exercise language" %>
      <%= f.select :language,
            [ [ "Ruby / Rails (default)", "ruby_rails" ],
              [ "JavaScript (vanilla + React)", "javascript" ],
              [ "Mixed (alternates daily)", "mixed" ] ],
            selected: current_user.language %>
      <p class="hint">Choose the language your daily exercise sets are generated in. "Mixed" alternates between Ruby/Rails and JavaScript one full day at a time.</p>
    </div>
    <%= f.submit "Save key →", class: "btn btn-primary" %>
  <% end %>

  <div class="form-field">
    <label for="tz-select">Time zone</label>
    <%= select_tag "tz_select",
          options_for_select(
            [ [ "Eastern", "America/New_York" ],
              [ "Central", "America/Chicago" ],
              [ "Mountain", "America/Denver" ],
              [ "Mountain (Arizona, no DST)", "America/Phoenix" ],
              [ "Pacific", "America/Los_Angeles" ],
              [ "Alaska", "America/Anchorage" ],
              [ "Hawaii", "Pacific/Honolulu" ] ],
            current_user.time_zone),
          include_blank: "— detect automatically —",
          id: "tz-select" %>
    <p class="hint">Sets when your day rolls over and when your 8am exercise set is generated. Leave on "detect automatically" to use your browser's zone.</p>
  </div>

  <div class="form-field">
    <label for="adaptive-set-size">
      <%= check_box_tag "adaptive_set_size", "1", current_user.adaptive_set_size, id: "adaptive-set-size" %>
      Adjust set size to my recent completion
    </label>
    <p class="hint">Shorter sets after days you don't finish, back to four as you do. Off means always four sections.</p>
  </div>

  <details class="form-field" id="exercise-mix">
    <summary><%= t("exercise_mix.summary") %></summary>
    <p class="hint"><%= t("exercise_mix.intro") %></p>

    <div class="mix-note">
      <strong><%= t("exercise_mix.exclude_heading") %></strong>
      <p class="hint"><%= t("exercise_mix.exclude_body_weak") %></p>
      <p class="hint"><%= t("exercise_mix.exclude_body_strong") %></p>
      <p class="hint"><%= t("exercise_mix.exclude_body_frequency") %></p>
    </div>

    <div class="mix-note">
      <strong><%= t("exercise_mix.lock_heading") %></strong>
      <p class="hint"><%= t("exercise_mix.lock_body") %></p>
    </div>

    <%# The complement of the rotating loop below: a slot holding one candidate
        has nothing to weigh or exclude, but its difficulty can still be set. %>
    <fieldset class="mix-group">
      <legend><%= t("exercise_mix.fixed_group") %></legend>
      <% ExerciseSection.slots.select { |_, kinds| kinds.size == 1 }.values.flatten.each do |kind| %>
        <div class="mix-row mix-row-fixed">
          <span><%= t("sections.#{kind.key}.name") %></span>
          <%= render "api_keys/difficulty_controls", kind: kind, excluded: false %>
        </div>
      <% end %>
    </fieldset>

    <%# Derived from the slot roster, like ExerciseSection.rotatable and the
        User validations: a slot holding one candidate has nothing to bias, and
        a future multi-kind slot gets its controls without an edit here. %>
    <% ExerciseSection.slots.select { |_, kinds| kinds.size > 1 }.each do |slot, kinds| %>
      <fieldset class="mix-group mix-group-rotating">
        <legend><%= t("exercise_mix.#{slot}_group") %></legend>

        <% kinds.each do |kind| %>
          <%
            stored   = current_user.section_kind_weights[kind.key]
            index    = KindPreferences::MULTIPLIERS.index(stored) || KindPreferences::MULTIPLIERS.index(KindPreferences::DEFAULT_MULTIPLIER)
            excluded = current_user.excluded_section_kinds.include?(kind.key)
          %>
          <div class="mix-row" data-kind="<%= kind.key %>" data-weighted>
            <label for="weight-<%= kind.key %>"><%= t("sections.#{kind.key}.name") %></label>
            <input type="range" id="weight-<%= kind.key %>" min="0" max="<%= KindPreferences::MULTIPLIERS.size - 1 %>" step="1"
                   value="<%= index %>" <%= "disabled" if excluded %>
                   aria-describedby="weight-label-<%= kind.key %>">
            <output id="weight-label-<%= kind.key %>"><%= t("exercise_mix.stops")[index] %></output>
            <label class="mix-exclude" for="exclude-<%= kind.key %>">
              <input type="checkbox" id="exclude-<%= kind.key %>" class="mix-exclude-box" <%= "checked" if excluded %>>
              <%= t("exercise_mix.exclude_label") %>
            </label>
            <%= render "api_keys/difficulty_controls", kind: kind, excluded: excluded %>
          </div>
        <% end %>

        <p class="hint mix-last-note" hidden><%= t("exercise_mix.last_in_slot") %></p>
      </fieldset>
    <% end %>

    <% if (gaps = ladder_gap_count).positive? %>
      <%= button_to t("exercise_mix.ladders_button", count: gaps), prepare_learn_ladders_path,
                    class: "btn btn-sm", form: { class: "mix-ladders" } %>
      <p class="hint"><%= t("exercise_mix.ladders_cost") %></p>
    <% end %>
  </details>

  <script>
    (function () {
      // CodeGymSaveStatus owns the request, the CSRF token, and what happens
      // when the server refuses — see shared/_save_status.
      // The key is per control, not per URL: all three of these PATCH the same
      // path, and a shared key would let one control's success clear another's
      // warning while the rejected state stayed on screen.
      const save = (payload, key) =>
        window.CodeGymSaveStatus.save("PATCH", "<%= profile_path %>", { user: payload }, key);

      const tz = document.getElementById("tz-select");
      if (tz) tz.addEventListener("change", () => save({ time_zone: tz.value }, "time_zone"));

      const adaptive = document.getElementById("adaptive-set-size");
      if (adaptive) adaptive.addEventListener("change", () => save({ adaptive_set_size: adaptive.checked }, "adaptive_set_size"));

      const STOPS  = <%= raw KindPreferences::MULTIPLIERS.to_json %>;
      const DEFAULT_STOP = <%= raw KindPreferences::DEFAULT_MULTIPLIER.to_json %>;
      const LABELS = <%= raw t("exercise_mix.stops").to_json %>;
      const mix    = document.getElementById("exercise-mix");

      if (mix) {
        const rows = Array.from(mix.querySelectorAll(".mix-row[data-weighted]"));

        const difficulties = Array.from(mix.querySelectorAll(".mix-difficulty"));
        const difficultyFor = (kind) => mix.querySelector('.mix-difficulty[data-kind="' + kind + '"]');
        const chosenLevel = (box) => (box.querySelector("input[type=radio]:checked") || { value: "" }).value;

        // A lock is only meaningful with a level, so choosing the default clears
        // it here rather than posting a lock the server would refuse. Coverage
        // does not depend on the level, so it can show as soon as one is chosen.
        const syncDifficulty = (box) => {
          const targeted = chosenLevel(box) !== "";
          const lock = box.querySelector(".mix-lock-box");
          const excluded = box.querySelector("input[type=radio]").disabled;

          if (!targeted) lock.checked = false;
          lock.disabled = excluded || !targeted;
          box.querySelector(".mix-coverage").hidden = !targeted;
        };

        const setDifficultyDisabled = (box, disabled) => {
          box.querySelectorAll("input[type=radio]").forEach((radio) => { radio.disabled = disabled; });
          syncDifficulty(box);
        };

        const state = () => {
          const weights = {};
          const excluded = [];

          rows.forEach((row) => {
            const kind = row.dataset.kind;
            const slider = row.querySelector("input[type=range]");
            const box = row.querySelector(".mix-exclude-box");
            const value = STOPS[Number(slider.value)];

            if (box.checked) excluded.push(kind);
            // Sparse on purpose: a kind left at the default stores no key, so
            // "untouched" and "set back to default" are one stored state.
            if (value !== DEFAULT_STOP) weights[kind] = value;
          });

          const levels = {};
          const locked = [];
          difficulties.forEach((box) => {
            const level = chosenLevel(box);
            if (level === "") return;
            levels[box.dataset.kind] = level;
            if (box.querySelector(".mix-lock-box").checked) locked.push(box.dataset.kind);
          });

          return { section_kind_weights: weights, excluded_section_kinds: excluded,
                   section_kind_levels: levels, locked_section_kinds: locked };
        };

        // The set of kinds carrying a target, as a stable key for detecting
        // whether a save changed it. Order-independent, since two kinds
        // gaining targets in the same save is still one change.
        const targetedKinds = () => Object.keys(state().section_kind_levels).sort().join(",");

        // The last targeted-kind set this tab knows the server actually has —
        // as rendered at load, and re-synced after every successful save or
        // server-state restore. Comparing against this rather than against
        // the DOM's pre-click state, since by the time a debounced save fires
        // the click has already updated the DOM either way.
        let lastTargetedKinds = targetedKinds();

        // A group's last remaining kind cannot be excluded. The server
        // validation is the authority; this only stops the UI offering it.
        const lockLastInGroup = () => {
          mix.querySelectorAll(".mix-group-rotating").forEach((group) => {
            const boxes = Array.from(group.querySelectorAll(".mix-exclude-box"));
            const remaining = boxes.filter((box) => !box.checked);
            const locked = remaining.length === 1;

            remaining.forEach((box) => { box.disabled = locked; });
            group.querySelector(".mix-last-note").hidden = !locked;
          });
        };

        // The version this tab last saw. Posted with every mix save so a tab
        // whose controls predate another tab's save is refused rather than
        // overwriting it, and updated from whatever the server reports back.
        let version = <%= raw current_user.section_kind_preferences_version.to_json %>;

        // Puts the server's state on screen after a refusal, so the engineer
        // sees what is actually stored instead of re-applying a change against
        // a version that can never match again.
        const applyServerState = (current) => {
          const weights = current.section_kind_weights || {};
          const excluded = current.excluded_section_kinds || [];

          rows.forEach((row) => {
            const kind = row.dataset.kind;
            const slider = row.querySelector("input[type=range]");
            const box = row.querySelector(".mix-exclude-box");
            const stop = Object.prototype.hasOwnProperty.call(weights, kind) ? weights[kind] : DEFAULT_STOP;
            const index = STOPS.indexOf(stop);

            slider.value = index === -1 ? STOPS.indexOf(DEFAULT_STOP) : index;
            row.querySelector("output").textContent = LABELS[Number(slider.value)];
            box.checked = excluded.indexOf(kind) !== -1;
            slider.disabled = box.checked;
          });

          const levels = current.section_kind_levels || {};
          const lockedKinds = current.locked_section_kinds || [];
          difficulties.forEach((box) => {
            const kind = box.dataset.kind;
            const level = Object.prototype.hasOwnProperty.call(levels, kind) ? levels[kind] : "";
            box.querySelectorAll("input[type=radio]").forEach((radio) => { radio.checked = radio.value === level; });
            box.querySelector(".mix-lock-box").checked = lockedKinds.indexOf(kind) !== -1;
            setDifficultyDisabled(box, excluded.indexOf(kind) !== -1);
          });

          lockLastInGroup();
          version = current.section_kind_preferences_version;
          lastTargetedKinds = targetedKinds();
        };

        let pending;
        // This tab's own saves are chained rather than issued in parallel. The
        // debounce only spaces them by 400ms, so a request slower than that is
        // still in flight when the next one is sent — and that next one would
        // post the version the first is about to move, and be refused as a
        // conflict with itself, snapping the user's latest change back.
        let inFlight = Promise.resolve();
        const saveMix = () => {
          clearTimeout(pending);
          pending = setTimeout(() => {
            inFlight = inFlight.then(() => {
              const payload = Object.assign(state(), { section_kind_preferences_version: version });

              return save(payload, "exercise_mix").then((result) => {
                if (!result) return;

                // Taken from the server rather than incremented here: a save
                // whose payload already matches what is stored changes nothing,
                // so the counter does not move, and a local increment would
                // desync this tab into refusing its own next save.
                const reported = result.data && result.data.section_kind_preferences_version;
                if (result.ok && typeof reported === "number") version = reported;

                if (result.status === 409 && result.data && result.data.current) applyServerState(result.data.current);

                // The bulk "Add difficulty notes" control's count is computed
                // server side, deduplicated across kinds — math the client
                // can't redo on its own. Reloading only when a save actually
                // changes which kinds carry a target (against the last set the
                // server confirmed, not the DOM's pre-click state, which the
                // click has already updated by the time this runs) keeps an
                // ordinary level change (senior -> principal) from yanking the
                // page out from under the engineer mid-interaction.
                if (result.ok) {
                  const current = targetedKinds();
                  const changed = current !== lastTargetedKinds;
                  lastTargetedKinds = current;
                  if (changed) window.location.reload();
                }
              });
            });
          }, 400);
        };

        rows.forEach((row) => {
          const slider = row.querySelector("input[type=range]");
          const box = row.querySelector(".mix-exclude-box");
          const label = row.querySelector("output");

          slider.addEventListener("input", () => {
            label.textContent = LABELS[Number(slider.value)];
            saveMix();
          });

          box.addEventListener("change", () => {
            slider.disabled = box.checked;
            lockLastInGroup();
            setDifficultyDisabled(difficultyFor(row.dataset.kind), box.checked);
            saveMix();
          });
        });

        difficulties.forEach((box) => {
          box.querySelectorAll("input[type=radio]").forEach((radio) => {
            radio.addEventListener("change", () => { syncDifficulty(box); saveMix(); });
          });
          box.querySelector(".mix-lock-box").addEventListener("change", saveMix);
        });

        lockLastInGroup();
      }
    })();
  </script>
</div>
