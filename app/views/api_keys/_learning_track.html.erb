<div class="form-field mix-note" id="learning-track" data-controller="learning-track"
     data-learning-track-url-value="<%= profile_path %>"
     data-learning-track-left-text-value="<%= t("learning_track.setup.left") %>">
  <p class="hint"><%= t("learning_track.setup.on_track") %></p>
  <button type="button" class="btn btn-ghost btn-sm" id="leave-learning-track"
          data-learning-track-target="leaveButton" data-action="click->learning-track#leave"><%= t("learning_track.setup.leave") %></button>
  <p class="hint"><%= t("learning_track.setup.leave_hint") %></p>
</div>
