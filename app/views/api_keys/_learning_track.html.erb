<div class="form-field mix-note" id="learning-track" data-profile-url="<%= profile_path %>"
     data-left-text="<%= t("learning_track.setup.left") %>">
  <p class="hint"><%= t("learning_track.setup.on_track") %></p>
  <label for="track-suggestions">
    <input type="checkbox" id="track-suggestions" <%= "checked" if current_user.track_suggestions? %>
           aria-describedby="track-suggestions-hint">
    <%= t("learning_track.setup.suggestions_label") %>
  </label>
  <p class="hint" id="track-suggestions-hint"><%= t("learning_track.setup.suggestions_hint") %></p>
  <button type="button" class="btn btn-ghost btn-sm" id="leave-learning-track"><%= t("learning_track.setup.leave") %></button>
  <p class="hint"><%= t("learning_track.setup.leave_hint") %></p>
</div>
<script>
  (function () {
    const box = document.getElementById("learning-track");
    const button = document.getElementById("leave-learning-track");
    const suggestions = document.getElementById("track-suggestions");
    let suggestionSaves = Promise.resolve();
    let queuedSuggestionSaves = 0;
    document.addEventListener("DOMContentLoaded", () => window.CodeGymSaveStatus.watch(() => queuedSuggestionSaves > 0));
    suggestions.addEventListener("change", () => {
      const wanted = suggestions.checked;
      queuedSuggestionSaves++;
      suggestionSaves = suggestionSaves.then(async () => {
        const result = await window.CodeGymSaveStatus.save("PATCH", box.dataset.profileUrl,
          { user: { track_suggestions: wanted } }, "track_suggestions");
        queuedSuggestionSaves--;
        if ((!result || !result.ok) && queuedSuggestionSaves === 0) suggestions.checked = !wanted;
      });
    });
    button.addEventListener("click", async () => {
      button.disabled = true;
      const result = await window.CodeGymSaveStatus.save("PATCH", box.dataset.profileUrl,
        { user: { learning_track: "none" } }, "learning_track");
      // Settles in place: a reload could cancel the Exercise mix's delayed save or hide its failure.
      if (result && result.ok) {
        // The key guide renders only for a track user.
        document.querySelector(".key-guide")?.remove();
        const line = document.createElement("p");
        line.className = "hint";
        line.setAttribute("role", "status");
        line.tabIndex = -1;
        line.textContent = box.dataset.leftText;
        box.replaceChildren(line);
        // The button that had focus is gone, so the confirmation takes it.
        line.focus();
      } else {
        button.disabled = false;
      }
    });
  })();
</script>
