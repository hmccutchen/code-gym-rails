require "json"

HARNESS  = "%HARNESS%"
CHECK    = "%CHECK%"
SPEC     = %SPEC%
NOT_CORE = [ NameError, LoadError ].freeze

def finish(outcome, reason, error = nil)
  line = { "harness" => HARNESS, "outcome" => outcome, "reason" => reason }
  line["error"] = error if error
  $stdout.puts("BUGHUNT_RESULT #{JSON.generate(line)}")
  $stdout.flush
  exit!(0)
end

finish("not_runnable", "key_unparsable") if SPEC.nil?

if SPEC["raises"].nil?
  begin
    wanted = eval(File.read("#{HARNESS}.expected.rb"), TOPLEVEL_BINDING, "expected.rb")
  rescue SyntaxError, StandardError
    finish("not_runnable", "key_unparsable")
  end
end

raised = nil
begin
  actual = eval(File.read("#{HARNESS}.subject.rb"), TOPLEVEL_BINDING, "subject.rb")
rescue SyntaxError
  finish("not_runnable", "syntax")
rescue LoadError, StandardError, SystemStackError => e
  finish("not_runnable", "not_core", e.class.name) if NOT_CORE.include?(e.class)
  raised = e
end

matched =
  begin
    SPEC["raises"] ? raised&.class&.name == SPEC["raises"] : raised.nil? && actual == wanted
  rescue StandardError
    false
  end
pass = CHECK == "bug_real" ? !matched : matched
finish(pass ? "pass" : "fail", matched ? "matched" : "mismatched", raised&.class&.name)
